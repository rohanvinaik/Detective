diff --git a/tests/test_detection_in_removal_intent.py b/tests/test_detection_in_removal_intent.py
new file mode 100644
index 0000000..fe72e90
--- /dev/null
+++ b/tests/test_detection_in_removal_intent.py
@@ -0,0 +1,145 @@
+"""A removal plan consumes DETECTION, and a page names a detector that stays (#143's fixture).
+
+THE DEFECT, found by the integrator on #143's c1 writer (`tests/test_write_refused_detected_intent.py`):
+`audit` listed `test_atomic_write_text_writes` as redundant "for BOTH kills and lines" and `--remove` would
+delete it, while the same page's refused floor ("modulo 5 refused crash-detected survivor(s)") and its
+`write_refused_survivors` named THAT test as the one that detects them. The certificate would then lean on a
+test that no longer exists. Two causes, one derivation each:
+
+* the detector a survivor is NAMED by was read from Wesker's first-killer matrix (execution order), while
+  the redundant set is decided over the FULL relation, so the two disagreed about which test detects it;
+* nothing held a removal back when the test it proposes to delete is the last detector of a survivor the
+  certificate leans on (the refused floor, a crash-only survivor).
+
+The rule now: `redundant -= sole_detector_tests(...)` keeps a detector for every survivor the certificate
+leans on, and the page names the smallest-id detector that STAYS (`detection_view`). A control where a second
+test also detects them leaves one of the two removable, and the named detector is the one that stays.
+"""
+
+from __future__ import annotations
+
+import json
+import os
+import subprocess
+import sys
+
+import pytest
+
+from Detective.audit import detection_view, detector_standing, sole_detector_tests
+
+# #143's c1 fixture (copied from test_write_refused_detected_intent.py: tests are not a package)
+_WRITER = (
+    "import os\n\n\n"
+    "def atomic_write_text(path, text):\n"
+    "    tmp = f'{path}.tmp-{os.getpid()}'\n"
+    "    with open(tmp, 'w') as fh:\n"
+    "        fh.write(text)\n"
+    "    os.replace(tmp, path)\n"
+)
+_WRITER_TEST = (
+    "import os\n\n"
+    "from m import atomic_write_text\n\n\n"
+    "def test_atomic_write_text_writes(tmp_path):\n"
+    "    target = tmp_path / 'a.txt'\n"
+    "    atomic_write_text(str(target), 'hello')\n"
+    "    assert target.read_text() == 'hello'\n"
+)
+_STAGING_TEST = (
+    "\n\ndef test_atomic_write_text_consumes_its_own_staging_file(tmp_path):\n"
+    "    target = tmp_path / 's.txt'\n"
+    "    staging = tmp_path / f's.txt.tmp-{os.getpid()}'\n"
+    "    staging.write_text('stale')\n"
+    "    atomic_write_text(str(target), 'fresh')\n"
+    "    assert target.read_text() == 'fresh'\n"
+    "    assert not staging.exists()\n"
+)
+
+# ------------------------------------------------------------------ the pure decision
+
+
+@pytest.mark.parametrize(
+    ("detectors", "removed", "standing"),
+    [
+        ([], [], "none"),
+        ([], ["t::a"], "none"),
+        (["t::a"], [], "kept"),
+        (["t::a", "t::b"], ["t::a"], "kept"),
+        (["t::a"], ["t::a"], "sole_removed"),
+        (["t::a", "t::b"], ["t::b", "t::a"], "sole_removed"),
+        (["t::a"], ["t::other"], "kept"),
+    ],
+)
+def test_a_survivor_stays_detected_only_while_a_detector_stays(detectors, removed, standing):
+    assert detector_standing(detectors, removed) == standing
+
+
+def test_the_removals_to_withdraw_keep_the_smallest_detector_of_each_survivor_left_bare():
+    detected = {"M1: a": ["t::b", "t::a"], "M2: b": ["t::c"], "M3: c": ["t::a", "t::z"]}
+    # M1 loses both detectors, M2 loses its only one, M3 keeps t::z
+    assert sole_detector_tests(detected, ["t::a", "t::b", "t::c"]) == ["t::a", "t::c"]
+    assert sole_detector_tests(detected, []) == []
+    assert sole_detector_tests({}, ["t::a"]) == []
+
+
+def test_the_detection_view_sets_removals_aside_unless_that_would_leave_none():
+    relation = {"M1: a": ["t::a", "t::b"], "M2: b": ["t::a"]}
+    assert detection_view(relation, ["t::a"]) == {"M1: a": ["t::b"], "M2: b": ["t::a"]}
+    assert detection_view(relation, []) == relation
+
+
+# ------------------------------------------------------------------ end to end, on #143's fixture
+
+
+def _detective(cwd, *argv):
+    env = {k: v for k, v in os.environ.items() if k != "PYTHONUNBUFFERED"}
+    return subprocess.run(
+        [sys.executable, "-m", "Detective", *argv],
+        cwd=cwd,
+        capture_output=True,
+        text=True,
+        timeout=600,
+        check=False,
+        env=env,
+    )
+
+
+def _audit(tmp_path, tests_source):
+    project = tmp_path / "proj"
+    (project / "tests").mkdir(parents=True)
+    (project / "m.py").write_text(_WRITER)
+    (project / "tests" / "test_m.py").write_text(tests_source)
+    assert _detective(project, "regime", "--migrate", "--project-root", str(project)).returncode == 0
+    run = _detective(project, "audit", "m.py::atomic_write_text", "--json")
+    return json.loads(run.stdout)
+
+
+def test_the_page_names_a_detector_that_stays_when_a_second_test_also_detects_them(tmp_path):
+    """The control: both tests crash the five refused mutants. One of the two is removable, and the survivor
+    rows name the OTHER one: the test the plan deletes is never the one the certificate cites."""
+    audit = _audit(tmp_path, _WRITER_TEST + _STAGING_TEST)
+    removed = [t.rsplit("::", 1)[1] for t in audit["redundant_tests"]]
+    assert removed == ["test_atomic_write_text_writes"], removed
+    detected = [s for s in audit["write_refused_survivors"] if s[2] == "crash_detected"]
+    assert len(detected) == 5
+    named = {s[3].rsplit("::", 1)[1] for s in detected}
+    assert named == {"test_atomic_write_text_consumes_its_own_staging_file"}, named
+
+
+_SWALLOWED_STAGING_TEST = (
+    "\n\ndef test_atomic_write_text_swallows(tmp_path):\n"
+    "    target = tmp_path / 's.txt'\n"
+    "    try:\n"
+    "        atomic_write_text(str(target), 'fresh')\n"
+    "    except Exception:\n"
+    "        pass\n"
+)
+
+
+def test_a_test_that_is_the_only_detector_of_the_refused_floor_is_not_proposed_for_removal(tmp_path):
+    """The second test swallows every exception and asserts nothing, so it detects nothing: the first test
+    is the sole detector of the five and must stay, and it is the one the page names."""
+    audit = _audit(tmp_path, _WRITER_TEST + _SWALLOWED_STAGING_TEST)
+    removed = [t.rsplit("::", 1)[1] for t in audit["redundant_tests"]]
+    assert "test_atomic_write_text_writes" not in removed, removed
+    detected = [s for s in audit["write_refused_survivors"] if s[2] == "crash_detected"]
+    assert detected and {s[3].rsplit("::", 1)[1] for s in detected} == {"test_atomic_write_text_writes"}
