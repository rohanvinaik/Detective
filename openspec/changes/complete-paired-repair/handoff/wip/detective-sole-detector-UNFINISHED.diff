+def detector_standing(detectors: list[str], removed: list[str]) -> str:
+    """Whether a survivor the certificate leans on stays detected once the proposed removals are made
+    (pure — pinned).
+
+    A refused crash-detected survivor (the named floor, #143) or a crash-only one is detected by the tests
+    of the full relation that crash on it. A removal proposal is made over kills and lines, and a test it
+    deletes may be the very test the page names as the detector, so the page and the plan must read the
+    same relation:
+
+      "none"          no test detects it at all (an open survivor): nothing to keep, nothing to name
+      "kept"          at least one detector is not proposed for removal: the survivor stays detected
+      "sole_removed"  every detector is proposed for removal: removing them leaves the survivor undetected,
+                      so the certificate that names it as a floor would lean on a test that no longer
+                      exists. The proposal must keep a detector.
+    """
+    if not detectors:
+        return "none"
+    return "kept" if any(test not in removed for test in detectors) else "sole_removed"
+
+
+def sole_detector_tests(detected: dict[str, list[str]], removed: list[str]) -> list[str]:
+    """The proposed removals to withdraw so every detected survivor keeps a detector (pure — pinned).
+
+    ``detected`` maps each survivor the certificate leans on to the tests that detect it. For each survivor
+    `detector_standing` calls ``sole_removed``, the lexicographically smallest of its detectors is kept
+    (withdrawn from ``removed``), so the choice does not follow execution order. Sorted, without repeats."""
+    keep: set[str] = set()
+    for tests in detected.values():
+        standing = detector_standing(tests, removed)
+        if standing == "sole_removed":
+            keep.add(sorted(tests)[0])
+        elif standing == "kept":
+            continue  # a detector stays: the removal does not touch what the certificate leans on
+        elif standing == "none":
+            continue  # nothing detects it: there is no detector to keep
+    return sorted(keep)
+
+
+def detection_view(relation: dict[str, list[str]], removed: list[str]) -> dict[str, list[str]]:
+    """The relation a survivor's detector is NAMED from, with the removal proposals set aside (pure —
+    pinned): each description maps to its detectors that stay, or to all of them where none would."""
+    view: dict[str, list[str]] = {}
+    for description, tests in relation.items():
+        staying = [test for test in tests if test not in removed]
+        view[description] = staying if staying else list(tests)
+    return view
+
+
+def _key_of(mutant_id: str, matrix: dict[str, list[str]]) -> str:
+    """The relation's key for a mutant id: keys read ``"<id>: <description>"``; "" when it has none."""
+    return next((key for key in matrix if key.startswith(f"{mutant_id}:")), "")
+
+
+def detected_relation_keys(
+    records: list[list[str]],
+    named: tuple[tuple[str, str, str, str, str], ...],
+    crash_only_ids: list[str],
+    matrix: dict[str, list[str]],
+) -> list[str]:
+    """The relation keys of the survivors the certificate leans on: the refused ones the suite detects
+    by crash (named by the record's own key) and the crash-only ones it detects."""
+    detected_ids = {survivor[0] for survivor in named if survivor[2] == "crash_detected"}
+    keys = [record[1] for record in records if record[0] in detected_ids and record[1] in matrix]
+    keys += [key for key in (_key_of(i, matrix) for i in crash_only_ids) if key]
+    return list(dict.fromkeys(keys))
+
+
+def _first_detector(mutant_id: str, view: dict[str, list[str]]) -> str:
+    """A test that detects ``mutant_id`` and stays (the smallest id), "" when the relation has none."""
+    tests = view.get(_key_of(mutant_id, view), [])
+    return sorted(tests)[0] if tests else ""
+
+
