+def test_the_run_ledger_joins_each_mutant_to_its_site_and_sums_to_total_killed(
+    tmp_path, monkeypatch
+):
+    (tmp_path / "scmod.py").write_text(
+        "def parse_guard(text):\n    try:\n        return int(text)\n    except Exception:\n        return None\n"
+    )
+    (tmp_path / "sctests.py").write_text(
+        "from scmod import parse_guard\n\n\n"
+        "def test_a_number():\n    assert parse_guard('12') == 12\n\n\n"
+        "def test_syntax_like():\n    assert parse_guard('x') is None\n\n\n"
+        "def test_the_other_error():\n    assert parse_guard(None) is None\n"
+    )
+    monkeypatch.syspath_prepend(str(tmp_path))
+    for name in ("scmod", "sctests"):
+        sys.modules.pop(name, None)
+    mod = importlib.import_module("scmod")
+    tests_mod = importlib.import_module("sctests")
+    tests = []
+    for attr in sorted(a for a in vars(tests_mod) if a.startswith("test_")):
+        fn = getattr(tests_mod, attr)
+        fn.__qualname__ = f"sctests.py::{attr}"
+        tests.append(fn)
+    node = _fn((tmp_path / "scmod.py").read_text())
+    with observe_caught_exceptions(node, mod.parse_guard.__code__) as caught:
+        for t in tests:
+            t()
+    try:
+        res = run_function_profiling(
+            node,
+            "scmod.py::parse_guard",
+            set(MutationCategory) - {MutationCategory.OUTPUT},
+            tests,
+            mod.parse_guard,
+            scope_tests=False,
+            max_per_category=0,
+            observed_caught=caught,
+        )
+    finally:
+        for name in ("scmod", "sctests"):
+            sys.modules.pop(name, None)
+    payload = res.to_dict()
+    ledger = payload["kill_ledger"]
+    assert ledger["kills"] == payload["total_killed"]
+    assert ledger["contract"] + ledger["detection"] + ledger["reach"] == ledger["kills"]
+    assert (
+        ledger["detection"] >= 2
+    )  # the narrowings: a test's error escapes, nothing asserted
+    assert ledger["contract"] >= 1
+    site_ids = {s["id"] for s in payload["site_census"]["sites"]}
+    rows = payload["mutant_ledger"]
+    assert len(rows) == payload["total_mutants"]
+    for row in rows:
+        assert row["site"] in site_ids, row
+        assert row["reach_tests"] is not None
+    for row in rows:
+        if row["outcome"] == "killed":
+            assert row["kill_class"] in (CLASS_CONTRACT, CLASS_DETECTION, CLASS_REACH)
+            assert row["kill_class"] == kill_class(
+                row["killed_by"], row["dimension"], list(REACH_CLASS_DIMENSIONS)
+            )
+    for record in payload["killed_records"]:
+        assert record["site"] in site_ids
+        assert record["kill_class"] in (CLASS_CONTRACT, CLASS_DETECTION, CLASS_REACH)
