+def _join_sites(
+    func_node: ast.FunctionDef | ast.AsyncFunctionDef, mutants: list[Mutant]
+) -> list[Mutant]:
+    """Resolve every mutant's fire-site key to its stable candidate-site id (#22).
+
+    One index over the original tree serves them all. A whole-function wrapper has no node and is the
+    function itself (it set ``site`` when it was built); a mutant whose key the index does not hold is left
+    unjoined (""), which the census reports as unjoined and never as a site.
+    """
