             "filter_categories(is_pure=True) suppresses the remove_assign "
diff --git a/Wesker/site_census.py b/Wesker/site_census.py
new file mode 100644
index 0000000..86264a9
--- /dev/null
+++ b/Wesker/site_census.py
@@ -0,0 +1,381 @@
+"""The per-site operator census (Wesker #22, #30): what the policy did at every candidate site.
+
+``filter.category_census`` says what each CATEGORY did on a target in counts. A count cannot say which site
+a withheld alternative sat at, nor show a site the operator never considered, so a reader could not audit
+the decision, only the total. This census takes every positioned node of the function and, for every
+operator whose candidate class the node belongs to, states one disposition:
+
+* ``generated``       — the operator produced at least one mutant here (``targets`` counts them);
+* ``withheld``        — the site is a candidate and policy declined it, for a named reason
+  (``annotation``, ``purity_overlay``, ``one_sign_policy``, ``unobserved_handler``, ``pair_budget``);
+* ``unsupported``     — the operator is implemented but not enrolled for this site (``name_sub_not_enrolled``);
+* ``not_applicable``  — the site is of a class the operator reads and the site has nothing for it
+  (``docstring``, ``bare_reraise``, ``identical_operands``, ``no_alternative_at_site``…).
+
+Every other (node, operator) pair is ``not_applicable(not_a_candidate_class)`` by rule, stated once in the
+payload rather than as hundreds of rows. :func:`site_disposition` answers any pair, so the census is total
+over nodes x operators, and the mutants the generator produced are counted in the same pass that classifies
+the sites (one analysis: the notes each mutator records in record mode), so a site's ``generated`` count
+and the universe cannot disagree.
+
+Annotation sites (Wesker #30, option A) are candidates the runtime universe excludes by ruling, and they are
+SHOWN: a ``withheld(annotation)`` row per operator whose class matches, instead of the silent exclusion the
+category counts alone produce.
+"""
+
+from __future__ import annotations
+
+import ast
+from typing import Any
+
+from .caught_exceptions import (
+    CaughtObservation,
+    narrowing_standing,
+)
+from .engine import (
+    _SITE_SINK,
+    MutationCategory,
+    _count_targets,
+    _dataflow_candidates,
+    _deletable_stmt_ids,
+    _docstring_positions,
+    _scope_bindings,
+    _stmt_call_ids,
+    _swap_plan_of,
+    _SwapMutator,
+    _walk_behavioral,
+)
+from .site_ids import SiteIndex, SiteKey, site_key_of
+from .swap_plan import PAIR_IDENTICAL  # noqa: F401  (named in the payload's reasons)
+
+D_GENERATED = "generated"
+D_WITHHELD = "withheld"
+D_UNSUPPORTED = "unsupported"
+D_NOT_APPLICABLE = "not_applicable"
+
+R_ANNOTATION = "annotation"
+R_NOT_CANDIDATE = "not_a_candidate_class"
+R_NO_ALTERNATIVE = "no_alternative_at_site"
+
+# The node classes each operator reads, by category: the CANDIDATE classes. A node of one of them is a site
+# the operator is answerable for; a node of any other class is not_applicable(not_a_candidate_class). This
+# is the only class-level table: whether a candidate generated anything comes from the mutators' own
+# record-mode notes, and `tests/test_site_census_intent.py` checks that no note ever lands on a node
+# outside its category's classes.
+CANDIDATE_CLASSES: dict[str, tuple[str, ...]] = {
+    "VALUE": ("Constant",),
+    "BOUNDARY": ("Compare",),
+    "ARITHMETIC": ("BinOp", "AugAssign", "UnaryOp"),
+    "LOGICAL": ("BoolOp", "UnaryOp"),
+    "SWAP": ("Call",),
+    "TYPE": ("Call",),
+    "STATE": ("Assign", "AnnAssign", "AugAssign", "Return", "Break", "Continue"),
+    "EXCEPTION": ("Raise", "ExceptHandler"),
+    "DATAFLOW": ("Name",),
+    "OUTPUT": ("Return", "Yield", "YieldFrom"),
+}
+_STMT_CLASSES = tuple(c.__name__ for c in ast.stmt.__subclasses__())
+
+
+def is_candidate_class(category: str, node_class: str, is_root: bool) -> bool:
+    """Whether a node class is one the operator reads (pure — pinned)."""
+    if category == "STMT":
+        return node_class in _STMT_CLASSES and not is_root
+    return node_class in CANDIDATE_CLASSES.get(category, ())
+
+
+def site_disposition(
+    candidate: bool,
+    annotation: bool,
+    targets: int,
+    hold: str,
+    absent_reason: str,
+) -> str:
+    """The standing of one (site, operator) pair as ``<disposition>:<reason>`` (#22, pure — pinned).
+
+    Precedence is the order of the questions a reader asks: is the site this operator's to answer at all
+    (``not_applicable:not_a_candidate_class``); is it in the annotation subtree the ruling excludes
+    (``withheld:annotation``, whatever else is true, because the exclusion comes first and the operator
+    never saw it); did the operator produce mutants and a policy hold (``hold``, e.g. ``purity_overlay``)
+    suppress them (``withheld:<hold>``); did it produce any (``generated:``); and otherwise the reason
+    the site gave nothing, which arrives already spelled ``<disposition>:<reason>``.
+
+    The two states that read alike must not share a code: ``withheld`` is a judgement a reader may
+    disagree with, ``not_applicable`` is a structural fact. ``generated`` carries an empty reason.
+    """
+    if not candidate:
+        return f"{D_NOT_APPLICABLE}:{R_NOT_CANDIDATE}"
+    if annotation:
+        return f"{D_WITHHELD}:{R_ANNOTATION}"
+    if targets > 0 and hold:
+        return f"{D_WITHHELD}:{hold}"
+    if targets > 0:
+        return f"{D_GENERATED}:"
+    if absent_reason:
+        return absent_reason
+    return f"{D_NOT_APPLICABLE}:{R_NO_ALTERNATIVE}"
+
+
+def _absent_reason(
+    category: str,
+    node: ast.AST,
+    docstrings: set[tuple[int, int]],
+    name_sub_sites: set[SiteKey],
+) -> str:
+    """Why an unannotated candidate gave no mutants, spelled ``<disposition>:<reason>`` ("" if no more
+    specific reason is known). Specific only where the operator's own skip rule is a named one."""
+    if category == "VALUE" and isinstance(node, ast.Constant):
+        if (node.lineno, node.col_offset) in docstrings:
+            return f"{D_NOT_APPLICABLE}:docstring"
+        if node.value is None or isinstance(node.value, (bytes, complex, type(...))):
+            return f"{D_NOT_APPLICABLE}:constant_type_without_alternative"
+    if category == "DATAFLOW" and isinstance(node, ast.Name):
+        if not isinstance(node.ctx, ast.Load):
+            return f"{D_NOT_APPLICABLE}:not_a_load"
+        key = site_key_of(node)
+        if key is not None and key in name_sub_sites:
+            return f"{D_UNSUPPORTED}:name_sub_not_enrolled"
+        return f"{D_NOT_APPLICABLE}:no_compatible_candidate"
+    if (
+        category == "TYPE"
+        and isinstance(node, ast.Call)
+        and not (isinstance(node.func, ast.Name) and node.func.id == "isinstance")
+    ):
+        return f"{D_NOT_APPLICABLE}:not_isinstance"
+    if category == "EXCEPTION" and isinstance(node, ast.Raise) and node.exc is None:
+        return f"{D_NOT_APPLICABLE}:bare_reraise"
+    if (
+        category == "STATE"
+        and isinstance(node, ast.Return)
+        and (
+            node.value is None
+            or (isinstance(node.value, ast.Constant) and node.value.value is None)
+        )
+    ):
+        return f"{D_NOT_APPLICABLE}:already_return_none"
+    if category in ("ARITHMETIC", "LOGICAL") and isinstance(node, ast.UnaryOp):
+        is_not = isinstance(node.op, ast.Not)
+        if (category == "LOGICAL") != is_not:
+            return f"{D_NOT_APPLICABLE}:operator_belongs_to_the_other_family"
+    if category == "STMT":
+        return f"{D_NOT_APPLICABLE}:binds_a_new_name_or_not_deletable"
+    return ""
+
+
+def annotation_site_counts(
+    func_node: ast.FunctionDef | ast.AsyncFunctionDef,
+) -> dict[str, int]:
+    """How many candidate sites per operator sit in the function's annotation subtrees (#30).
+
+    The category census (:func:`Wesker.filter.category_census`) reads this so a category's row says
+    ``withheld(annotation)`` instead of leaving the excluded sites out of every count. The nodes are the
+    ones :func:`_walk_behavioral` does not visit, the same walk generation and counting share, so the
+    exclusion and its count cannot drift.
+    """
+    behavioral = {id(n) for n in _walk_behavioral(func_node)}
+    counts = {c.value: 0 for c in MutationCategory}
+    for node in ast.walk(func_node):
+        if id(node) in behavioral or site_key_of(node) is None:
+            continue
+        for category in MutationCategory:
+            if is_candidate_class(category.value, type(node).__name__, False):
+                counts[category.value] += 1
+    return counts
+
+
+def _record(
+    func_node: ast.FunctionDef | ast.AsyncFunctionDef,
+    category: MutationCategory,
+    observed: frozenset[str] | None,
+    caught: CaughtObservation | None,
+) -> tuple[list[tuple[str, SiteKey | None]], int]:
+    """The notes the category's mutators record over the function, with the site each was noted at,
+    and the category's own target count (the reconciliation figure)."""
+    notes: list[tuple[str, SiteKey | None]] = []
+    token = _SITE_SINK.set(notes)
+    try:
+        count = _count_targets(func_node, category, observed, caught)
+    finally:
+        _SITE_SINK.reset(token)
+    return notes, count
+
+
+def site_census(
+    func_node: ast.FunctionDef | ast.AsyncFunctionDef,
+    *,
+    is_pure: bool = False,
+    two_sign: bool = False,
+    observed: frozenset[str] | None = None,
+    caught: CaughtObservation | None = None,
+) -> dict[str, Any]:
+    """The per-site census of one function, JSON-ready (impure only in running the mutators' recorders).
+
+    ``is_pure``, ``two_sign``, ``observed`` and ``caught`` are the run's own, so the census is about the
+    universe that run generated: a census computed under other settings would be a different claim.
+    """
+    index = SiteIndex(func_node)
+    root_key = site_key_of(func_node)
+    behavioral = {id(n) for n in _walk_behavioral(func_node)}
+    annotation_keys: set[SiteKey] = set()
+    for node in ast.walk(func_node):
+        key = site_key_of(node)
+        if key is not None and id(node) not in behavioral:
+            annotation_keys.add(key)
+    docstrings = _docstring_positions(func_node)
+    name_sub_sites: set[SiteKey] = set()
+    for node_id, (mode, _orig, _cands) in _dataflow_candidates(func_node).items():
+        if mode == "name_sub":
+            node = next((n for n in ast.walk(func_node) if id(n) == node_id), None)
+            key = site_key_of(node)
+            if key is not None:
+                name_sub_sites.add(key)
+
+    # category value -> site key -> [targets, held targets, {reason: withheld count}]
+    per_category: dict[str, dict[SiteKey, dict[str, Any]]] = {}
+    reconcile: dict[str, dict[str, int]] = {}
+    for category in MutationCategory:
+        cat = category.value
+        sites: dict[SiteKey, dict[str, Any]] = {}
+        if category is MutationCategory.STMT:
+            deletable = _deletable_stmt_ids(func_node)
+            notes = [
+                ("STMT", site_key_of(node))
+                for node in ast.walk(func_node)
+                if isinstance(node, ast.stmt)
+                and (node.lineno, node.col_offset) in deletable
+            ]
+            count = len(notes)
+        elif category is MutationCategory.SWAP:
+            # Counted the way `_count_targets` counts it: the alternatives of every call.
+            stmt_ids = _stmt_call_ids(func_node)
+            bindings = _scope_bindings(func_node)
+            notes = []
+            for node in _walk_behavioral(func_node):
+                if isinstance(node, ast.Call):
+                    for _spec, label in _SwapMutator._alternatives(
+                        node, stmt_ids, bindings
+                    ):
+                        notes.append((label, site_key_of(node)))
+            count = len(notes)
+        else:
+            notes, count = _record(func_node, category, observed, caught)
+        for dim, key in notes:
+            if key is None:
+                continue
+            row = sites.setdefault(key, {"targets": 0, "held": 0, "withheld": {}})
+            row["targets"] += 1
+            if (
+                category is MutationCategory.STATE
+                and is_pure
+                and dim.startswith("STATE:remove_assign")
+            ) or (category is MutationCategory.OUTPUT and not two_sign):
+                row["held"] += 1
+        per_category[cat] = sites
+        reconcile[cat] = {
+            "site_targets": sum(r["targets"] for r in sites.values()),
+            "category_targets": count,
+            # Targets that belong to the function as a whole (a μ⁻ Form B wrapper), not to a node.
+            "function_level": count - sum(r["targets"] for r in sites.values()),
+        }
+
+    # Per-site withheld sub-questions that are not whole-site holds.
+    for node in ast.walk(func_node):
+        key = site_key_of(node)
+        if key is None or id(node) not in behavioral:
+            continue
+        if isinstance(node, ast.Call):
+            _asked, over_budget, identical = _swap_plan_of(node)
+            row = per_category["SWAP"].setdefault(
+                key, {"targets": 0, "held": 0, "withheld": {}}
+            )
+            if over_budget:
+                row["withheld"]["pair_budget"] = over_budget
+            if identical:
+                row["not_applicable"] = {"identical_operands": len(identical)}
+        if isinstance(node, ast.ExceptHandler) and node.type is not None:
+            names = (
+                [getattr(e, "id", getattr(e, "attr", "")) for e in node.type.elts]
+                if isinstance(node.type, ast.Tuple)
+                else [getattr(node.type, "id", getattr(node.type, "attr", ""))]
+            )
+            names = [n for n in names if n]
+            observed_here = (caught or {}).get(node.lineno, {})
+            standing = narrowing_standing(
+                names,
+                caught is not None,
+                sum(
+                    1
+                    for mro in observed_here.values()
+                    if mro and any(n in mro[1:] for n in names) and mro[0] not in names
+                ),
+                isinstance(node.type, ast.Tuple),
+                False,
+            )
+            if standing == "unobserved":
+                row = per_category["EXCEPTION"].setdefault(
+                    key, {"targets": 0, "held": 0, "withheld": {}}
+                )
+                row["withheld"]["unobserved_handler"] = 1
+
+    census_sites: list[dict[str, Any]] = []
+    by_operator: dict[str, dict[str, dict[str, int]]] = {
+        c.value: {} for c in MutationCategory
+    }
+    for key in index.site_keys():
+        kind = key[0]
+        node = index.node(key)
+        operators: dict[str, dict[str, Any]] = {}
+        for category in MutationCategory:
+            cat = category.value
+            if not is_candidate_class(cat, kind, key == root_key):
+                continue
+            row = per_category[cat].get(key, {"targets": 0, "held": 0, "withheld": {}})
+            hold = ""
+            if row["held"]:
+                hold = (
+                    "purity_overlay"
+                    if category is MutationCategory.STATE
+                    else "one_sign_policy"
+                )
+            annotation = key in annotation_keys
+            absent = (
+                _absent_reason(cat, node, docstrings, name_sub_sites)
+                if node is not None
+                else ""
+            )
+            code = site_disposition(True, annotation, row["targets"], hold, absent)
+            disposition, _, reason = code.partition(":")
+            entry: dict[str, Any] = {"disposition": disposition}
+            if reason:
+                entry["reason"] = reason
+            if row["targets"]:
+                entry["targets"] = row["targets"]
+            if row["withheld"] and not annotation:
+                entry["withheld"] = dict(row["withheld"])
+            if row.get("not_applicable") and not annotation:
+                entry["not_applicable"] = dict(row["not_applicable"])
+            operators[cat] = entry
+            bucket = by_operator[cat].setdefault(disposition, {})
+            label = reason or "-"
+            bucket[label] = bucket.get(label, 0) + 1
+        if operators:
+            census_sites.append(
+                {
+                    "id": index.site_id(key),
+                    "node": kind,
+                    "role": index.role(key),
+                    "line": key[1],
+                    "annotation": key in annotation_keys,
+                    "operators": operators,
+                }
+            )
+    return {
+        "rule": (
+            "every (node, operator) pair not listed under a site is "
+            f"{D_NOT_APPLICABLE}({R_NOT_CANDIDATE}); annotation subtrees are "
+            f"{D_WITHHELD}({R_ANNOTATION}) per Wesker #30, option A"
+        ),
+        "sites": census_sites,
+        "by_operator": by_operator,
+        "reconciliation": reconcile,
+    }
diff --git a/Wesker/site_ids.py b/Wesker/site_ids.py
new file mode 100644
index 0000000..8cfa160
--- /dev/null
+++ b/Wesker/site_ids.py
@@ -0,0 +1,107 @@
+"""Stable candidate-site ids (Wesker #22): where a mutant came from, in a form a reader can audit.
+
+A mutant says WHAT changed; the census has to say WHICH candidate site it came from, and every
+site that produced nothing, so "the operator considered this site and declined it" is a fact that can be
+read and not an absence that has to be inferred. An id is three things joined, as the issue asks:
+
+* the source LOCATION: ``lineno:col_offset:end_lineno:end_col_offset``, the same coordinates the mutant's
+  ``mutated_line`` reports and the reader's editor shows;
+* the AST ROLE: the node's class and where its parent holds it (``Return.value``, ``Call.args``), which
+  tells two nodes that share a span apart (``-x`` and the ``x`` inside it);
+* the source DIGEST: a short hash of the node's position-free canonical form (:mod:`Wesker.canonical_ast`),
+  so the id changes when the code at the site changes and is the same under every interpreter.
+
+An id moves when a line is added above it, as the location part says it should; the digest part is what
+lets a reader tell "same site, moved" from "different code, same place".
+"""
+
+from __future__ import annotations
+
+import ast
+import hashlib
+from collections.abc import Iterator
+
+from .canonical_ast import canonical_ast
+
+# (node class name, lineno, col_offset, end_lineno, end_col_offset). The key a mutator reports at its fire
+# site, and the only handle that survives the deep copy a mutator works on.
+SiteKey = tuple[str, int, int, int, int]
+
+# The site of a mutant that rewrites the function as a whole (a μ⁻ Form B wrapper) rather than a node.
+SITE_FUNCTION = "function"
+
+
+def site_key_of(node: ast.AST | None) -> SiteKey | None:
+    """The position key of a node, or None for one that carries no position (``arguments``)."""
+    if node is None:
+        return None
+    lineno = getattr(node, "lineno", None)
+    col = getattr(node, "col_offset", None)
+    if lineno is None or col is None:
+        return None
+    return (
+        type(node).__name__,
+        lineno,
+        col,
+        getattr(node, "end_lineno", None) or lineno,
+        getattr(node, "end_col_offset", None) or col,
+    )
+
+
+class SiteIndex:
+    """Every positioned node of one function, addressable by :data:`SiteKey`.
+
+    Built from the ORIGINAL tree. Keys are unique in practice (a node and its only child can share a span,
+    but not a class); where two nodes do share a key the first in walk order is kept, which is the outer one.
+    """
+
+    def __init__(self, root: ast.AST):
+        self.root = root
+        self._nodes: dict[SiteKey, ast.AST] = {}
+        self._roles: dict[SiteKey, str] = {}
+        for parent in ast.walk(root):
+            for field, value in ast.iter_fields(parent):
+                children = (
+                    value
+                    if isinstance(value, list)
+                    else [value]
+                    if isinstance(value, ast.AST)
+                    else []
+                )
+                for child in children:
+                    if not isinstance(child, ast.AST):
+                        continue
+                    key = site_key_of(child)
+                    if key is not None and key not in self._nodes:
+                        self._nodes[key] = child
+                        self._roles[key] = f"{type(parent).__name__}.{field}"
+        root_key = site_key_of(root)
+        if root_key is not None and root_key not in self._nodes:
+            self._nodes[root_key] = root
+            self._roles[root_key] = "Module.body"
+        self._digests: dict[SiteKey, str] = {}
+
+    def site_keys(self) -> Iterator[SiteKey]:
+        return iter(self._nodes)
+
+    def node(self, key: SiteKey) -> ast.AST | None:
+        return self._nodes.get(key)
+
+    def role(self, key: SiteKey) -> str:
+        return self._roles.get(key, "")
+
+    def digest(self, key: SiteKey) -> str:
+        cached = self._digests.get(key)
+        if cached is None:
+            node = self._nodes.get(key)
+            text = canonical_ast(node, attributes=False) if node is not None else ""
+            cached = hashlib.sha1(
+                text.encode("utf-8", "surrogatepass"), usedforsecurity=False
+            ).hexdigest()[:8]
+            self._digests[key] = cached
+        return cached
+
+    def site_id(self, key: SiteKey) -> str:
+        """``Type@line:col-endline:endcol/Parent.field/<digest>`` for a site in this function."""
+        kind, lineno, col, end_lineno, end_col = key
+        return f"{kind}@{lineno}:{col}-{end_lineno}:{end_col}/{self.role(key)}/{self.digest(key)}"
