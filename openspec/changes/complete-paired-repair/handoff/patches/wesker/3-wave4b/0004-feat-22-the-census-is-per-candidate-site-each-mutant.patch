-            row = _census_row(0, estimate_universe_size(func_node, {cat}))
+            sites = estimate_universe_size(func_node, {cat})
+            row = _census_row(0, sites)
+            by["one_sign_policy"] = sites
         elif cat is MutationCategory.SWAP:
             # The per-call-site budget can leave argument-order questions UNASKED (policy 7). Those
             # are withheld by policy exactly as μ⁻ is above — the operator is available and some of
             # its questions were declined — so the reader sees a narrowed universe as narrowed,
             # never as a complete one. Both numbers come from the one plan generation used.
-            row = _census_row(
-                estimate_universe_size(func_node, {cat}), count_swap_withheld(func_node)
-            )
+            over_budget = count_swap_withheld(func_node)
+            row = _census_row(estimate_universe_size(func_node, {cat}), over_budget)
+            by["pair_budget"] = over_budget
         else:
             generated, withheld = estimate_universe_size(func_node, {cat}), 0
             row = _census_row(generated, withheld)
+        if annotation[cat.value]:
+            # Counted AFTER the policy rows so the reason is its own: an annotation site is not a
+            # purity or budget decision. The disposition is recomputed from the new totals.
+            by["annotation"] = annotation[cat.value]
+            row["withheld"] = int(row["withheld"]) + annotation[cat.value]  # type: ignore[call-overload]
+            row["disposition"] = operator_disposition(
+                int(row["generated"]),  # type: ignore[call-overload]
+                int(row["withheld"]),  # type: ignore[call-overload]
+            )
+        # WHY the withheld count is what it is, by reason (#22): a count with no reason is a number
+        # nobody can disagree with. Appended after `disposition`, so the row's existing key order is
+        # untouched for every reader of it.
+        row["withheld_by"] = {reason: n for reason, n in by.items() if n}
         census[cat] = row
     return census
 
diff --git a/Wesker/kill_ledger.py b/Wesker/kill_ledger.py
new file mode 100644
index 0000000..80aefe4
--- /dev/null
+++ b/Wesker/kill_ledger.py
@@ -0,0 +1,149 @@
+"""Detection kills and declared-contract kills are different evidence (Wesker #22).
+
+``killed`` answers "did the suite fail under this mutant", and the failing test may have meant two very
+different things by it. A test that ASSERTS a value, or declares that an error is raised
+(``pytest.raises``), states what the function does: a contract kill. A test that merely crashes under the
+mutant, an unexpected exception from a test that expected none, proves the mutant was ENTERED and
+broke something, which is detection and not specification. And a mutant whose only possible kill is that
+any test reaching it fails (an injected raise) measures REACH. The three were one counter, so a
+specification figure and a "the suite noticed" figure could not be told apart in the ledger.
+
+The split is by the kill reason the engine already records, plus a registry of the dimensions whose kills
+are reach-class by construction whatever the reason says.
+"""
+
+from __future__ import annotations
+
+# The kill reasons the engine records (Wesker.engine: killed_by).
+KILL_ASSERTION = "assertion"
+KILL_EXCEPTION = "exception"
+KILL_CRASH = "crash"
+
+# The kill classes.
+CLASS_CONTRACT = (
+    "contract"  # a test stated the behaviour: an assertion, or a declared exception
+)
+CLASS_DETECTION = (
+    "detection"  # a test broke under the mutant without stating anything about it
+)
+CLASS_REACH = "reach"  # the kill is "a test reached the mutant and it fails there" and nothing more
+CLASS_UNSCORED = "unscored"  # no kill: the observation ended without a verdict
+CLASS_NONE = "none"  # not killed
+
+# Dimension keys (or key prefixes) whose kills are reach-class by construction: an injected raise fails
+# EVERY test that reaches the call, so its kill says the call was reached, not what it should do
+# (Wesker.mu_minus catalog, "raise"). A kill of one of these is CLASS_REACH whatever `killed_by` says.
+REACH_CLASS_DIMENSIONS: tuple[str, ...] = ("OUTPUT:raise_inject",)
+
+KILL_CLASSES = (CLASS_CONTRACT, CLASS_DETECTION, CLASS_REACH)
+
+
+def kill_class(killed_by: str, dimension: str, reach_dimensions: list[str]) -> str:
+    """Which kind of evidence a kill is (#22, pure — pinned).
+
+    * ``contract``  — ``assertion`` or ``exception``: the test said what the function does, or that it
+      raises. Unless the dimension is reach-class, in which case the failure is not a statement about
+      the function.
+    * ``reach``     — the dimension is in ``reach_dimensions`` (matched as a prefix): whatever the test
+      reported, the kill only shows the mutant was reached.
+    * ``detection`` — ``crash``: something broke; nothing was stated.
+    * ``unscored``  — any other recorded reason (``diverged``, ``undetermined``, ``memory_cut``…): the
+      observation ended with no verdict, so it is not a kill of any class.
+    * ``none``      — no reason: not killed.
+
+    Reach is decided first, so a reach-class dimension can never be counted as a contract the suite
+    declared.
+    """
+    if not killed_by:
+        return CLASS_NONE
+    if killed_by in (KILL_ASSERTION, KILL_EXCEPTION, KILL_CRASH) and any(
+        dimension.startswith(prefix) for prefix in reach_dimensions
+    ):
+        return CLASS_REACH
+    if killed_by in (KILL_ASSERTION, KILL_EXCEPTION):
+        return CLASS_CONTRACT
+    if killed_by == KILL_CRASH:
+        return CLASS_DETECTION
+    return CLASS_UNSCORED
+
+
+def kill_ledger(records: list[dict]) -> dict[str, int]:
+    """Count a run's kill records by class (the ledger carried to the rollup and ``--json``).
+
+    ``records`` are ``killed_records``-shaped dicts. Every class is present, including at 0, because a
+    class that never fired and a class nobody counted must not read alike. ``kills`` is the sum, so the
+    total can be reconciled against ``total_killed`` from the payload alone.
+    """
+    ledger = {cls: 0 for cls in (*KILL_CLASSES, CLASS_UNSCORED)}
+    for record in records:
+        cls = kill_class(
+            str(record.get("killed_by") or ""),
+            str(record.get("dimension") or ""),
+            list(REACH_CLASS_DIMENSIONS),
+        )
+        if cls in ledger:
+            ledger[cls] += 1
+    ledger["kills"] = sum(ledger[cls] for cls in KILL_CLASSES)
+    return ledger
+
+
+def merge_ledgers(ledgers: list[dict[str, int]]) -> dict[str, int]:
+    """Sum several functions' ledgers (the rollup). Every ledger must carry every class: a result with no
+    ledger is the caller's to count as unledgered, not a ledger of zeros."""
+    merged = {cls: 0 for cls in (*KILL_CLASSES, CLASS_UNSCORED)}
+    for one in ledgers:
+        for cls in merged:
+            merged[cls] += int(one[cls])
+    merged["kills"] = sum(merged[cls] for cls in KILL_CLASSES)
+    return merged
+
+
+def mutant_ledger(
+    killed: list[dict],
+    survivors: list[dict],
+    unscored: list[dict],
+    line_coverage: dict[str, list[int]],
+) -> list[dict]:
+    """One row per executed mutant, joined to its site and to the evidence of how it was handled (#22).
+
+    The records already carry the mutant, its dimension, its fire line and (since #22) its site id. This
+    row adds the rest of the chain: the disposition (which says how far the mutant got: killed or
+    survived after entry, or the earlier stage it stopped at), the kill class when it was killed, and
+    REACH: how many covering tests executed the mutated line in the baseline. ``reach_tests`` is None when
+    the mutator reported no line, never 0, because "no line reported" and "no test reaches it" are
+    different facts. Rows keep the order killed, survived, unscored.
+    """
+
+    def reach(record: dict) -> int | None:
+        line = record.get("mutated_line")
+        if not isinstance(line, int):
+            return None
+        return sum(1 for lines in line_coverage.values() if line in lines)
+
+    rows: list[dict] = []
+    for outcome, records, default in (
+        ("killed", killed, "killed_after_entry"),
+        ("survived", survivors, "survived_after_entry"),
+        ("unscored", unscored, ""),
+    ):
+        for record in records:
+            row = {
+                "mutant_id": record.get("mutant_id"),
+                "site": record.get("site", ""),
+                "category": record.get("category"),
+                "dimension": record.get("dimension"),
+                "mutated_line": record.get("mutated_line"),
+                "outcome": outcome,
+                "disposition": record.get("disposition") or default,
+                "reach_tests": reach(record),
+            }
+            if outcome == "killed":
+                row["killed_by"] = record.get("killed_by")
+                row["kill_class"] = record.get("kill_class") or kill_class(
+                    str(record.get("killed_by") or ""),
+                    str(record.get("dimension") or ""),
+                    list(REACH_CLASS_DIMENSIONS),
+                )
+                row["test"] = record.get("test")
+            rows.append(row)
+    return rows
