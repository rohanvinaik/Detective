diff --git a/tests/test_site_census_intent.py b/tests/test_site_census_intent.py
new file mode 100644
index 0000000..a4f0c42
--- /dev/null
+++ b/tests/test_site_census_intent.py
@@ -0,0 +1,504 @@
+"""The census is per candidate site, joins each mutant to it, and ledgers kills by kind (Wesker #22, #30).
+
+THE DEFECTS, measured on Wesker 2fbd029. (1) The census was 11 category rows of counts: no stable site ids,
+no disposition per site and operator, so "the operator considered this site and declined it" could not be
+read, only inferred from a total. (2) A killed record carried ``mutant_id``, ``dimension``, ``mutated_line``
+and ``killed_by`` but no site id, and nothing joined the mutant to the evidence by which it was entered,
+detected or pinned. (3) Detection kills (a crash) and declared-contract kills (an assertion, a declared
+exception) were one counter, separable only by re-reading ``killed_by``. (4) Annotation sites (Wesker #30,
+option A) were excluded silently: ARITHMETIC read ``generated: 2, withheld: 0`` on a function with three
+annotation BinOps.
+
+These tests state the contract from intent: every candidate pair has exactly one disposition, a generated
+site's count reconciles with the universe, annotation sites are SHOWN as withheld and generate nothing, a
+mutant's site is a site of the census, and the ledger's classes sum to the kills.
+"""
+
+from __future__ import annotations
+
+import ast
+import importlib
+import sys
+
+import pytest
+
+from Wesker.caught_exceptions import observe_caught_exceptions
+from Wesker.engine import (
+    MutationCategory,
+    _count_targets,
+    generate_mutants,
+    run_function_profiling,
+)
+from Wesker.filter import category_census
+from Wesker.kill_ledger import (
+    CLASS_CONTRACT,
+    CLASS_DETECTION,
+    CLASS_NONE,
+    CLASS_REACH,
+    CLASS_UNSCORED,
+    REACH_CLASS_DIMENSIONS,
+    kill_class,
+    kill_ledger,
+    merge_ledgers,
+    mutant_ledger,
+)
+from Wesker.policy import _FINGERPRINT_CORPUS
+from Wesker.site_census import (
+    CANDIDATE_CLASSES,
+    D_GENERATED,
+    D_NOT_APPLICABLE,
+    D_WITHHELD,
+    annotation_site_counts,
+    is_candidate_class,
+    site_census,
+    site_disposition,
+)
+from Wesker.site_ids import SiteIndex, site_key_of
+
+_ANNOTATED = (
+    "from __future__ import annotations\n"
+    "def f(cap: int | None, xs: list[int | str] = [], *, k: 'a + b' = 1) -> int | str:\n"
+    "    y: tuple[int, 3 + 4] = (cap, 1)\n"
+    "    return y[0] + k\n"
+)
+
+
+def _fn(src: str, name: str | None = None) -> ast.FunctionDef:
+    for node in ast.parse(src).body:
+        if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef)) and (
+            name is None or node.name == name
+        ):
+            return node  # type: ignore[return-value]
+    raise AssertionError(name)
+
+
+_CORPUS_NODES = [_fn(src) for src in _FINGERPRINT_CORPUS] + [_fn(_ANNOTATED)]
+
+
+def _all_ops(census: dict) -> list[tuple[dict, str, dict]]:
+    return [
+        (site, cat, entry)
+        for site in census["sites"]
+        for cat, entry in site["operators"].items()
+    ]
+
+
+# ── #30: annotation sites are counted as withheld(annotation) ───────────────────────────────────────
+
+
+def test_the_category_census_counts_annotation_sites_as_withheld():
+    """The measured shape: ARITHMETIC read generated 2, withheld 0 beside three annotation BinOps."""
+    src = (
+        "from __future__ import annotations\n"
+        "def f(a: int | None, b: int | str = 1 + 1) -> int | str:\n"
+        "    x: int | str = a\n"
+        "    return a + b * 2\n"
+    )
+    node = _fn(src)
+    row = category_census(node)[MutationCategory.ARITHMETIC]
+    assert (
+        row["generated"] == 3
+    )  # the default `1 + 1`, `a + ...`, `b * 2`: behavioral targets
+    assert row["withheld"] == 4  # the four annotation `|`s: a, b, the return, x
+    assert row["withheld_by"] == {"annotation": 4}
+    assert (
+        row["disposition"] == "generated"
+    )  # generated wins; the withheld count still travels
+
+
+def test_an_annotation_only_category_reads_withheld_not_absent():
+    src = "def f(x: int | None):\n    return x\n"
+    row = category_census(_fn(src))[MutationCategory.ARITHMETIC]
+    assert (row["generated"], row["withheld"], row["disposition"]) == (0, 1, "withheld")
+    assert row["withheld_by"] == {"annotation": 1}
+
+
+def test_a_function_without_annotations_has_no_annotation_withheld():
+    row = category_census(_fn("def f(x):\n    return x + 1\n"))[
+        MutationCategory.ARITHMETIC
+    ]
+    assert row["withheld_by"] == {} and row["withheld"] == 0
+
+
+def test_the_annotation_count_is_the_complement_of_the_shared_behavioral_walk():
+    counts = annotation_site_counts(_fn(_ANNOTATED))
+    # `int | str`, `list[int | str]`'s `|`, `a + b` string, `tuple[int, 3 + 4]`'s `+`: BinOps in annotations
+    assert counts["ARITHMETIC"] == 4
+    assert counts["VALUE"] >= 2
+    assert sum(counts.values()) > 0
+
+
+def test_no_generated_mutant_comes_from_an_annotation_site():
+    node = _fn(_ANNOTATED)
+    census = site_census(node)
+    annotation_ids = {s["id"] for s in census["sites"] if s["annotation"]}
+    assert annotation_ids
+    for m in generate_mutants(node, set(MutationCategory) - {MutationCategory.OUTPUT}):
+        assert m.site not in annotation_ids, m.description
+
+
+def test_annotation_sites_are_withheld_for_every_operator_whose_class_matches():
+    census = site_census(_fn(_ANNOTATED))
+    flagged = [(s, c, e) for s, c, e in _all_ops(census) if s["annotation"]]
+    assert flagged
+    for site, cat, entry in flagged:
+        assert (entry["disposition"], entry["reason"]) == (D_WITHHELD, "annotation"), (
+            site["id"],
+            cat,
+        )
+
+
+# ── #22: stable site ids ────────────────────────────────────────────────────────────────────────────
+
+
+def test_a_site_id_carries_location_role_and_source_digest():
+    node = _fn("def f(x):\n    return x + 1\n")
+    index = SiteIndex(node)
+    key = next(k for k in index.site_keys() if k[0] == "BinOp")
+    ident = index.site_id(key)
+    assert ident.startswith("BinOp@2:11-2:16/")
+    assert "/Return.value/" in ident
+    assert len(ident.rsplit("/", 1)[1]) == 8
+
+
+def test_an_id_is_stable_across_calls_and_changes_with_the_code_at_the_site():
+    a = _fn("def f(x):\n    return x + 1\n")
+    b = _fn("def f(x):\n    return x + 2\n")
+    ids_a = [s["id"] for s in site_census(a)["sites"]]
+    assert ids_a == [s["id"] for s in site_census(a)["sites"]]
+    binop_a = next(i for i in ids_a if i.startswith("BinOp"))
+    binop_b = next(
+        s["id"] for s in site_census(b)["sites"] if s["id"].startswith("BinOp")
+    )
+    assert (
+        binop_a.rsplit("/", 1)[0] == binop_b.rsplit("/", 1)[0]
+    )  # same place, same role
+    assert binop_a != binop_b  # different code there
+
+
+def test_two_nodes_sharing_a_span_are_told_apart_by_role():
+    node = _fn("def f(x):\n    return -x\n")
+    ids = [s["id"] for s in site_census(node)["sites"]]
+    assert len(ids) == len(set(ids))
+
+
+# ── #22: a total disposition per site and operator ─────────────────────────────────────────────────
+
+
+@pytest.mark.parametrize("node", _CORPUS_NODES, ids=lambda n: n.name)
+def test_every_listed_pair_has_one_disposition_and_reconciles_with_the_universe(node):
+    census = site_census(node, two_sign=True)
+    allowed = {D_GENERATED, D_WITHHELD, "unsupported", D_NOT_APPLICABLE}
+    for site, cat, entry in _all_ops(census):
+        assert entry["disposition"] in allowed
+        assert cat in CANDIDATE_CLASSES or cat == "STMT"
+        if entry["disposition"] == D_GENERATED:
+            assert entry["targets"] > 0
+        else:
+            assert "reason" in entry, (site["id"], cat)
+    for cat, row in census["reconciliation"].items():
+        assert row["site_targets"] + row["function_level"] == row["category_targets"], (
+            cat
+        )
+        if cat != "OUTPUT":
+            assert row["function_level"] == 0, cat
+
+
+@pytest.mark.parametrize("node", _CORPUS_NODES, ids=lambda n: n.name)
+def test_the_census_target_total_is_the_universe_estimate(node):
+    census = site_census(node, two_sign=True)
+    for category in MutationCategory:
+        row = census["reconciliation"][category.value]
+        assert row["category_targets"] == _count_targets(node, category), category
+
+
+@pytest.mark.parametrize("node", _CORPUS_NODES, ids=lambda n: n.name)
+def test_a_note_only_lands_on_a_node_of_its_operators_candidate_classes(node):
+    """The class table is the only second predicate; this is its guard. If a mutator ever notes a
+    candidate on a node class the table does not list, that site would read not_a_candidate_class."""
+    census = site_census(node, two_sign=True)
+    index = SiteIndex(node)
+    listed = {(s["id"], cat) for s, cat, _e in _all_ops(census)}
+    for m in generate_mutants(
+        node,
+        set(MutationCategory),
+        max_per_category=0,
+        greedy=False,
+        observed_return_types=frozenset({"int", "str", "list"}),
+    ):
+        if not m.site or m.site == "function":
+            continue
+        assert (m.site, m.category.value) in listed, (m.description, m.site)
+        assert index.node(m.site_key) is not None
+
+
+@pytest.mark.parametrize("node", _CORPUS_NODES, ids=lambda n: n.name)
+def test_every_generated_mutant_is_joined_to_a_generated_site(node):
+    census = site_census(node, two_sign=True)
+    generated = {
+        (s["id"], cat)
+        for s, cat, e in _all_ops(census)
+        if e["disposition"] == D_GENERATED
+    }
+    for m in generate_mutants(
+        node, set(MutationCategory), max_per_category=0, greedy=False
+    ):
+        assert m.site, m.description
+        if m.site != "function":
+            assert (m.site, m.category.value) in generated, m.description
+
+
+def test_site_disposition_precedence():
+    sd = site_disposition
+    assert sd(False, True, 5, "h", "x:y") == "not_applicable:not_a_candidate_class"
+    assert sd(True, True, 5, "h", "") == "withheld:annotation"
+    assert sd(True, False, 5, "purity_overlay", "") == "withheld:purity_overlay"
+    assert sd(True, False, 5, "", "") == "generated:"
+    assert (
+        sd(True, False, 0, "purity_overlay", "")
+        == "not_applicable:no_alternative_at_site"
+    )
+    assert sd(True, False, 0, "", "unsupported:name_sub_not_enrolled") == (
+        "unsupported:name_sub_not_enrolled"
+    )
+    assert sd(True, False, 0, "", "") == "not_applicable:no_alternative_at_site"
+    assert sd(True, False, -3, "", "") == "not_applicable:no_alternative_at_site"
+
+
+def test_candidate_class_table():
+    assert is_candidate_class("ARITHMETIC", "BinOp", False)
+    assert not is_candidate_class("ARITHMETIC", "Call", False)
+    assert is_candidate_class("STMT", "Assign", False)
+    assert not is_candidate_class("STMT", "Assign", True)
+    assert not is_candidate_class("STMT", "Name", False)
+    assert not is_candidate_class("NOPE", "Name", False)
+
+
+def test_the_purity_overlay_withholds_remove_assign_sites_by_name():
+    node = _fn("def f(self, v):\n    self.a = v\n    return v\n")
+    impure = site_census(node)
+    pure = site_census(node, is_pure=True)
+
+    def state_assign(census):
+        return next(
+            e for s, c, e in _all_ops(census) if c == "STATE" and s["node"] == "Assign"
+        )
+
+    assert state_assign(impure)["disposition"] == D_GENERATED
+    held = state_assign(pure)
+    assert (held["disposition"], held["reason"]) == (D_WITHHELD, "purity_overlay")
+
+
+def test_output_is_withheld_under_one_sign_and_generated_under_two_sign():
+    node = _fn("def f(x):\n    return x\n")
+    one = site_census(node)["by_operator"]["OUTPUT"]
+    two = site_census(node, two_sign=True)["by_operator"]["OUTPUT"]
+    assert one == {"withheld": {"one_sign_policy": 1}}
+    assert D_GENERATED in two
+
+
+def test_swap_records_the_budget_withheld_pairs_and_the_identical_operands():
+    wide = _fn("def f(a, b, c, d, e, g):\n    return h(a, b, c, d, e, g)\n")
+    entry = next(
+        e
+        for s, c, e in _all_ops(site_census(wide))
+        if c == "SWAP" and e.get("withheld")
+    )
+    assert entry["withheld"] == {"pair_budget": 5}
+    same = _fn("def f(x):\n    return g(False, False, x)\n")
+    entry = next(
+        e
+        for s, c, e in _all_ops(site_census(same))
+        if c == "SWAP" and e["disposition"] == D_GENERATED
+    )
+    assert entry["not_applicable"] == {"identical_operands": 1}
+
+
+def test_a_single_type_handler_with_no_observation_is_withheld_not_clean():
+    node = _fn(
+        "def f(x):\n    try:\n        return int(x)\n    except Exception:\n        return 0\n"
+    )
+    line = node.body[0].handlers[0].lineno
+    unobserved = site_census(node)
+    entry = next(e for s, c, e in _all_ops(unobserved) if s["node"] == "ExceptHandler")
+    assert entry["withheld"] == {"unobserved_handler": 1}
+    observed = site_census(node, caught={line: {}})
+    entry = next(e for s, c, e in _all_ops(observed) if s["node"] == "ExceptHandler")
+    assert (
+        "withheld" not in entry
+    )  # observed, and nothing narrower arrived: nothing to narrow
