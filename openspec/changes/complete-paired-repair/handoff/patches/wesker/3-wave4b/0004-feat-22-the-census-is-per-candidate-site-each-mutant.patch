+def test_kill_class_codes():
+    reach = list(REACH_CLASS_DIMENSIONS)
+    assert kill_class("assertion", "VALUE:int", reach) == CLASS_CONTRACT
+    assert kill_class("exception", "EXCEPTION:raise:X", reach) == CLASS_CONTRACT
+    assert kill_class("crash", "ARITHMETIC:Add", reach) == CLASS_DETECTION
+    assert kill_class("diverged", "ARITHMETIC:Add", reach) == CLASS_UNSCORED
+    assert kill_class("memory_cut", "", reach) == CLASS_UNSCORED
+    assert kill_class("", "ARITHMETIC:Add", reach) == CLASS_NONE
+    # a reach-class dimension is never a contract the suite declared, whatever the test reported
+    assert kill_class("assertion", "OUTPUT:raise_inject", reach) == CLASS_REACH
+    assert kill_class("crash", "OUTPUT:raise_inject:x", reach) == CLASS_REACH
+    assert kill_class("assertion", "OUTPUT:raise_swallow", reach) == CLASS_CONTRACT
+    assert kill_class("assertion", "OUTPUT:raise_inject", []) == CLASS_CONTRACT
