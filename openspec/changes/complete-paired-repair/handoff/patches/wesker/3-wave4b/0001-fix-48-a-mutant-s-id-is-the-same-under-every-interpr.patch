+def test_a_position_changes_the_id_and_the_structure_does_not():
+    a = _fn("def f(x):\n    return x + 1\n")
+    b = _fn("def f(x):\n\n    return x + 1\n")
+    assert canonical_ast(a, attributes=False) == canonical_ast(b, attributes=False)
+    assert canonical_digest("X", a) != canonical_digest("X", b)
