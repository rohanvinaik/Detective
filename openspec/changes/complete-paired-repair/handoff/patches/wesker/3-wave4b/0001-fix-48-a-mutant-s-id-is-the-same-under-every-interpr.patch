diff --git a/Wesker/canonical_ast.py b/Wesker/canonical_ast.py
new file mode 100644
index 0000000..0601086
--- /dev/null
+++ b/Wesker/canonical_ast.py
@@ -0,0 +1,143 @@
+"""A mutant's identity, independent of the interpreter that parsed it (Wesker #48).
+
+A content id used to hash ``ast.dump(node, include_attributes=True)``. Python 3.13 changed
+``ast.dump``'s default output (an empty list field is omitted), so the same mutation of the same source
+had one id under 3.12 and another under 3.13+, and a flag recorded under one interpreter family stopped
+resolving under the other with nothing saying why. The floor is 3.12 and the standard is 3.14, so both
+families are supported at once and the id must not read the interpreter.
+
+The canonical serialization below is Wesker's own, not the stdlib's. It fixes the three things the
+stdlib leaves to the version:
+
+* the field order: a node's own ``_fields`` then ``_attributes``, which are the grammar's declaration
+  order in every version this code supports;
+* what an absent field looks like: a field that is ``None``, an empty list, or not set at all is NOT
+  written, whichever version defaulted it, so a node built by hand with or without an optional field
+  serializes identically to the parsed one (3.13 started filling omitted list fields with ``[]``);
+* how a constant is spelled: its type name and ``repr``, which is the language's, not the dump's.
+
+The legacy serializers at the end reproduce each family's old ``ast.dump`` so that an id recorded under
+the old rule can be mapped to its new id by regenerating the SAME mutants under both. They are an
+emulation of a format that no longer decides anything: the new id is the only one issued.
+"""
+
+from __future__ import annotations
+
+import ast
+import hashlib
+from typing import Any
+
+# The two interpreter families the old derivation split into.
+FAMILY_PY312 = "py312"  # ast.dump writes an empty list field: `decorator_list=[]`
+FAMILY_PY313 = "py313+"  # ast.dump omits it
+LEGACY_FAMILIES = (FAMILY_PY312, FAMILY_PY313)
+
+
+def canonical_ast(node: ast.AST, *, attributes: bool = True) -> str:
+    """The version-independent serialization of an AST (pure over the tree).
+
+    ``attributes`` includes the source positions (``lineno``, ``col_offset``, ``end_lineno``,
+    ``end_col_offset``), which a mutant's identity has always carried: the same rewrite at a different
+    position is a different mutant. Structural equality ignores them (``attributes=False``).
+    """
+    if not isinstance(node, ast.AST):
+        raise TypeError(f"expected an AST node, got {type(node).__name__}")
+    out: list[str] = []
+    _emit(node, attributes, out)
+    return "".join(out)
+
+
+def _emit(value: Any, attributes: bool, out: list[str]) -> None:
+    if isinstance(value, ast.AST):
+        out.append(type(value).__name__)
+        out.append("(")
+        first = True
+        names = list(value._fields)
+        if attributes:
+            names += list(value._attributes)
+        for name in names:
+            try:
+                field_value = getattr(value, name)
+            except AttributeError:
+                continue
+            if field_value is None or (
+                isinstance(field_value, list) and not field_value
+            ):
+                continue
+            if not first:
+                out.append(",")
+            first = False
+            out.append(name)
+            out.append("=")
+            _emit(field_value, attributes, out)
+        out.append(")")
+    elif isinstance(value, list):
+        out.append("[")
+        for i, item in enumerate(value):
+            if i:
+                out.append(",")
+            _emit(item, attributes, out)
+        out.append("]")
+    else:
+        # A leaf: identifier, operator-free constant, flag. The type name keeps `1`, `1.0`, `True`
+        # and `'1'` apart; `repr` is the language's own spelling and does not move between versions.
+        out.append(f"{type(value).__name__}:{value!r}")
+
+
+def canonical_digest(category: str, node: ast.AST) -> str:
+    """``<CATEGORY>_<8 hex>`` over the canonical serialization (pure over the tree)."""
+    digest = hashlib.sha1(
+        canonical_ast(node).encode("utf-8", "surrogatepass"), usedforsecurity=False
+    ).hexdigest()[:8]
+    return f"{category}_{digest}"
+
+
+# ── The legacy derivations, kept only to migrate what they issued ──────────────────────────────────
+
+
+def legacy_ast_dump(node: ast.AST, family: str) -> str:
+    """``ast.dump(node, include_attributes=True)`` as the given family wrote it, whatever runs this.
+
+    Both families share one algorithm; they differ in one rule: whether an empty list field is
+    written (3.12) or omitted (3.13+). Re-implemented rather than delegated so that one interpreter can
+    produce the other's text; against the stdlib's own dump on the running interpreter it is byte-equal
+    (pinned by ``tests/test_canonical_ast_intent.py``).
+    """
+    if family not in LEGACY_FAMILIES:
+        raise ValueError(f"unknown interpreter family {family!r}")
+    omit_empty = family == FAMILY_PY313
+
+    def fmt(value: Any) -> str:
+        if isinstance(value, ast.AST):
+            cls = type(value)
+            args: list[str] = []
+            for names, is_attr in ((value._fields, False), (value._attributes, True)):
+                for name in names:
+                    try:
+                        field_value = getattr(value, name)
+                    except AttributeError:
+                        continue
+                    if field_value is None and getattr(cls, name, ...) is None:
+                        continue
+                    if (
+                        omit_empty
+                        and not is_attr
+                        and isinstance(field_value, list)
+                        and not field_value
+                    ):
+                        continue
+                    args.append(f"{name}={fmt(field_value)}")
+            return f"{cls.__name__}({', '.join(args)})"
+        if isinstance(value, list):
+            return "[" + ", ".join(fmt(item) for item in value) + "]"
+        return repr(value)
+
+    return fmt(node)
+
+
+def legacy_digest(category: str, node: ast.AST, family: str) -> str:
+    """The id the OLD derivation issued for this mutation under the given family."""
+    digest = hashlib.sha1(
+        legacy_ast_dump(node, family).encode("utf-8"), usedforsecurity=False
+    ).hexdigest()[:8]
+    return f"{category}_{digest}"
