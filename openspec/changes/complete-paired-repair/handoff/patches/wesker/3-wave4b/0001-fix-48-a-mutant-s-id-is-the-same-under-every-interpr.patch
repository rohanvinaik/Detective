+def test_the_legacy_dump_of_the_running_family_is_byte_equal_to_the_stdlibs():
+    for src in _CORPUS:
+        node = _fn(src)
+        assert legacy_ast_dump(node, _running_family()) == ast.dump(
+            node, include_attributes=True
+        )
+
+
+def test_the_two_families_differ_exactly_by_empty_list_fields():
+    node = _fn("def f(): pass")
+    old = legacy_ast_dump(node, FAMILY_PY312)
+    new = legacy_ast_dump(node, FAMILY_PY313)
+    assert "decorator_list=[]" in old and "decorator_list" not in new
+    assert old != new
+    assert legacy_digest("X", node, FAMILY_PY312) != legacy_digest(
+        "X", node, FAMILY_PY313
+    )
+
+
+def test_an_unknown_family_is_refused_by_name():
+    with pytest.raises(ValueError, match="unknown interpreter family"):
+        legacy_ast_dump(_fn("def f(): pass"), "py2")
+
+
+# ── the migration of recorded ids ───────────────────────────────────────────────────────────────────
+
+
+def test_a_recorded_old_id_of_either_family_resolves_to_the_same_mutant():
+    node = _fn("def f(x):\n    return x / 2\n")
+    assert isinstance(node, ast.FunctionDef)
+    table = mutant_id_migration(node, {MutationCategory.ARITHMETIC})
+    current = table["current"]
+    assert current
+    for family in LEGACY_FAMILIES:
+        assert table["legacy"][family]
+        for old, news in table["legacy"][family].items():
+            code, new = resolve_recorded_mutant_id(old, current, table["legacy"])
+            assert code in (ID_MIGRATED, ID_CURRENT)
+            assert new in current and new in news
+
+
+def test_the_running_interpreters_own_old_ids_are_what_ast_dump_issued():
+    node = _fn("def f(x):\n    return x / 2\n")
+    assert isinstance(node, ast.FunctionDef)
+    table = mutant_id_migration(node, {MutationCategory.ARITHMETIC})
+    for m in generate_mutants(
+        node, {MutationCategory.ARITHMETIC}, max_per_category=0, greedy=False
+    ):
+        digest = hashlib.sha1(
+            ast.dump(m.mutated_node, include_attributes=True).encode(),
+            usedforsecurity=False,
+        ).hexdigest()[:8]
+        old = f"{m.category.value}_{digest}"
+        assert table["legacy"][_running_family()][old] == [m.mutant_id]
+
+
+def test_resolution_states():
+    legacy = {
+        FAMILY_PY312: {"A_old": ["A_new"], "C_old": ["C_one", "C_two"]},
+        FAMILY_PY313: {"A_old2": ["A_new"], "C_old": ["C_one"]},
+    }
+    current = ["A_new", "C_one", "C_two"]
+    assert resolve_recorded_mutant_id("A_new", current, legacy) == (ID_CURRENT, "A_new")
+    assert resolve_recorded_mutant_id("A_old", current, legacy) == (
+        ID_MIGRATED,
+        "A_new",
+    )
+    assert resolve_recorded_mutant_id("A_old2", current, legacy) == (
+        ID_MIGRATED,
+        "A_new",
+    )
+    # two families agreeing on the same mutant is migrated; one old id naming two mutants is not applied
+    assert resolve_recorded_mutant_id("C_old", current, legacy) == (ID_AMBIGUOUS, "")
+    assert resolve_recorded_mutant_id("Z_old", current, legacy) == (ID_UNMAPPED, "")
+    assert resolve_recorded_mutant_id("", current, legacy) == (ID_UNMAPPED, "")
+    assert resolve_recorded_mutant_id("A_old", [], {}) == (ID_UNMAPPED, "")
