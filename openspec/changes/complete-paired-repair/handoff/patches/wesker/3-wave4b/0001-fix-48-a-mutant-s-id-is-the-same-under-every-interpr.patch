diff --git a/Wesker/mutant_ids.py b/Wesker/mutant_ids.py
new file mode 100644
index 0000000..a3cb86a
--- /dev/null
+++ b/Wesker/mutant_ids.py
@@ -0,0 +1,90 @@
+"""Recorded mutant ids across the id-derivation change (Wesker #48).
+
+A mutant id is what ``flag`` records and what a cached verdict or certificate refers to. The id used to
+depend on the interpreter (see :mod:`Wesker.canonical_ast`); it no longer does, which moves every id once.
+A record written under the old rule must still resolve, so this module regenerates a function's mutants
+and joins each one's NEW id to the ids the old rule issued for the same mutation, under each of the two
+interpreter families. A consumer holding a recorded id asks :func:`resolve_recorded_mutant_id`.
+
+Nothing here guesses: an id that no regenerated mutant maps from is ``unmapped`` and an old id two
+different mutants map from is ``ambiguous``; the caller names both, and neither is dropped or applied.
+"""
+
+from __future__ import annotations
+
+import ast
+from typing import Any
+
+from .canonical_ast import LEGACY_FAMILIES, legacy_digest
+from .engine import MutationCategory, generate_mutants
+
+# The codes of resolve_recorded_mutant_id.
+ID_CURRENT = "current"  # the recorded id is an id the current derivation issues for this function
+ID_MIGRATED = "migrated"  # an old-rule id of exactly one current mutant
+ID_AMBIGUOUS = (
+    "ambiguous"  # an old-rule id of more than one current mutant: not applied
+)
+ID_UNMAPPED = "unmapped"  # no current mutant of this function has or had this id
+
+
+def mutant_id_migration(
+    func_node: ast.FunctionDef | ast.AsyncFunctionDef,
+    categories: set[MutationCategory] | None = None,
+    observed_return_types: frozenset[str] | None = None,
+) -> dict[str, Any]:
+    """The old-id to new-id table for one function's whole mutant universe (impure only in generating).
+
+    ``current`` lists every id the present derivation issues. ``legacy`` maps, per interpreter family,
+    each id the old rule issued for the same mutation to the list of current ids it belongs to (one
+    entry means a clean mapping). ``observed_return_types`` must be the run's own when OUTPUT mutants
+    are in play, because those mutants depend on it exactly as generation does.
+    """
+    cats = set(MutationCategory) if categories is None else categories
+    mutants = generate_mutants(
+        func_node,
+        cats,
+        max_per_category=0,
+        greedy=False,
+        observed_return_types=observed_return_types,
+    )
+    current: list[str] = []
+    legacy: dict[str, dict[str, list[str]]] = {fam: {} for fam in LEGACY_FAMILIES}
+    for m in mutants:
+        if m.mutant_id not in current:
+            current.append(m.mutant_id)
+        for fam in LEGACY_FAMILIES:
+            old = legacy_digest(m.category.value, m.mutated_node, fam)
+            bucket = legacy[fam].setdefault(old, [])
+            if m.mutant_id not in bucket:
+                bucket.append(m.mutant_id)
+    return {"current": current, "legacy": legacy}
+
+
+def resolve_recorded_mutant_id(
+    recorded: str, current: list[str], legacy: dict[str, dict[str, list[str]]]
+) -> tuple[str, str]:
+    """(code, current id or "") for an id found in a stored record (#48, pure — pinned).
+
+    Split out of the consumer because the decision takes only strings and a table: the consumer owns
+    reading the store and rewriting it, and nothing else. The codes are the four states a stored id can be
+    in, and their remedies differ, so none shares a result:
+
+    * ``current``   — already an id of this function's present universe; nothing to migrate.
+    * ``migrated``  — one current mutant has this id under the old rule in exactly one family reading;
+      the second element is that mutant's current id.
+    * ``ambiguous`` — the old rule issued this id for more than one current mutant (an 8-hex collision,
+      or the two families disagreeing); no id is returned, because applying either would be a guess.
+    * ``unmapped``  — no current mutant of this function maps from it (the source or the policy moved).
+    """
+    if recorded in current:
+        return ID_CURRENT, recorded
+    candidates: list[str] = []
+    for table in legacy.values():
+        for new in table.get(recorded, []):
+            if new not in candidates:
+                candidates.append(new)
+    if len(candidates) == 1:
+        return ID_MIGRATED, candidates[0]
+    if candidates:
+        return ID_AMBIGUOUS, ""
+    return ID_UNMAPPED, ""
