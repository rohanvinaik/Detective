+def test_every_generated_mutant_id_is_the_canonical_digest_of_its_node():
+    """The engine issues the canonical id, not the stdlib dump's: for every category, over the corpus."""
+    for src in _CORPUS:
+        node = _fn(src)
+        assert isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef))
+        for m in generate_mutants(
+            node, set(MutationCategory), max_per_category=0, greedy=False
+        ):
+            assert m.mutant_id == canonical_digest(m.category.value, m.mutated_node)
+
+
+def test_the_issue_example_has_these_ids_under_every_interpreter():
+    """``def f(x): return x / 2`` (the issue's function): its mutants' ids are LITERALS here, the one
+    place a literal id is the point. Under the old derivation 3.12 and 3.14 issued different ids for the
+    same mutants; these are the ids under BOTH. OUTPUT is left out, whose operator set is another lane's
+    to change; the claim is the derivation's, and holds for every category the same way."""
+    node = _fn("def f(x): return x / 2")
+    categories = {c for c in MutationCategory if c is not MutationCategory.OUTPUT}
+    ids = {
+        m.mutant_id
+        for m in generate_mutants(node, categories, max_per_category=0, greedy=False)
+    }
+    assert ids == {
+        "ARITHMETIC_604d35b9",
+        "STATE_233b258c",
+        "VALUE_03271896",
+        "VALUE_56506e78",
+    }
+
