+def test_an_absent_field_is_not_written_whichever_version_defaulted_it():
+    """A node built by hand without its optional or list fields, and the parsed node with them set to
+    None / [], serialize identically. 3.13 fills the omitted fields in; 3.12 leaves them unset."""
+    parsed = ast.parse("def f(): pass").body[0]
+    bare = ast.FunctionDef(
+        name="f",
+        args=ast.arguments(
+            posonlyargs=[], args=[], kwonlyargs=[], kw_defaults=[], defaults=[]
+        ),
+        body=[ast.Pass()],
+        decorator_list=[],
+    )
+    for node in (parsed, bare):
+        ast.fix_missing_locations(node)
+    assert canonical_ast(parsed, attributes=False) == canonical_ast(
+        bare, attributes=False
+    )
+
