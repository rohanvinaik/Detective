diff --git a/tests/test_canonical_ast_intent.py b/tests/test_canonical_ast_intent.py
new file mode 100644
index 0000000..64f33b2
--- /dev/null
+++ b/tests/test_canonical_ast_intent.py
@@ -0,0 +1,265 @@
+"""A mutant's content id does not depend on the interpreter (Wesker #48).
+
+THE DEFECT, measured 2026-10-25 for ``def f(x): return x / 2``: the OUTPUT mutants carried one id set under
+Python 3.12 (``OUTPUT_a6d1d302`` ...) and another under 3.13+ (``OUTPUT_988a4470`` ...), because the id
+hashed ``ast.dump(node, include_attributes=True)``, whose default output changed in 3.13 (an empty list
+field is omitted). A flag recorded under one family stopped resolving under the other with nothing saying
+why, though the id's own docstring promised "the SAME id in every mode, pass, and process".
+
+THE RULE (D1): the id hashes a canonical serialization of our own (:mod:`Wesker.canonical_ast`): explicit
+field order, absent fields not written, constants spelled by type and ``repr``. These tests state that rule
+from intent, and the golden digests below are literals, so running this file under 3.12 and under 3.14 is
+the cross-version proof: both must read the same bytes. The migration for ids already recorded (old id to
+new id over the same mutation) is covered at the end.
+"""
+
+from __future__ import annotations
+
+import ast
+import hashlib
+import sys
+
+import pytest
+
+from Wesker.canonical_ast import (
+    FAMILY_PY312,
+    FAMILY_PY313,
+    LEGACY_FAMILIES,
+    canonical_ast,
+    canonical_digest,
+    legacy_ast_dump,
+    legacy_digest,
+)
+from Wesker.engine import MutationCategory, generate_mutants
+from Wesker.mutant_ids import (
+    ID_AMBIGUOUS,
+    ID_CURRENT,
+    ID_MIGRATED,
+    ID_UNMAPPED,
+    mutant_id_migration,
+    resolve_recorded_mutant_id,
+)
+
+# A corpus that reaches the node types the operators read and produce: every category's sites, defaults,
+# decorators, comprehensions, async, try/handlers, starred and keyword arguments, and each constant type.
+_CORPUS = (
+    "def a(x, y=1, *r, k=None, **kw):\n    return (x + y) * -x if x and not y else x ** 2\n",
+    (
+        "def b(xs):\n    t = 0\n    for x in xs:\n        if x is None:\n            break\n"
+        "        t += x // 2\n    return [t, {'a': 1.5}, {1, 2}, (3, b'z', 2j, ...)]\n"
+    ),
+    (
+        "def c(p):\n    try:\n        return int(p)\n    except (ValueError, TypeError):\n"
+        "        raise KeyError(p)\n    finally:\n        p = 0\n"
+    ),
+    "async def d(it):\n    out = [i async for i in it if i > 0]\n    return sorted(out, key=lambda v: -v)\n",
+    "@staticmethod\ndef e(self, a: int = 3, *, b: str = 'x') -> int:\n    self.v: int = a\n    return min(a, 2, 3) < a <= 4\n",
+    "def f(x):\n    with open(x) as fh:\n        return f'{fh.read()!r:>10}' + str(x)[1:2]\n",
+    "def g(a, b):\n    yield from a\n    return not (a in b) is (a is not b)\n",
+)
+
+# sha1 of the canonical text (attributes included) of the first definition of each source. LITERALS: the
+# same bytes under every supported interpreter is the claim, so this file is run under 3.12 and 3.14.
+_GOLDEN_CORPUS_DIGESTS = (
+    "bcc283ddd7c1af3df8a1ded227aace48c9c86331",
+    "25115daa09222978feb15d47a9bcea582fd49bb7",
+    "1e79de25b3c6559ef9a989ac860960ebea1ac973",
+    "d5c9ed75b6e5811fbb5c89427a3a9bc863211ccb",
+    "94f1a19ce728c829265ac48af3fbfe8c8f4025ce",
+    "7aa55f62fcd07531cbbfbac2a9bf8b2f57de6555",
+    "92bda6f677ffb491173fb4863a28882e4fad20af",
+)
+
+
+def _fn(src: str) -> ast.AST:
+    return ast.parse(src).body[0]
+
+
+def _digest(src: str) -> str:
+    return hashlib.sha1(
+        canonical_ast(_fn(src)).encode("utf-8"), usedforsecurity=False
+    ).hexdigest()
+
+
+def test_the_corpus_serializes_to_the_same_bytes_under_every_interpreter():
+    assert tuple(_digest(src) for src in _CORPUS) == _GOLDEN_CORPUS_DIGESTS
+
+
+def test_the_canonical_text_is_pinned_for_the_issue_example():
+    """A literal: the serialization of ``def f(x): return x / 2`` is these exact bytes under every
+    interpreter. If a future Python adds a default that leaks into the text, this is where it shows."""
+    text = canonical_ast(_fn("def f(x): return x / 2"))
+    assert text == (
+        "FunctionDef(name=str:'f',args=arguments(args=[arg(arg=str:'x',lineno=int:1,col_offset=int:6,"
+        "end_lineno=int:1,end_col_offset=int:7)]),body=[Return(value=BinOp(left=Name(id=str:'x',"
+        "ctx=Load(),lineno=int:1,col_offset=int:17,end_lineno=int:1,end_col_offset=int:18),op=Div(),"
+        "right=Constant(value=int:2,lineno=int:1,col_offset=int:21,end_lineno=int:1,end_col_offset=int:22),"
+        "lineno=int:1,col_offset=int:17,end_lineno=int:1,end_col_offset=int:22),lineno=int:1,"
