diff --git a/tests/test_swap_identical_operands_intent.py b/tests/test_swap_identical_operands_intent.py
new file mode 100644
index 0000000..0fd205d
--- /dev/null
+++ b/tests/test_swap_identical_operands_intent.py
@@ -0,0 +1,140 @@
+"""SWAP never transposes two identical operands (Wesker #53).
+
+THE DEFECT, measured on Wesker 2fbd029: for ``def f(x): return g(False, False, x)`` the SWAP operator
+generated ``SWAP_174b8740 | transpose call arguments | identical to original: True``. Transposing two
+operands that are the same expression writes the original back byte for byte, so the mutant can only
+survive: it enlarged the universe and the denominator, a report printed it with an empty diff, and
+Detective's DONE block asked a reader to ``flag`` a mutant that changed nothing (it surfaced on
+``cli.py::candidate_equivalent_caveat``, which calls ``residual_disposition(False, False, ...)``).
+
+The rule: a pair whose two operands have the same position-free canonical AST is not a candidate.
+These tests state it from intent: the identical pair yields no mutant, the distinct transpositions of
+the same call still appear, no SWAP mutant of any shape equals its original, and an identical pair does
+not spend the per-call-site budget a real question needed.
+"""
+
+from __future__ import annotations
+
+import ast
+
+from Wesker.engine import (
+    MutationCategory,
+    _count_targets,
+    _record_dimensions,
+    generate_mutants,
+)
+from Wesker.filter import category_census
+from Wesker.swap_plan import (
+    PAIR_DISTINCT,
+    PAIR_IDENTICAL,
+    SWAP_PAIR_BUDGET,
+    pair_standing,
+    swap_plan_keyed,
+)
+
+
+def _fn(src: str) -> ast.FunctionDef:
+    node = ast.parse(src).body[0]
+    assert isinstance(node, ast.FunctionDef)
+    return node
+
+
+def _swap_mutants(src: str):
+    return generate_mutants(
+        _fn(src), {MutationCategory.SWAP}, max_per_category=0, greedy=False
+    )
+
+
+def _transpositions(labels: list[str]) -> list[str]:
+    return [lab for lab in labels if not lab.endswith(("~unwrap", "~dual"))]
+
+
+def test_the_issue_example_has_no_identical_transposition():
+    src = "def f(x):\n    return g(False, False, x)\n"
+    original = ast.dump(_fn(src))
+    mutants = _swap_mutants(src)
+    assert all(ast.dump(m.mutated_node) != original for m in mutants)
+    # (0,1) is False<->False: gone. (0,2) and (1,2) are real; the call's value is used, so unwrap too.
+    labels = _record_dimensions(_fn(src), MutationCategory.SWAP, set())
+    assert sorted(_transpositions(labels)) == ["SWAP:g~p0,2", "SWAP:g~p1"]
+    assert len(mutants) == 3
+
+
+def test_the_distinct_transpositions_still_appear():
+    src = "def f(a, b):\n    return g(a, b, a)\n"
+    labels = _record_dimensions(_fn(src), MutationCategory.SWAP, set())
+    # a,b and b,a differ; a,a (0,2) is the identical one.
+    assert _transpositions(labels) == ["SWAP:g", "SWAP:g~p1"]
+
+
+def test_no_swap_mutant_of_any_call_equals_its_original():
+    sources = [
+        "def f(x):\n    return g(x, x)\n",
+        "def f(x):\n    return g(1, 1, 1)\n",
+        "def f(x):\n    return g(h(x), h(x), x)\n",
+        "def f(x):\n    return g(*x, *x)\n",
+        "def f(x):\n    g(None, None)\n    return min(x, x)\n",
+    ]
+    for src in sources:
+        original = ast.dump(_fn(src))
+        for m in _swap_mutants(src):
+            assert ast.dump(m.mutated_node) != original, (src, m.description)
+
+
+def test_equal_looking_but_different_constants_are_distinct():
+    """``1`` and ``True`` compare equal at runtime but are different expressions and different
+    types; swapping them is a real mutant, and so is ``1`` against ``1.0``."""
+    for src in (
+        "def f():\n    return g(1, True)\n",
+        "def f():\n    return g(1, 1.0)\n",
+        "def f():\n    return g(0.0, -0.0)\n",
+        "def f(a):\n    return g(a, a.b)\n",
+    ):
+        assert _transpositions(
+            _record_dimensions(_fn(src), MutationCategory.SWAP, set())
+        ), src
+
+
+def test_identical_means_equal_trees_regardless_of_source_position():
+    src = "def f(x):\n    return g(\n        h(x),\n    h(x),\n    )\n"
+    assert (
+        _transpositions(_record_dimensions(_fn(src), MutationCategory.SWAP, set()))
+        == []
+    )
+
+
+def test_an_identical_pair_does_not_spend_the_budget():
+    """Seven operands, the first six pairwise distinct plus a repeat of the first: the repeat's
+    pair is not a question and leaves the budget to real ones."""
+    keys = [f"k{i}" for i in range(6)] + ["k0"]
+    asked, withheld, identical = swap_plan_keyed(keys, SWAP_PAIR_BUDGET)
+    assert identical == [(0, 6)]
+    assert (0, 6) not in asked
+    assert len(asked) == SWAP_PAIR_BUDGET
+    assert len(asked) + withheld + len(identical) == 21  # C(7, 2)
+
+
+def test_the_count_and_the_generation_agree():
+    src = "def f(x):\n    return g(False, False, x)\n"
+    node = _fn(src)
+    assert _count_targets(node, MutationCategory.SWAP) == len(_swap_mutants(src))
+
+
+def test_the_census_does_not_count_the_identical_pair_as_generated_or_withheld():
+    row = category_census(_fn("def f(x):\n    return g(x, x)\n"))[MutationCategory.SWAP]
+    assert row["generated"] == 1  # unwrap only
+    assert row["withheld"] == 0
+
+
+def test_pair_standing_codes():
+    assert pair_standing("a", "a") == PAIR_IDENTICAL
+    assert pair_standing("a", "b") == PAIR_DISTINCT
+    assert pair_standing("", "") == PAIR_IDENTICAL
+    assert pair_standing("a", "") == PAIR_DISTINCT
+
+
+def test_plan_over_no_or_one_operand_has_nothing():
