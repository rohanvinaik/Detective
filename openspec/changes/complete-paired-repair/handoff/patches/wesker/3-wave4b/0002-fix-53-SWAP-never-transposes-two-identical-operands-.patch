+# The standing of one candidate transposition, by its two operands' canonical text.
+PAIR_DISTINCT = "distinct"  # the swap changes the program: a question
+PAIR_IDENTICAL = (
+    "identical_operands"  # the swap writes the same text back: not a mutant (#53)
+)
+
+
+def pair_standing(left_key: str, right_key: str) -> str:
+    """Whether transposing two operands can change anything (#53, pure — pinned).
+
+    The operands are compared by their canonical AST text (position-free), so ``g(False, False, x)``,
+    ``g(a, a)`` and ``g(f(1), f(1))`` are identical pairs; ``g(1, True)`` and ``g(1, 1.0)`` are not (the
+    constants differ in type). Split out of the mutator because it takes strings only: the mutator
+    owns serializing an operand, this owns what equality means. An identical pair has no mutant, since
+    the rewrite is the original byte for byte and nothing can kill it; it is counted by the census as
+    not applicable, never as a question asked.
+    """
+    return PAIR_IDENTICAL if left_key == right_key else PAIR_DISTINCT
+
+
+def swap_plan_keyed(
+    keys: list[str], budget: int
+) -> tuple[list[tuple[int, int]], int, list[tuple[int, int]]]:
+    """(pairs ASKED, count WITHHELD, pairs with IDENTICAL operands) for operand keys (pure — pinned).
+
+    Identical pairs leave the candidate list BEFORE the budget is spent, so a call that repeats an
+    operand does not lose a real question to a non-question. asked + withheld + len(identical) is
+    always C(n, 2).
+    """
+    distinct: list[tuple[int, int]] = []
+    identical: list[tuple[int, int]] = []
+    for i, j in swap_pairs(len(keys)):
+        if pair_standing(keys[i], keys[j]) == PAIR_IDENTICAL:
+            identical.append((i, j))
+        else:
+            distinct.append((i, j))
+    asked = distinct[: max(0, budget)]
+    return asked, len(distinct) - len(asked), identical
+
+
 def swap_label(callee: str, i: int, j: int) -> str:
     """The dimension label for transposing positional arguments ``i`` and ``j`` (pure — pinned).
 
