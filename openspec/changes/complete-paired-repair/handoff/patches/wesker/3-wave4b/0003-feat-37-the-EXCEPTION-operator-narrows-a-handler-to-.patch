new file mode 100644
index 0000000..cbbaeee
--- /dev/null
+++ b/Wesker/caught_exceptions.py
@@ -0,0 +1,208 @@
+"""What a handler was OBSERVED to catch in the baseline, and the narrowings that observation licenses (#37).
+
+The EXCEPTION operator widens a handler (``handler_broaden``) and swallows one, and had no dual for the
+widening refactor's inverse: narrowing ``except Exception:`` to a type that lets an error escape which the
+original caught. Detective #103 widened a parser guard from ``SyntaxError`` to ``Exception`` for exactly
+that reason, and the test that pinned the breadth was read as redundant, because no operator asked.
+
+The target type of a narrowing is a design decision, and the ruling (D4) is OBSERVED narrowing: a handler
+narrows only to a type the baseline actually delivered to it (a strict subclass of the declared type), so
+the question is "does any test pin that this handler catches T?" for a T that really arrives. An invented
+fixed subclass is refused: it would measure the operator's choice, not the program's. A tuple handler
+``except (A, B)`` needs no observation, since dropping one member at a time is static and exact.
+
+The observation rides ``sys.monitoring``'s ``EXCEPTION_HANDLED`` event through the broker in
+:mod:`Wesker.monitoring`, the one owner of interpreter instrumentation; there is no new trace hook here.
+The event fires once per ``try`` whose handler chain an exception enters, not per clause, so the clause
+that caught it is decided from the declared names by :func:`catching_clause`.
+"""
+
+from __future__ import annotations
+
+import ast
+import contextlib
+import dis
+import sys
+from collections.abc import Iterator
+from types import CodeType
+
+from .monitoring import subscribe
+
+# {handler line: {type key: MRO simple names, the type's own first}}. The handler line is the
+# ``except`` clause's own line in the function's source; a type key is ``module:qualname``.
+CaughtObservation = dict[int, dict[str, list[str]]]
+
+CLAUSE_NONE = (
+    "none"  # no clause of this try matches: the exception propagates out of it
+)
+CLAUSE_PREFIX = "clause:"
+
+
+def catching_clause(clauses: list[list[str]], mro: list[str]) -> str:
+    """Which clause of one ``try`` catches an exception, by the names it declares (#37, pure — pinned).
+
+    ``clauses`` holds, per ``except`` clause in source order, the simple names it declares (``[]`` for a
+    bare ``except:``, which catches everything); ``mro`` is the exception's own class name followed by its
+    bases'. Python takes the FIRST clause that matches, so the answer is ``clause:<i>`` for the first
+    clause that is bare or names a class in ``mro``, and ``none`` when no clause does, in which case the
+    exception leaves the ``try`` and no handler observed it. A declared name no MRO entry spells (an alias
+    or a rebound name) cannot match here, and the miss is ``none``, never a guess at another clause.
+    """
+    for index, declared in enumerate(clauses):
+        if not declared or any(name in mro for name in declared):
+            return f"{CLAUSE_PREFIX}{index}"
+    return CLAUSE_NONE
+
+
+# The standing of one handler under the narrowing operator, as the census states it.
+NARROW_BARE = "bare"  # an untyped `except:` has no type to narrow
+NARROW_OPAQUE = "opaque_type"  # the declared type is not a name: nothing to compare an observation to
+NARROW_DROP = "drop_member"  # a tuple handler: one mutant per member dropped
+NARROW_OBSERVED = "observed"  # a single type with at least one observed strict subtype
+NARROW_UNOBSERVED = (
+    "unobserved"  # a single type and no observation was made: withheld, not clean
+)
+NARROW_NO_SUBTYPE = (
+    "no_strict_subtype"  # observed, and nothing strictly narrower ever arrived
+)
+
+
+def narrowing_standing(
+    declared: list[str],
+    observed_run: bool,
+    candidates: int,
+    is_tuple: bool,
+    is_bare: bool,
+) -> str:
+    """What the narrowing operator does at one handler (#37, pure — pinned).
+
+    The two states that read alike are the ones that must not: ``unobserved`` (the baseline recorded no
+    caught types at all, so the handler is withheld and the remedy is to observe) and ``no_strict_subtype``
+    (it observed, and the handler only ever caught exactly its declared type, so there is nothing to
+    narrow to). ``observed_run`` says whether an observation was supplied for this run.
+    """
+    if is_bare:
+        return NARROW_BARE
+    if is_tuple:
+        return NARROW_DROP if len(declared) >= 2 else NARROW_OPAQUE
+    if not declared:
+        return NARROW_OPAQUE
+    if not observed_run:
+        return NARROW_UNOBSERVED
+    return NARROW_OBSERVED if candidates else NARROW_NO_SUBTYPE
+
+
+def narrowing_candidates(
+    declared: list[str], observed: dict[str, list[str]]
+) -> list[str]:
+    """The observed type keys a single-type handler narrows to (#37, pure — pinned).
+
+    A candidate is an observed type whose MRO names the declared type and which is not that type: a
+    STRICT subclass, because narrowing to the declared type itself is the original program. Sorted by
+    key, so the order never depends on the order the tests happened to raise them in.
+    """
+    return sorted(
+        key
+        for key, mro in observed.items()
+        if mro and any(name in mro[1:] for name in declared) and mro[0] not in declared
+    )
+
+
+def _declared_names(handler_type: ast.expr | None) -> list[str]:
+    """Simple names a handler's ``type`` expression declares; an expression it cannot name gives []."""
+    if handler_type is None:
+        return []
+    if isinstance(handler_type, ast.Tuple):
+        names: list[str] = []
+        for elt in handler_type.elts:
+            names.extend(_declared_names(elt))
+        return names
+    if isinstance(handler_type, ast.Name):
+        return [handler_type.id]
+    if isinstance(handler_type, ast.Attribute):
+        return [handler_type.attr]
+    return []
+
+
+def _try_table(
+    func_node: ast.FunctionDef | ast.AsyncFunctionDef,
+) -> dict[int, tuple[list[list[str]], list[int]]]:
+    """{first clause line: (declared names per clause, each clause's line)} for every plain ``try``."""
+    table: dict[int, tuple[list[list[str]], list[int]]] = {}
+    for node in ast.walk(func_node):
+        if isinstance(node, ast.Try) and node.handlers:
+            table[node.handlers[0].lineno] = (
+                [_declared_names(h.type) for h in node.handlers],
+                [h.lineno for h in node.handlers],
+            )
+    return table
+
+
+def handler_entry_lines(code: CodeType) -> dict[int, int]:
+    """{handler entry offset: line of the first ``except`` clause it leads to} for one code object.
+
+    ``EXCEPTION_HANDLED`` reports the offset where a ``try``'s handler chain starts, and the frame's
+    own line at that moment is the RAISING line, so the offset is the only handle on which ``try``
+    it was. The instruction after the entry ``PUSH_EXC_INFO`` that carries a position is the first
+    clause's type expression (or the body of a bare ``except:``), whose line is that clause's line.
+    A ``finally`` leads to its own body's line, which no handler line equals.
+    """
+    instructions = list(dis.get_instructions(code))
+    index = {ins.offset: n for n, ins in enumerate(instructions)}
+    entries: dict[int, int] = {}
+    for entry in dis.Bytecode(code).exception_entries:
+        at = index.get(entry.target)
+        if at is None or instructions[at].opname != "PUSH_EXC_INFO":
+            continue
+        for ins in instructions[at + 1 :]:
+            line = ins.positions.lineno if ins.positions else None
+            if line is not None:
+                entries[entry.target] = line
+                break
+    return entries
+
+
+def type_key(exc_type: type) -> str:
+    """``module:qualname`` for an exception class: the spelling a mutant can resolve."""
+    return f"{exc_type.__module__}:{exc_type.__qualname__}"
+
+
+@contextlib.contextmanager
+def observe_caught_exceptions(
+    func_node: ast.FunctionDef | ast.AsyncFunctionDef, code: CodeType
+) -> Iterator[CaughtObservation]:
+    """Record the exception types ``func_node``'s handlers catch while the body runs (#37).
+
+    ``code`` is the ORIGINAL function's code object. The yielded dict fills as exceptions arrive and is
+    complete when the block exits; a failure of the observer itself is raised at exit by the broker's
+    handle check, never swallowed, so a partial observation cannot pass as a clean one.
+    """
+    table = _try_table(func_node)
+    entry_lines = handler_entry_lines(code)
+    observed: CaughtObservation = {}
+
+    def _on_handled(
+        _code: CodeType,
+        offset: int,
+        exc: BaseException,
+        frame: object = None,
+        run_token: int | None = None,
+    ) -> None:
+        line = entry_lines.get(offset)
+        entry = table.get(line) if line is not None else None
+        if entry is None:
+            return  # a `finally`, a `with`, or a try the table does not hold
+        clauses, lines = entry
+        mro = [c.__name__ for c in type(exc).__mro__]
+        chosen = catching_clause(clauses, mro)
+        if chosen == CLAUSE_NONE:
+            return
+        handler_line = lines[int(chosen[len(CLAUSE_PREFIX) :])]
+        observed.setdefault(handler_line, {})[type_key(type(exc))] = mro
+
+    handle = subscribe([code], sys.monitoring.events.EXCEPTION_HANDLED, _on_handled)
+    try:
+        yield observed
+    finally:
+        handle.close()
+    handle.check()
