diff --git a/tests/test_exception_narrowing_intent.py b/tests/test_exception_narrowing_intent.py
new file mode 100644
index 0000000..8d0cfd8
--- /dev/null
+++ b/tests/test_exception_narrowing_intent.py
@@ -0,0 +1,395 @@
+"""The EXCEPTION operator narrows a handler, so a test that pins its breadth is necessary (Wesker #37).
+
+THE DEFECT, measured 2026-10-04 dogfooding Detective's ``audit --remove`` on Detective itself:
+``suite_edit.remove_definition_from_source`` parses with ``except Exception:``, which Detective #103 had
+widened from ``except SyntaxError:`` because the parser also raises UnicodeEncodeError on a lone surrogate.
+#103's regression test, which feeds a lone surrogate, was read as redundant for kills AND lines and
+``--remove`` deleted it: another test covered the same lines and killed the same mutants. What the deleted
+test alone carried was the handler's BREADTH, and no operator asked that question. ``handler_broaden`` is
+the widening dual; narrowing (``except Exception:`` to ``except SyntaxError:``) is the refactor that lets
+an error escape that used to be caught, and it is exactly the defect #103 fixed.
+
+THE RULING (D4): observed narrowing. A single-type handler narrows to a type the baseline OBSERVED it
+catch (a strict subclass of the declared type); a tuple handler ``except (A, B)`` drops one member per
+mutant; an invented fixed subclass is refused. These tests state that from intent: the observation is real
+(it comes from ``sys.monitoring``'s EXCEPTION_HANDLED through the broker, never a new trace hook), the
+mutants exist exactly where an observation or a tuple licenses them, a handler with no observation is
+WITHHELD by name and not read as clean, and the test that alone pins the breadth is the one that kills.
+"""
+
+from __future__ import annotations
+
+import ast
+import importlib
+import sys
+
+import pytest
+
+from Wesker.caught_exceptions import (
+    CLAUSE_NONE,
+    NARROW_BARE,
+    NARROW_DROP,
+    NARROW_NO_SUBTYPE,
+    NARROW_OBSERVED,
+    NARROW_OPAQUE,
+    NARROW_UNOBSERVED,
+    catching_clause,
+    narrowing_candidates,
+    narrowing_standing,
+    observe_caught_exceptions,
+)
+from Wesker.engine import MutationCategory, generate_mutants, run_function_profiling
+
+_GUARD = (
+    "def parse_guard(text):\n"
+    "    try:\n"
+    "        return int(text)\n"
+    "    except Exception:\n"
+    "        return None\n"
+)
+
+
+def _fn(src: str, name: str | None = None) -> ast.FunctionDef:
+    for node in ast.parse(src).body:
+        if isinstance(node, ast.FunctionDef) and (name is None or node.name == name):
+            return node
+    raise AssertionError(name)
+
+
+def _compile(src: str) -> dict:
+    ns: dict = {}
+    exec(compile(src, "<narrow>", "exec"), ns)  # noqa: S102
+    return ns
+
+
+def _narrow(src: str, caught=None, name: str | None = None) -> list[str]:
+    """The handler lines of every narrowing mutant, as source."""
+    node = _fn(src, name)
+    out = []
+    for m in generate_mutants(
+        node,
+        {MutationCategory.EXCEPTION},
+        max_per_category=0,
+        greedy=False,
+        observed_caught=caught,
+    ):
+        text = ast.unparse(m.mutated_node)
+        original = ast.unparse(node)
+        handlers = [
+            ln.strip() for ln in text.splitlines() if ln.strip().startswith("except")
+        ]
+        base = [
+            ln.strip()
+            for ln in original.splitlines()
+            if ln.strip().startswith("except")
+        ]
+        if handlers != base and "BaseException" not in " ".join(handlers):
+            out.extend(h for h in handlers if h not in base)
+    return out
+
+
+# ── the observation: what the baseline saw the handler catch ───────────────────────────────────────
+
+
+def test_the_observation_records_each_type_the_handler_caught():
+    ns = _compile(_GUARD)
+    node = _fn(_GUARD)
+    with observe_caught_exceptions(node, ns["parse_guard"].__code__) as caught:
+        ns["parse_guard"]("12")  # nothing raised: nothing observed
+        ns["parse_guard"]("x")  # ValueError
+        ns["parse_guard"](None)  # TypeError
+    handler_line = node.body[0].handlers[0].lineno
+    assert set(caught) == {handler_line}
+    assert set(caught[handler_line]) == {"builtins:ValueError", "builtins:TypeError"}
+    assert caught[handler_line]["builtins:ValueError"][:2] == [
+        "ValueError",
+        "Exception",
+    ]
+
+
+def test_an_exception_that_no_clause_catches_is_not_observed_as_caught():
+    src = "def f(x):\n    try:\n        return int(x)\n    except KeyError:\n        return 0\n"
+    ns = _compile(src)
+    with (
+        observe_caught_exceptions(_fn(src), ns["f"].__code__) as caught,
+        pytest.raises(ValueError),
+    ):
+        ns["f"]("x")
+    assert caught == {}
+
+
+def test_the_clause_that_caught_it_is_the_first_that_matches():
+    src = (
+        "def f(x):\n    try:\n        return int(x)\n    except ValueError:\n        return 1\n"
+        "    except (TypeError, KeyError):\n        return 2\n    except Exception:\n        return 3\n"
+    )
+    ns = _compile(src)
+    node = _fn(src)
+    with observe_caught_exceptions(node, ns["f"].__code__) as caught:
+        ns["f"]("x")
+        ns["f"](None)
+        ns["f"]([])
+    by_line = {h.lineno: i for i, h in enumerate(node.body[0].handlers)}
+    seen = {by_line[line]: set(types) for line, types in caught.items()}
+    assert seen == {
+        0: {"builtins:ValueError"},
+        1: {"builtins:TypeError"},
+    }
+
+
+def test_a_finally_or_a_nested_function_does_not_corrupt_the_table():
+    src = "def f(x):\n    try:\n        return int(x)\n    finally:\n        pass\n"
+    ns = _compile(src)
+    with (
+        observe_caught_exceptions(_fn(src), ns["f"].__code__) as caught,
+        pytest.raises(ValueError),
+    ):
+        ns["f"]("x")
+    assert caught == {}
+
+
+def test_a_subscription_is_closed_when_the_block_exits_or_fails():
+    from Wesker import monitoring
+
+    ns = _compile(_GUARD)
+    before = len(monitoring._active_subscriptions)
+    with (
+        pytest.raises(RuntimeError),
+        observe_caught_exceptions(_fn(_GUARD), ns["parse_guard"].__code__),
+    ):
+        raise RuntimeError("test body failed")
+    assert len(monitoring._active_subscriptions) == before
+
+
+# ── the mutants: an observed subtype, or a tuple's drop-one, and nothing invented ───────────────────
+
+
+def test_a_handler_narrows_to_each_observed_strict_subtype():
+    ns = _compile(_GUARD)
+    node = _fn(_GUARD)
+    with observe_caught_exceptions(node, ns["parse_guard"].__code__) as caught:
+        ns["parse_guard"]("x")
+        ns["parse_guard"](None)
+    assert sorted(_narrow(_GUARD, caught)) == [
+        "except TypeError:",
+        "except ValueError:",
+    ]
+
+
+def test_without_an_observation_a_single_type_handler_has_no_narrowing():
+    """No invented subclass: the operator does not choose a type for the program."""
+    assert _narrow(_GUARD, None) == []
+    assert _narrow(_GUARD, {}) == []
+
+
+def test_a_type_observed_only_as_the_declared_type_gives_no_narrowing():
+    src = "def f(x):\n    try:\n        return int(x)\n    except ValueError:\n        return 0\n"
+    ns = _compile(src)
+    with observe_caught_exceptions(_fn(src), ns["f"].__code__) as caught:
+        ns["f"]("x")
+    assert _narrow(src, caught) == []
+
+
+def test_a_tuple_handler_drops_one_member_at_a_time_with_no_observation():
+    src = (
+        "def f(x):\n    try:\n        return int(x)\n"
+        "    except (ValueError, TypeError, KeyError):\n        return 0\n"
+    )
+    assert sorted(_narrow(src, None)) == [
+        "except (TypeError, KeyError):",
+        "except (ValueError, KeyError):",
+        "except (ValueError, TypeError):",
+    ]
+
+
+def test_a_two_member_tuple_narrows_to_the_remaining_bare_type():
+    src = (
+        "def f(x):\n    try:\n        return int(x)\n"
+        "    except (ValueError, TypeError):\n        return 0\n"
+    )
+    assert sorted(_narrow(src, None)) == ["except TypeError:", "except ValueError:"]
+
+
+def test_a_bare_except_and_a_computed_type_have_nothing_to_narrow():
+    bare = "def f(x):\n    try:\n        return int(x)\n    except:\n        return 0\n"
+    computed = "def f(x, errs):\n    try:\n        return int(x)\n    except errs[0]:\n        return 0\n"
+    assert (
+        _narrow(bare, {5: {"builtins:ValueError": ["ValueError", "Exception"]}}) == []
+    )
+    assert _narrow(computed, None) == []
+
+
+def test_an_except_star_clause_is_outside_the_question():
+    src = "def f(x):\n    try:\n        return int(x)\n    except* (ValueError, TypeError):\n        return 0\n"
+    assert _narrow(src, None) == []
+
+
+def test_a_type_from_another_module_is_reached_through_import_not_the_mutants_globals():
+    src = _GUARD
+    node = _fn(src)
+    line = node.body[0].handlers[0].lineno
+    caught = {
+        line: {
+            "json.decoder:JSONDecodeError": [
+                "JSONDecodeError",
+                "ValueError",
+                "Exception",
+                "BaseException",
+                "object",
+            ]
+        }
+    }
+    (mutant,) = [
+        m
+        for m in generate_mutants(
+            node,
+            {MutationCategory.EXCEPTION},
+            max_per_category=0,
+            greedy=False,
+            observed_caught=caught,
+        )
+        if "JSONDecodeError" in ast.unparse(m.mutated_node)
+    ]
+    assert "__import__('json.decoder').JSONDecodeError" in ast.unparse(
+        mutant.mutated_node
+    )
+    ns = _compile(ast.unparse(mutant.mutated_node))
+    # the mutant builds and runs with no name from the observation in its globals
+    assert ns["parse_guard"]("12") == 12
+
+
+def test_the_target_count_the_dimension_record_and_the_generator_agree():
+    from Wesker.engine import _count_targets, estimate_universe_size
+
+    node = _fn(_GUARD)
+    line = node.body[0].handlers[0].lineno
+    caught = {line: {"builtins:ValueError": ["ValueError", "Exception"]}}
+    n_generated = len(
+        generate_mutants(
+            node,
+            {MutationCategory.EXCEPTION},
+            max_per_category=0,
+            greedy=False,
+            observed_caught=caught,
+        )
+    )
+    assert _count_targets(node, MutationCategory.EXCEPTION, None, caught) == n_generated
+    assert (
+        estimate_universe_size(node, {MutationCategory.EXCEPTION}, None, caught)
+        == n_generated
+    )
+    assert n_generated == _count_targets(node, MutationCategory.EXCEPTION) + 1
+
+
+# ── the pure decisions ──────────────────────────────────────────────────────────────────────────────
+
+
+def test_catching_clause_is_the_first_match_and_none_when_nothing_matches():
+    clauses = [["ValueError"], ["TypeError", "KeyError"], []]
+    assert catching_clause(clauses, ["ValueError", "Exception"]) == "clause:0"
+    assert (
+        catching_clause(clauses, ["KeyError", "LookupError", "Exception"]) == "clause:1"
+    )
+    assert (
+        catching_clause(clauses, ["OSError", "Exception"]) == "clause:2"
+    )  # bare catches all
+    assert catching_clause(clauses[:2], ["OSError", "Exception"]) == CLAUSE_NONE
+    assert catching_clause([], ["ValueError"]) == CLAUSE_NONE
+    assert catching_clause([["Exception"]], []) == CLAUSE_NONE
+
+
+def test_narrowing_candidates_are_strict_subtypes_sorted():
+    obs = {
+        "builtins:ValueError": ["ValueError", "Exception", "BaseException", "object"],
+        "builtins:Exception": ["Exception", "BaseException", "object"],
+        "builtins:KeyError": ["KeyError", "LookupError", "Exception", "BaseException"],
+        "builtins:SystemExit": ["SystemExit", "BaseException", "object"],
+        "x:Empty": [],
+    }
+    assert narrowing_candidates(["Exception"], obs) == [
+        "builtins:KeyError",
+        "builtins:ValueError",
+    ]
+    assert narrowing_candidates(["LookupError"], obs) == ["builtins:KeyError"]
+    assert narrowing_candidates(["ValueError"], obs) == []
+    assert narrowing_candidates([], obs) == []
+    assert narrowing_candidates(["Exception"], {}) == []
+
+
+@pytest.mark.parametrize(
+    ("declared", "run", "n", "tup", "bare", "want"),
+    [
+        ([], True, 0, False, True, NARROW_BARE),
+        (["A", "B"], False, 0, True, False, NARROW_DROP),
+        (["A"], False, 0, True, False, NARROW_OPAQUE),
+        ([], False, 0, False, False, NARROW_OPAQUE),
+        (["A"], False, 0, False, False, NARROW_UNOBSERVED),
+        (["A"], True, 0, False, False, NARROW_NO_SUBTYPE),
+        (["A"], True, 2, False, False, NARROW_OBSERVED),
+    ],
+)
+def test_narrowing_standing_never_shares_a_code_between_unobserved_and_nothing_to_narrow(
+    declared, run, n, tup, bare, want
+):
+    assert narrowing_standing(declared, run, n, tup, bare) == want
+    assert NARROW_UNOBSERVED != NARROW_NO_SUBTYPE
+
+
+# ── end to end: the test that alone pins the breadth is now necessary ───────────────────────────────
+
+
+def test_the_test_that_pins_a_handlers_breadth_kills_the_narrowing_and_is_necessary(
+    tmp_path, monkeypatch
+):
+    (tmp_path / "ngmod.py").write_text(_GUARD)
+    monkeypatch.syspath_prepend(str(tmp_path))
+    for name in ("ngmod", "ngtests"):
+        sys.modules.pop(name, None)
+    (tmp_path / "ngtests.py").write_text(
+        "from ngmod import parse_guard\n\n\n"
+        "def test_a_number():\n    assert parse_guard('12') == 12\n\n\n"
+        "def test_syntax_like():\n    assert parse_guard('x') is None\n\n\n"
+        "def test_the_other_error():\n    assert parse_guard(None) is None\n"
+    )
+    mod = importlib.import_module("ngmod")
+    tests_mod = importlib.import_module("ngtests")
+    tests = []
+    for attr in sorted(a for a in vars(tests_mod) if a.startswith("test_")):
+        fn = getattr(tests_mod, attr)
+        fn.__qualname__ = f"ngtests.py::{attr}"
+        tests.append(fn)
+    node = _fn(_GUARD)
+    with observe_caught_exceptions(node, mod.parse_guard.__code__) as caught:
+        for t in tests:
+            t()
+    try:
+        res = run_function_profiling(
+            node,
+            "ngmod.py::parse_guard",
+            {MutationCategory.EXCEPTION},
+            tests,
+            mod.parse_guard,
+            scope_tests=False,
+            max_per_category=0,
+            observed_caught=caught,
+        )
+    finally:
+        for name in ("ngmod", "ngtests"):
+            sys.modules.pop(name, None)
+    killed = {r["dimension"]: r for r in res.killed_records}
+    survived = {r["dimension"] for r in res.survivor_records}
+    narrow = {d: r for d, r in killed.items() if d.startswith("EXCEPTION:narrow:")}
+    assert set(narrow) == {
+        "EXCEPTION:narrow:Exception->builtins:TypeError",
+        "EXCEPTION:narrow:Exception->builtins:ValueError",
+    }
+    assert not {d for d in survived if d.startswith("EXCEPTION:narrow:")}
+    # Each is killed by the test that raises the OTHER type, which the narrowed handler no longer
+    # catches: `except TypeError` lets the ValueError test's error escape, and the reverse. That test is
+    # what pins the handler's breadth, and it is necessary now.
+    assert narrow["EXCEPTION:narrow:Exception->builtins:TypeError"]["test"].endswith(
+        "test_syntax_like"
+    )
+    assert narrow["EXCEPTION:narrow:Exception->builtins:ValueError"]["test"].endswith(
+        "test_the_other_error"
+    )
