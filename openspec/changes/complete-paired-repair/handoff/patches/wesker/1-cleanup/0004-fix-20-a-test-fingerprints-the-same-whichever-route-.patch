+++ b/Wesker/trace_cache.py
@@ -86,6 +86,54 @@ def _sha(text: str) -> str:
     ).hexdigest()[:16]
 
 
+def canonical_test_identity(node_id: str, origin: str) -> str:
+    """The identity a test fingerprints under, the same whichever route collected it (#20, pure — pinned).
+
+    A test collected as a live pytest item carries its node id relative to the rootdir
+    (``tests/t.py::test_x``). The same test reached through a re-collection route (a file the run wrote
+    after the session collected) carries only its bare name (``test_x``). Both are the one test in the one
+    file, so a fingerprint that folds the id in as given keys the writing session's trace row apart from
+    every later session's: the next run missed the row its predecessor wrote. The identity is the test's
+    FILE (the real path ``origin``) and its member path inside it (everything after the first ``::`` of a
+    full id, the whole of a bare one, parametrization included). A test whose file is unknown keeps the id
+    it has. The same rule as ``Detective.verdict_cache.canonical_test_identity`` (Detective #100): two
+    caches answering one question must not disagree about which test it is.
+    """
+    if not origin:
+        return node_id
+    member = node_id.partition("::")[2] if "::" in node_id else node_id
+    return f"{origin}::{member}"
+
+
+def fixture_origin_scope(path: str, installed_roots: list[str]) -> str:
+    """Whether a fixture-definition file is part of the PROJECT or an installed package (#20, pure — pinned).
+
+    "installed"  under the interpreter's standard library or site-packages: pytest's own fixtures
+                 (``request``, ``tmp_path``) and distribution plugins. Their identity is already bound
+                 by the regime digest (pytest version, plugin versions), and a live item stamps them
+                 (``_pytest/python.py``) while a re-collected one stamps none, so folding the file into the
+                 test's fingerprint made one test hash two ways.
+    "project"    anywhere else: an edit to it can change what a test does, so it stays in the hash.
+    """
+    for root in installed_roots:
+        if root and (path == root or path.startswith(root.rstrip("/") + "/")):
+            return "installed"
+    return "project"
+
+
+def _installed_roots() -> list[str]:
+    """The real paths of the interpreter's standard library and site-packages directories (the accessor
+    for :func:`fixture_origin_scope`)."""
+    import sysconfig
+
+    paths = sysconfig.get_paths()
+    return [
+        os.path.realpath(paths[k])
+        for k in ("stdlib", "platstdlib", "purelib", "platlib")
+        if paths.get(k)
+    ]
+
+
 def test_fingerprint(fn: Callable[..., Any]) -> str:
     """A test's identity BY CONTENT — its source AND its parametrization, else its dotted name.
 
@@ -117,7 +165,11 @@ def test_fingerprint(fn: Callable[..., Any]) -> str:
     )
 
     real = callable_source(fn)
-    disc = callable_node_id(fn)
