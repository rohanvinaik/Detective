@@ -0,0 +1,257 @@
+"""Intent: a test fingerprints the same whichever route collected it, so a written test's trace row is reused (W#20).
+
+THE DEFECT (Detective #100's Wesker half). `trace_cache.test_fingerprint` folded in the test's id AS THE
+COLLECTING ROUTE SPELLED IT, and the files of every fixture the item uses. A test a run wrote after the
+session collected is re-collected as a bare name (`test_x`) in one session and a full node id
+(`tests/t.py::test_x`) in the next; and a live item stamps pytest's own `_pytest/python.py` as a fixture
+file while a re-collected one stamps none. The same test hashed two ways, so the row the writing session
+stored was never found by the next one.
+
+THE FIX. The id is canonicalised to the test's file and member path (`canonical_test_identity`), and a
+fixture file under the interpreter's standard library or site-packages is left out
+(`fixture_origin_scope`: the regime digest already binds installed versions), while the project's own
+conftest and fixture files stay in, so editing one still invalidates the row. Same rules as
+`Detective.verdict_cache` (Detective #100).
+"""
+
+from __future__ import annotations
+
+import importlib.util
+import json
+import os
+import subprocess
+import sys
+import textwrap
+
+import pytest
+
+from Wesker import trace_cache
+from Wesker.trace_cache import (
+    _installed_roots,
+    canonical_test_identity,
+    fixture_origin_scope,
+)
+
+# ── the pure decisions ───────────────────────────────────────────────────────────────────────
+
+
+@pytest.mark.parametrize(
+    ("node_id", "origin", "identity"),
+    [
+        ("tests/t.py::test_x", "/p/tests/t.py", "/p/tests/t.py::test_x"),
+        (
+            "test_x",
+            "/p/tests/t.py",
+            "/p/tests/t.py::test_x",
+        ),  # bare, the re-collected spelling
+        (
+            "tests/t.py::test_x[a-1]",
+            "/p/tests/t.py",
+            "/p/tests/t.py::test_x[a-1]",
+        ),  # a parametrized case keeps its case
+        (
+            "tests/t.py::TestK::test_m[1]",
+            "/p/tests/t.py",
+            "/p/tests/t.py::TestK::test_m[1]",
+        ),
+        ("test_x[a-1]", "/p/tests/t.py", "/p/tests/t.py::test_x[a-1]"),
+        ("tests/t.py::test_x", "", "tests/t.py::test_x"),  # file unknown: the id it has
+        ("test_x", "", "test_x"),
+        ("", "/p/t.py", "/p/t.py::"),
+    ],
+)
+def test_canonical_identity(node_id, origin, identity):
+    assert canonical_test_identity(node_id, origin) == identity
+
+
+def test_both_spellings_of_one_test_have_one_identity():
+    origin = "/p/tests/t.py"
+    assert canonical_test_identity(
+        "tests/t.py::test_x", origin
+    ) == canonical_test_identity("test_x", origin)
+    assert canonical_test_identity(
+        "tests/t.py::test_x", origin
+    ) != canonical_test_identity("tests/t.py::test_y", origin)
+
+
+@pytest.mark.parametrize(
+    ("path", "roots", "scope"),
+    [
+        (
+            "/venv/lib/site-packages/_pytest/python.py",
+            ["/venv/lib/site-packages"],
+            "installed",
+        ),
+        ("/venv/lib/site-packages", ["/venv/lib/site-packages"], "installed"),
+        ("/usr/lib/python3.14/x.py", ["/usr/lib/python3.14"], "installed"),
+        ("/p/tests/conftest.py", ["/venv/lib/site-packages"], "project"),
+        # a sibling directory that merely shares the prefix is not inside the root
+        ("/venv/lib/site-packages-extra/c.py", ["/venv/lib/site-packages"], "project"),
+        ("/p/conftest.py", [], "project"),
+        ("/p/conftest.py", [""], "project"),  # an empty root names nothing
+        (
+            "/venv/lib/site-packages/a.py",
+            ["/other", "/venv/lib/site-packages/"],
+            "installed",
+        ),
+    ],
+)
+def test_fixture_origin_scope(path, roots, scope):
+    assert fixture_origin_scope(path, roots) == scope
+
+
+# ── the same test, collected two ways ────────────────────────────────────────────────────────
+
+_CONFTEST = textwrap.dedent(
+    """\
+    import pytest
+
+
+    @pytest.fixture
+    def project_fixture():
+        return 1
+    """
+)
+_TEST = textwrap.dedent(
+    """\
+    import pytest
+
+
+    def test_plain(tmp_path, project_fixture):
+        assert project_fixture == 1
+
+
+    @pytest.mark.parametrize("n", [1, 2])
+    def test_case(n):
+        assert n
+
+
+    def test_other():
+        assert True
+    """
+)
+
+
+@pytest.fixture
+def project(tmp_path):
+    (tmp_path / "tests").mkdir()
+    (tmp_path / "tests" / "conftest.py").write_text(_CONFTEST)
+    (tmp_path / "tests" / "test_w.py").write_text(_TEST)
+    (tmp_path / "pytest.ini").write_text("[pytest]\ntestpaths = tests\n")
+    return tmp_path
+
+
+_LIVE = textwrap.dedent(
+    """\
+    import json, os, sys
+    from Wesker.ci import callable_fixture_origins
+    from Wesker.pytest_runner import run_in_session
+    from Wesker import trace_cache
+
+    def body(callables, _ctx):
+        return {
+            c.__qualname__: [
+                trace_cache.test_fingerprint(c),
+                list(callable_fixture_origins(c)),
+            ]
+            for c in callables
+        }
+
+    print(json.dumps(run_in_session(os.getcwd(), body, paths=["tests/test_w.py"])))
+    """
+)
+
+
+def _live(root) -> dict:
+    """The suite as LIVE pytest items, in a session of its own (what a run that collected the file
+    sees): `{node id: [fingerprint, fixture origin files]}`."""
+    env = {k: v for k, v in os.environ.items() if k != "PYTHONUNBUFFERED"}
+    env["PYTHONPATH"] = os.pathsep.join(sys.path)
+    done = subprocess.run(
+        [sys.executable, "-c", _LIVE],
+        cwd=root,
+        env=env,
+        capture_output=True,
+        text=True,
+        timeout=120,
+        check=False,
+    )
+    assert done.returncode == 0, done.stderr[-1500:]
+    return json.loads(done.stdout.strip().splitlines()[-1])
+
+
+def _fp(root, node_id: str) -> str:
+    return _live(root)[node_id][0]
+
+
+def _recollected(root, name: str):
+    """The same test reached by the re-collection route: the module function itself, a bare name, no
+    fixture closure stamped."""
+    path = root / "tests" / "test_w.py"
+    spec = importlib.util.spec_from_file_location("recollected_w", str(path))
+    mod = importlib.util.module_from_spec(spec)
+    sys.modules["recollected_w"] = mod
+    try:
+        spec.loader.exec_module(mod)
+    finally:
+        sys.modules.pop("recollected_w", None)
+    return getattr(mod, name)
+
+
+def test_a_live_item_and_the_same_test_re_collected_fingerprint_the_same(project):
+    live = _live(project)
+    fingerprint, origins = live["tests/test_w.py::test_plain"]
+    roots = _installed_roots()
+    assert any(
+        fixture_origin_scope(os.path.realpath(p), roots) == "installed" for p in origins
+    ), (
+        "the premise: a live item stamps pytest's own fixture files, which a re-collected one does not"
+    )
+    assert any(p.endswith("conftest.py") for p in origins)
+    plain = _recollected(project, "test_plain")
+    assert plain.__qualname__ == "test_plain", "the bare spelling"
+    assert fingerprint == trace_cache.test_fingerprint(plain)
+
+
+def test_the_identity_is_the_file_and_member_not_the_spelling(project):
+    twin = _recollected(project, "test_other")
+    assert _fp(project, "tests/test_w.py::test_other") == trace_cache.test_fingerprint(
+        twin
+    )
+
+
+def test_distinct_tests_and_sibling_cases_still_fingerprint_apart(project):
+    fps = {k: v[0] for k, v in _live(project).items()}
+    assert len(set(fps.values())) == len(fps) == 4, fps
+    one = [k for k in fps if k.endswith("test_case[1]")]
+    two = [k for k in fps if k.endswith("test_case[2]")]
+    assert one and two and fps[one[0]] != fps[two[0]]
+
+
+def test_editing_the_test_still_changes_the_fingerprint(project):
+    before = _fp(project, "tests/test_w.py::test_other")
+    path = project / "tests" / "test_w.py"
+    path.write_text(
+        _TEST.replace(
+            "def test_other():\n    assert True", "def test_other():\n    assert 1"
+        )
+    )
+    after = _fp(project, "tests/test_w.py::test_other")
+    assert before != after
+
+
+def test_editing_a_project_conftest_still_changes_a_live_items_fingerprint(project):
+    before = _fp(project, "tests/test_w.py::test_plain")
+    conftest = project / "tests" / "conftest.py"
+    conftest.write_text(_CONFTEST.replace("return 1", "return 2"))
+    after = _fp(project, "tests/test_w.py::test_plain")
+    assert before != after, "a project fixture is still part of the identity"
+
+
+def test_a_test_in_an_unknown_file_keeps_its_own_id():
+    def test_loose():  # no readable origin beyond this file; fingerprint must not raise
+        return None
+
+    assert trace_cache.test_fingerprint(test_loose) == trace_cache.test_fingerprint(
+        test_loose
+    )
