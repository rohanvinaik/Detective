@@ -0,0 +1,277 @@
+"""Intent: a cycle through a thread the code under test started is refused by name, not waited into (W#28).
+
+THE DEFECT (issue #28, open item). `interrupt.starter_chain()` was empty for any thread that was not a
+`JoinedWorker`, so the nested-acquire refusal could not see a wait-for cycle routed through a thread the
+code under test starts: a test that starts a plain `threading.Thread`, runs the engine in it, and joins
+it. The thread waits on the execution lock the measuring thread holds; the measuring thread waits on the
+test's worker; the worker waits on the thread. Without the edge the refusal never fires, and the
+measurement waits out its allowance and reports a false uncontained timeout.
+
+THE FIX. While a measurement worker runs, `Thread.start` records the starting thread on the new thread
+(`interrupt.record_thread_starts`); `starter_of` reads it and `starter_chain` / `mark_refusal` follow it.
+Nothing is patched outside a measurement.
+
+Each schedule is forced by construction (the test joins its thread; the outer evaluation holds the lock by
+definition), not by sleeps.
+"""
+
+from __future__ import annotations
+
+import ast
+import importlib.util
+import sys
+import threading
+import time
+
+import pytest
+
+from Wesker import interrupt
+from Wesker.engine import (
+    SCORED_DISPOSITIONS,
+    evaluate_mutant,
+    generate_mutants,
+    mutant_disposition,
+)
+from Wesker.filter import filter_categories
+from Wesker.interrupt import (
+    JoinedWorker,
+    mark_refusal,
+    record_thread_starts,
+    starter_chain,
+    starter_of,
+)
+
+_SRC = "def compute(n):\n    return n * 2\n"
+
+
+@pytest.fixture
+def target(tmp_path):
+    path = tmp_path / "starter_mod.py"
+    path.write_text(_SRC)
+    spec = importlib.util.spec_from_file_location("starter_mod", str(path))
+    mod = importlib.util.module_from_spec(spec)
+    sys.modules["starter_mod"] = mod
+    spec.loader.exec_module(mod)
+    try:
+        yield mod, str(path)
+    finally:
+        sys.modules.pop("starter_mod", None)
+
+
+def _mutants():
+    node = ast.parse(_SRC).body[0]
+    return generate_mutants(
+        node, filter_categories(node, True), max_per_category=0, pass_index=0
+    )
+
+
+def _engine_in_a_thread_test(mod, path, seen: dict):
+    """A test that runs the engine in a plain thread it starts and joins."""
+    inner = _mutants()[1]
+
+    def plain():
+        assert mod.compute(2) == 4
+
+    def nested() -> None:
+        try:
+            evaluate_mutant(
+                inner, [plain], mod.compute, qualname="compute", source_path=path
+            )
+            seen["nested"] = "ran"
+        # BLE001: the thing under test is whatever the nested engine does, including refusing
+        except BaseException as exc:  # noqa: BLE001
+            seen["nested"] = type(exc).__name__
+
+    def test_runs_the_engine_in_a_thread():
+        t = threading.Thread(target=nested)
+        t.start()
+        t.join(30)
+        assert mod.compute(1) == 2
+
+    return test_runs_the_engine_in_a_thread
+
+
+# ── the cycle through a thread the test started ──────────────────────────────────────────────
+
+
+def test_a_cycle_through_a_thread_the_test_started_is_refused_by_name_not_waited_into(
+    target,
+):
+    """Before: the nested acquire waited on the holder while the holder waited on the worker, which
+    waited on the thread: the measurement ran out its allowance (here 5 s) and was scored a false
+    uncontained timeout. Now: refused at once, by name, neither killed nor survived."""
+    mod, path = target
+    seen: dict = {}
+    started = time.monotonic()
+    result = evaluate_mutant(
+        _mutants()[0],
+        [_engine_in_a_thread_test(mod, path, seen)],
+        mod.compute,
+        timeout_ms=5000,
+        qualname="compute",
+        source_path=path,
+    )
+    took = time.monotonic() - started
+    assert took < 4.0, (
+        f"the refusal waited {took:.1f}s: it fired by timeout, not by name"
+    )
+    assert seen["nested"] == "MeasurementRefused"
+    assert result.killed is False and result.killed_by is None
+    assert result.contained is True
+    assert result.refusal == "nested_measurement"
+    assert result.refused_test and result.refused_test.endswith(
+        "test_runs_the_engine_in_a_thread"
+    )
+    disposition = mutant_disposition(
+        result.constructed,
+        result.installed,
+        result.entered,
+        True,
+        result.killed,
+        result.refusal,
+    )
+    assert disposition == "nested_measurement"
+    assert disposition not in SCORED_DISPOSITIONS
+    assert not [t for t in threading.enumerate() if isinstance(t, JoinedWorker)]
+
+
+def test_nothing_is_patched_before_during_or_after_outside_a_measurement(target):
+    original = interrupt._ORIGINAL_START
+    assert threading.Thread.start is original
+    seen: dict = {}
+
+    def probe() -> None:
+        seen["inside"] = threading.Thread.start is not original
+
+    worker = JoinedWorker(target=probe)
+    worker.start()
+    worker.join(30)
+    assert seen["inside"] is True, "starts are recorded while a measurement worker runs"
+    assert threading.Thread.start is original, "and restored when the last one ends"
+    assert not interrupt._RECORDING
+
+
+def test_the_wrapper_survives_nesting_and_is_removed_by_the_last_exit():
+    original = interrupt._ORIGINAL_START
+    with record_thread_starts():
+        with record_thread_starts():
+            assert threading.Thread.start is not original
+        assert threading.Thread.start is not original, "the inner exit must not unpatch"
+    assert threading.Thread.start is original
+
+
+def test_the_wrapper_is_removed_when_the_block_raises():
+    with pytest.raises(RuntimeError), record_thread_starts():
+        raise RuntimeError("boom")
+    assert threading.Thread.start is interrupt._ORIGINAL_START
+    assert not interrupt._RECORDING
+
+
+# ── the edge ─────────────────────────────────────────────────────────────────────────────────
+
+
+def test_a_thread_started_by_a_measurement_worker_names_that_worker_its_starter():
+    seen: dict = {}
+
+    def leaf() -> None:
+        seen["chain"] = starter_chain()
+        seen["starter"] = starter_of(threading.current_thread())
+
+    def middle() -> None:
+        t = threading.Thread(target=leaf)
+        t.start()
+        t.join(30)
+        seen["worker"] = threading.current_thread()
+
+    worker = JoinedWorker(target=middle)
+    worker.start()
+    worker.join(30)
+    assert seen["starter"] is seen["worker"] is worker
+    assert seen["chain"] == (worker.ident, threading.get_ident())
+
+
+def test_a_thread_started_outside_any_measurement_has_no_starter_and_an_empty_chain():
+    seen: dict = {}
+
+    def leaf() -> None:
+        seen["chain"] = starter_chain()
+        seen["starter"] = starter_of(threading.current_thread())
+
+    t = threading.Thread(target=leaf)
+    t.start()
+    t.join(30)
+    assert seen["starter"] is None, "not seen is not 'none': nothing was recorded"
+    assert seen["chain"] == ()
+    assert starter_of(threading.main_thread()) is None
+
+
+def test_a_dead_starter_ends_the_chain_through_a_plain_thread_too():
+    go = threading.Event()
+    seen: dict = {}
+
+    def leaf() -> None:
+        go.wait(30)
+        seen["chain"] = starter_chain()
+
+    holder: dict = {}
+
+    def short_lived() -> None:
+        holder["t"] = threading.Thread(target=leaf)
+        holder["t"].start()
+
+    worker = JoinedWorker(target=short_lived)
+    worker.start()
+    worker.join(30)
+    go.set()
+    holder["t"].join(30)
+    assert seen["chain"] == (), (
+        "a finished starter waits on nothing; its ident may be someone else's"
+    )
+
+
+def test_the_refusal_is_recorded_on_the_worker_above_a_plain_thread():
+    """The plain thread has no record of its own; the worker that started it learns the refusal, and a
+    worker at or above the owner does not."""
+    seen: dict = {}
+    me: list[int] = []
+
+    def leaf() -> None:
+        mark_refusal("nested_measurement", me[0])
+
+    def middle() -> None:
+        t = threading.Thread(target=leaf)
+        t.start()
+        t.join(30)
+
+    def top_body() -> None:
+        me.append(threading.get_ident())
+        inner = JoinedWorker(target=middle)
+        inner.start()
+        inner.join(30)
+        seen["inner"] = inner.refusal
+
+    top = JoinedWorker(target=top_body)
+    top.start()
+    top.join(30)
+    assert seen["inner"] == "nested_measurement"
+    assert top.refusal == "", (
+        "the owner itself, and anything above it, was never part of the cycle"
+    )
+
+
+def test_joined_worker_chains_are_unchanged():
+    seen: dict = {}
+
+    def leaf() -> None:
+        seen["chain"] = starter_chain()
+
+    def middle() -> None:
+        inner = JoinedWorker(target=leaf)
+        inner.start()
+        inner.join(30)
+
+    mid = JoinedWorker(target=middle)
+    mid.start()
+    mid.join(30)
+    assert seen["chain"] == (mid.ident, threading.get_ident())
+    assert starter_chain() == ()
