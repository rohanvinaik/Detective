+# Workers currently running a measurement: while any is, `threading.Thread.start` records its starter.
+_RECORDING: list[object] = []
+_ORIGINAL_START = threading.Thread.start
+_STARTER_ATTR = "_wesker_starter"
+
+
+def _recording_start(self: threading.Thread) -> None:
+    """``Thread.start``, after noting which thread started this one (#28)."""
+    vars(self).setdefault(_STARTER_ATTR, threading.current_thread())
+    _ORIGINAL_START(self)
+
+
+@contextlib.contextmanager
+def record_thread_starts() -> Iterator[None]:
+    """For the length of the block, every thread started anywhere in the process records its starter (#28).
+
+    The start/join edge of a :class:`JoinedWorker` is known because the pair builds those; a thread the
+    code under test starts is built by code the pair does not own. Wrapping ``Thread.start`` for the span
+    of a measurement is the one way to see that edge, and the wrapper only adds a dict entry before the
+    original runs. Re-entrant by counting (workers nest), idempotent (the wrapper is assigned, never
+    stacked), and removed when the last block ends, so nothing outside a measurement is patched. The
+    counter is a list (append / remove are single bytecodes) because a lock taken here could be stranded
+    by an injected :class:`Abandoned` (the STRANDED LOCK above).
+    """
+    token = object()
+    _RECORDING.append(token)
+    threading.Thread.start = _recording_start  # type: ignore[method-assign]
+    try:
+        yield
+    finally:
+        _RECORDING.remove(token)
+        if not _RECORDING:
+            threading.Thread.start = _ORIGINAL_START  # type: ignore[method-assign]
+
+
+def starter_of(thread: threading.Thread) -> threading.Thread | None:
+    """The thread that started ``thread``, when the pair saw it start; None otherwise (#28).
+
+    A :class:`JoinedWorker` carries it as ``starter``; any other thread started while a measurement ran
+    carries the one :func:`record_thread_starts` noted. None is "not seen", never "none": the main
+    thread and a thread started before any measurement began are in this class.
+    """
+    if isinstance(thread, JoinedWorker):
+        return thread.starter
+    return vars(thread).get(_STARTER_ATTR)
+
+
