+@linux_only
+def test_a_runaway_thread_is_stopped_with_memory_error_and_stays_near_the_cap():
+    out: dict = {}
+    t = threading.Thread(target=_alloc_until_stopped, args=(out, 4))
+    with MemoryWatchdog(64 * _MB, lambda: [t.ident]) as dog:
+        t.start()
+        t.join(30)
+    assert not t.is_alive()
+    assert dog.hit is True
+    assert out["result"] == "stopped"
+    # 4 MB steps every ~1 ms against a 20 ms poll: it overshoots the cap by what it allocates in a
+    # poll period, not by an unbounded amount (400 steps would be 1600 MB).
+    assert 64 <= out["held_mb"] < 600, out
