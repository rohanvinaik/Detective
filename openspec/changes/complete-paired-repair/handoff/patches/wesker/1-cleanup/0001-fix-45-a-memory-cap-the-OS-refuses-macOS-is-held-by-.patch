+@linux_only
+def test_polling_costs_next_to_nothing():
+    """One read of resident memory, 50 times a second. Measured here; the figure is in the commit."""
+    reads = 400
+    t0 = time.perf_counter()
+    for _ in range(reads):
+        assert current_rss_bytes() > 0
+    per_read = (time.perf_counter() - t0) / reads
+    duty = per_read / WATCHDOG_PERIOD_S
+    assert duty < 0.01, f"{per_read * 1e6:.0f} us a read is {duty:.2%} of a core"
+
+    def spin(n: int) -> float:
+        t = time.perf_counter()
+        x = 0
+        for i in range(n):
+            x += i * i
+        return time.perf_counter() - t
+
+    spin(200_000)
+    bare = min(spin(2_000_000) for _ in range(3))
+    with MemoryWatchdog(1 << 40, list):
+        watched = min(spin(2_000_000) for _ in range(3))
+    assert watched < bare * 1.25, f"{bare:.3f}s bare, {watched:.3f}s watched"
