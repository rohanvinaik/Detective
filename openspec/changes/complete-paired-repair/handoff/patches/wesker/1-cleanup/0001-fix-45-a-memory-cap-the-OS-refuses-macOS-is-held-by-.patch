+def _alloc_until_stopped(out: dict, step_mb: int, limit_steps: int = 400) -> None:
+    hog = []
+    try:
+        for _ in range(limit_steps):
+            hog.append(bytearray(step_mb * _MB))
+            time.sleep(0.001)
+        out["result"] = "finished"
+    except MemoryError:
+        out["result"] = "stopped"
+    out["held_mb"] = len(hog) * step_mb
+
