+def _describe_in_process_bound(code: str, bound: object) -> str:
+    """The memory line for a run that was not isolated, when its in-process bound was recorded (#45).
+
+    Without ``--isolated`` there is no worker cap, but since W#29 a mutant is still run under the run's
+    own memory budget: by ``RLIMIT_AS`` where the OS accepts it, else by the resident-memory watchdog.
+    Saying "NOT bounded" of that run would be false. "" when the run was isolated or recorded no bound,
+    so the older lines stand.
+    """
+    if code not in ("unbounded", "limit_ignored") or bound not in (
+        "rlimit",
+        "watchdog",
+    ):
+        return ""
+    how = (
+        "RLIMIT_AS (the allocation itself fails)"
+        if bound == "rlimit"
+        else "the resident-memory watchdog (the OS refused RLIMIT_AS; a mutant whose memory outgrows "
+        "the budget is stopped at its next bytecode)"
+    )
+    ignored = (
+        " --mem-limit-mb takes effect only with --isolated and was not applied."
+        if code == "limit_ignored"
+        else ""
+    )
+    return (
+        f"Memory: bounded in-process by {how} under the run's memory budget "
+        "(WESKER_MEM_BUDGET_MB). A mutant over it is a named cut, never a kill."
+        + ignored
+        + " `--isolated --mem-limit-mb N` is the per-mutant worker bound."
+    )
+
+
+def _describe_watchdog_bound(code: str, bound: str, mb: int, refused: int) -> str:
+    """The memory line when the resident-memory watchdog held for some or all functions (#45)."""
+    watchdog = (
+        f"the OS refused RLIMIT_AS, so a watchdog polls each isolated worker's resident memory and "
+        f"stops a mutant whose memory grows past {mb} MB at its next bytecode"
+    )
+    if code == "partial":
+        return (
+            f"Memory: a {mb} MB cap was bounded for some functions ({watchdog}; a single allocation "
+            f"that never returns to the interpreter is stopped only when it does) and NOT applied for "
+            f"{refused}: those functions' memory was observed, not bounded."
+        )
+    mixed = (
+        " Some functions were held by RLIMIT_AS and some by the watchdog."
+        if bound == "mixed"
+        else ""
+    )
+    return (
+        f"Memory: bounded at {mb} MB per isolated worker; {watchdog}. A mutant over the cap is a "
+        "named cut, never a kill. A single allocation that never returns to the interpreter is "
+        "stopped only when it does." + mixed
+    )
