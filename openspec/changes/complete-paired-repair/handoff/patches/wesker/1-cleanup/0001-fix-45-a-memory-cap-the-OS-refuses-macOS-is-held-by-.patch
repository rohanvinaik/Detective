+"""Intent: a memory bound that holds where the OS refuses RLIMIT_AS, and says which bound it is (W#45, W#39).
+
+THE DEFECT. `--mem-limit-mb` is `setrlimit(RLIMIT_AS)`. macOS refuses to lower that limit, so there the
+cap was never applied: the run reported `memory_standing: telemetry_only` and nothing stopped a mutant
+that allocates without bound. Issue #39's own shape, `take` over an infinite generator
+(`list(islice(seq, n))` mutated to `list(seq)`), measured on the founder's machine at 3.94 GB before the
+kernel killed it. Linux interception was measured and works (`memory_cut`); the portable half was missing.
+
+THE FIX. Which bound holds is a pure decision (`memory_bound_standing`): `rlimit` where the OS accepted
+the cap (primary, since it fails the allocation itself, and resident memory cannot exceed the address
+space that holds it, so a watchdog beside it could only fire second), `watchdog` where it did not but
+the platform can read current resident memory, `none` otherwise. The watchdog polls the process's own
+resident memory every 20 ms and raises `MemoryError` in the thread running the mutant: the exception the
+OS cap would have produced, so the disposition is the same `memory_cut` (never a kill). The standing, the
+rollup and the CLI page carry which bound acted.
+
+The macOS refusal is simulated on Linux the way the OS does it: `resource.setrlimit` RAISES for
+`RLIMIT_AS` (a `sitecustomize` does it in every process of a subprocess run, so the isolated worker sees
+it too).
+"""
+
+from __future__ import annotations
+
+import json
+import os
+import resource
+import subprocess
+import sys
+import textwrap
+import threading
+import time
+
+import pytest
+
+from Wesker.ci import describe_memory, memory_rollup_bound
+from Wesker.engine import MEMORY_CUT, _mutant_thread_idents
+from Wesker.interrupt import JoinedWorker
+from Wesker.memory_guard import (
+    WATCHDOG_PERIOD_S,
+    MemoryWatchdog,
+    current_rss_bytes,
+    memory_bound_standing,
+    merge_memory_bound,
+    watchdog_standing,
+)
+
+linux_only = pytest.mark.skipif(
+    sys.platform != "linux", reason="the macOS refusal is simulated on Linux"
+)
+
+_MB = 1024 * 1024
+
+# ── the pure decisions ───────────────────────────────────────────────────────────────────────
+
+
+@pytest.mark.parametrize(
+    ("requested", "rlimit", "readable", "bound"),
+    [
+        (False, False, False, "none"),
+        (False, True, True, "none"),  # no cap asked: nothing is bounded, whatever works
+        (False, False, True, "none"),
+        (True, True, True, "rlimit"),  # primary even when the watchdog could also run
+        (True, True, False, "rlimit"),
+        (True, False, True, "watchdog"),  # the macOS case
+        (True, False, False, "none"),  # asked, refused, and nothing can read memory
+    ],
+)
