+        ("none", "none", "none"),
+        ("none", "watchdog", "watchdog"),
+        ("watchdog", "none", "watchdog"),
+        ("watchdog", "rlimit", "rlimit"),
+        ("rlimit", "watchdog", "rlimit"),
+        ("rlimit", "none", "rlimit"),
+        ("none", "garbage", "none"),  # an unknown word never displaces a known one
+        ("garbage", "none", "none"),
+    ],
