+def memory_rollup_bound(bounds: list[str]) -> str:
+    """Which bound held memory on this run, as one named code (#45, pure — pinned).
+
+    ``bounds`` is each function's own ``memory_bound`` (``rlimit``, ``watchdog``, ``none``, or ``n/a``
+    where it ran no measurement; an ``n/a`` says nothing and is not counted). The codes never share a
+    sign: "no function reported" and "functions reported that nothing bounded them" are different facts.
+
+      "not_recorded"  no function recorded a bound (a report from before this was written, or nothing ran)
+      "rlimit"        every recorded function was bounded by the OS's address-space cap
+      "watchdog"      every recorded function was bounded by the resident-memory watchdog (the OS
+                      refused the address-space cap)
+      "none"          every recorded function ran with nothing bounding its memory
+      "mixed"         the recorded functions were not all held the same way
+    """
+    seen = {b for b in bounds if b in ("rlimit", "watchdog", "none")}
+    if not seen:
+        return "not_recorded"
+    return seen.pop() if len(seen) == 1 else "mixed"
+
