+# ── the commands, measured with the OS refusing RLIMIT_AS ───────────────────────────────────
+
+_REFUSE = textwrap.dedent(
+    """\
+    import resource
+    _real = resource.setrlimit
+    def _refuse(which, limits):
+        if which == resource.RLIMIT_AS:
+            raise ValueError("current limit exceeds maximum limit")  # macOS
+        return _real(which, limits)
+    resource.setrlimit = _refuse
+    """
+)
+
+_SPAN = textwrap.dedent(
+    """\
+    def span(hi, lo):
+        out = []
+        for _ in range(hi - lo):
+            out.append(bytearray(1024 * 1024))
+        return len(out)
+    """
+)
+_SWALLOW = textwrap.dedent(
+    """\
+    def span(hi, lo):
+        try:
+            out = []
+            for _ in range(hi - lo):
+                out.append(bytearray(1024 * 1024))
+            return len(out)
+        except Exception:
+            return -1
+    """
+)
+_SPAN_TEST = textwrap.dedent(
+    """\
+    from span import span
+
+
+    def test_span():
+        assert span(300_000_010, 300_000_000) == 10
+        assert span(7, 7) == 0
+    """
+)
+
+# Issue #39's own shape: `take` over an infinite generator; one mutation drops the island bound.
+_ITERTOOLZ = textwrap.dedent(
+    """\
+    from itertools import islice
+
+
+    def iterate(f, x):
+        while True:
+            yield x
+            x = f(x)
+
+
+    def double(x):
+        return 2 * x
+
+
+    def take(n, seq):
+        return list(islice(seq, n))
+    """
+)
+_ITERTOOLZ_TEST = textwrap.dedent(
+    """\
+    from itertoolz import double, iterate, take
+
+
+    def test_take():
+        assert take(4, iterate(double, 1)) == [1, 2, 4, 8]
+        assert take(0, iterate(double, 1)) == []
+    """
+)
+
+_DRIVER = textwrap.dedent(
+    """\
+    import resource, sys
+    from Wesker import cli
+    rc = cli.main({argv})
+    sys.stderr.write("PEAK_MB %d\\n" % (resource.getrusage(resource.RUSAGE_SELF).ru_maxrss // 1024))
+    sys.stderr.write("CHILD_PEAK_MB %d\\n" % (resource.getrusage(resource.RUSAGE_CHILDREN).ru_maxrss // 1024))
+    sys.exit(rc)
+    """
+)
+
+
+def _outer_cap() -> None:
+    resource.setrlimit(resource.RLIMIT_AS, (4000 * _MB, 4000 * _MB))
+
+
+def _project(tmp_path, files: dict[str, str]) -> None:
+    (tmp_path / "tests").mkdir()
+    for name, text in files.items():
+        (tmp_path / name).write_text(text)
+    (tmp_path / "pytest.ini").write_text(
+        "[pytest]\ntestpaths = tests\npythonpath = .\n"
+    )
+
+
+def _run(tmp_path, argv: list[str], *, refuse: bool, budget_mb: str | None = None):
+    """The real command in a subprocess; the refusal, when asked for, is installed in EVERY process of
+    the run (a `sitecustomize`), so the isolated worker meets it too."""
+    shim = tmp_path / "_shim"
+    shim.mkdir(exist_ok=True)
+    (shim / "sitecustomize.py").write_text(_REFUSE if refuse else "")
+    env = {k: v for k, v in os.environ.items() if k != "PYTHONUNBUFFERED"}
+    env.update(
+        HOME=str(tmp_path),
+        PYTHONPATH=os.pathsep.join([str(shim), *sys.path]),
+    )
+    if budget_mb is not None:
+        env["WESKER_MEM_BUDGET_MB"] = budget_mb
+    driver = _DRIVER.format(argv=repr(argv))
+    done = subprocess.run(
+        [sys.executable, "-c", driver],
+        cwd=tmp_path,
+        env=env,
+        capture_output=True,
+        text=True,
+        timeout=280,
+        check=False,
+        # an outer limit set before Python starts (the refusal cannot see it), so a failed bound
+        # cannot take the machine with it
+        preexec_fn=_outer_cap,
+    )
+    assert done.returncode == 0, done.stderr[-2000:]
+    peaks = {
+        key: int(done.stderr.rsplit(key, 1)[1].split()[0])
+        for key in ("PEAK_MB", "CHILD_PEAK_MB")
+    }
+    return json.loads(done.stdout)["mutation"], peaks, done.stdout
+
+
+def _named(mutation) -> dict:
+    return {u["function_key"]: u for u in mutation["unresolved_functions"]}
