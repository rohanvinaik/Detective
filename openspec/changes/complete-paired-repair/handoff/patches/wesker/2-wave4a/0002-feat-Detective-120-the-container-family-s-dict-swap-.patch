@@ -0,0 +1,264 @@
+"""μ⁻ container family: the dict key/value swap and ctype to and from a set (Detective #120, Wesker #44).
+
+Intent tests authored from docs/theory/NEGATIVE_SPECIFICATION.md, Def. 11.8 (v) and Def. 11.10.
+
+THE DEFECT (Detective #120). Two operators of the container family were not generated.
+- ``dict``: the key/value swap. It raises on an unhashable value, so it was "not total on dict".
+- ``ctype``: list, tuple and set conversion. list -> set raises on an unhashable element, and
+  set -> list has no deterministic order, so only list <-> tuple and set <-> frozenset were built.
+Both reasons are facts about the VALUES a function returns, which the baseline run observes. Fork 2
+(Def. 11.10) generates a perturbation only where the observed codomain guarantees it applies.
+
+WHAT MUST HOLD.
+- The swap is generated at a return site only where every dict returned there had hashable values; a
+  to-set conversion only where every list or tuple had hashable elements; a from-set conversion only
+  where every set had mutually orderable elements and so has one deterministic order (sorted).
+- Where the premise failed on an observed value the operator is NOT generated and the function's
+  profile says which and why (the exception type the attempt raised), never silently.
+- An operator never raises on a value it was generated for, and a value the baseline never saw comes
+  back unchanged rather than as a crash kill.
+- Each changes some value it claims, and is killed by a test that pins the output, by assertion.
+"""
+
+from __future__ import annotations
+
+import pytest
+from _mu_support import load, mode_lines, observe, one, run, unload
+
+from Wesker.codomain import parse_codomain, withheld_here
+from Wesker.mu_minus import apply_value_mode, candidate_modes, perturb_return
+
+_SRC = """
+def tally(words):
+    out = {}
+    for w in words:
+        out[w] = out.get(w, 0) + 1
+    return out
+
+
+def listing(n):
+    return [i for i in range(n)]
+
+
+def labels(n):
+    return {f"k{i}" for i in range(n)}
+
+
+def frozen_labels(n):
+    return frozenset(range(n))
+
+
+def nested(n):
+    return {"k": [n]}
+
+
+def rows(n):
+    return [[i] for i in range(n)]
+
+
+def mixed_set(n):
+    return {n, str(n)}
+
+
+def empty_dict(n):
+    return {}
+"""
+
+
+@pytest.fixture(scope="module")
+def target(tmp_path_factory):
+    module, path = load(tmp_path_factory.mktemp("mu_container"), "mu_container_t", _SRC)
+    yield module, path
+    unload("mu_container_t")
+
+
+def _modes(path, name, observed):
+    return {mode for mode, _line in mode_lines(path, name, observed)}
+
+
+def test_the_swap_is_generated_where_every_observed_value_is_hashable(target):
+    module, path = target
+
+    def t():
+        assert module.tally(["a", "b", "a"]) == {"a": 2, "b": 1}
+
+    observed = observe(module, path, "tally", [t])
+    assert "return_swap_items" in _modes(path, "tally", observed)
+    assert any(tok.endswith("!ok=return_swap_items") for tok in observed)
+
+
+def test_the_swap_is_not_generated_where_a_value_is_unhashable_and_the_function_says_so(
+    target,
+):
+    module, path = target
+
+    def t():
+        assert module.nested(1) == {"k": [1]}
+
+    observed = observe(module, path, "nested", [t])
+    assert "return_swap_items" not in _modes(path, "nested", observed)
+    named = withheld_here(parse_codomain(observed))
+    assert any("return_swap_items" in line and "TypeError" in line for line in named), (
+        named
+    )
+
+
+def test_a_dict_that_the_swap_cannot_change_is_named_not_generated(target):
+    # An empty dict swaps to itself: the mutant would be a built-in survivor at every input.
+    module, path = target
+
+    def t():
+        assert module.empty_dict(1) == {}
+
+    observed = observe(module, path, "empty_dict", [t])
+    assert "return_swap_items" not in _modes(path, "empty_dict", observed)
+    assert any(
+        "return_swap_items" in line and "no_effect_observed" in line
+        for line in withheld_here(parse_codomain(observed))
+    )
+
+
+def test_the_swap_is_killed_by_a_test_that_pins_the_dict_and_survives_one_that_does_not(
+    target,
+):
+    module, path = target
+
+    def pins():
+        assert module.tally(["a", "b", "a"]) == {"a": 2, "b": 1}
+
+    def only_counts():
+        assert len(module.tally(["a", "b", "a"])) == 2
+
+    observed = observe(module, path, "tally", [pins])
+    m = one(path, "tally", observed, "return_swap_items")
+    killed = run(m, [pins], module, path, "tally")
+    assert killed.killed and killed.killed_by == "assertion"
+    # {1: 'b', 2: 'a'} has two entries too: a test of the size alone has not pinned the binding.
+    assert not run(m, [only_counts], module, path, "tally").killed
+
+
+def test_a_sequence_converts_to_a_set_only_where_its_elements_are_hashable(target):
+    module, path = target
+
+    def t():
+        assert module.listing(3) == [0, 1, 2]
+
+    observed = observe(module, path, "listing", [t])
+    assert "return_to_set" in _modes(path, "listing", observed)
+    m = one(path, "listing", observed, "return_to_set")
+    assert run(m, [t], module, path, "listing").killed_by == "assertion"
+
+    def rows():
+        assert module.rows(2) == [[0], [1]]
+
+    nested = observe(module, path, "rows", [rows])
+    assert "return_to_set" not in _modes(path, "rows", nested)
+    assert any(
+        "return_to_set" in line and "TypeError" in line
+        for line in withheld_here(parse_codomain(nested))
+    )
+
+
+def test_a_set_converts_to_a_sequence_in_sorted_order_only_where_it_has_one(target):
+    module, path = target
+
+    def t():
+        assert module.labels(3) == {"k0", "k1", "k2"}
+        assert module.frozen_labels(2) == frozenset({0, 1})
+
+    observed = observe(module, path, "labels", [t])
+    assert "return_from_set" in _modes(path, "labels", observed)
+    m = one(path, "labels", observed, "return_from_set")
+    assert run(m, [t], module, path, "labels").killed_by == "assertion"
+    assert "return_from_set" in _modes(
+        path, "frozen_labels", observe(module, path, "frozen_labels", [t])
+    )
+
+    def mixed():
+        assert module.mixed_set(1) == {1, "1"}
+
+    unorderable = observe(module, path, "mixed_set", [mixed])
+    assert "return_from_set" not in _modes(path, "mixed_set", unorderable)
+    assert any(
+        "return_from_set" in line and "TypeError" in line
+        for line in withheld_here(parse_codomain(unorderable))
+    )
+
+
+# ── the operators themselves ────────────────────────────────────────────────────────────────────
+
+
+def test_the_swap_exchanges_keys_and_values():
+    assert apply_value_mode("return_swap_items", {"a": 1, "b": 2}) == {1: "a", 2: "b"}
+    # Equal values collapse: the perturbation still changes the dict, which is the fence.
+    assert apply_value_mode("return_swap_items", {"a": 1, "b": 1}) == {1: "b"}
+
+
+def test_a_set_converts_to_the_same_sorted_sequence_under_every_hash_seed(tmp_path):
+    import subprocess
+    import sys
+
+    probe = tmp_path / "probe.py"
+    probe.write_text(
+        "from Wesker.mu_minus import apply_value_mode\n"
+        "print(apply_value_mode('return_from_set', {'delta','alpha','gamma','beta'}),"
+        " apply_value_mode('return_from_set', frozenset({3, 1, 2})))\n"
+    )
+    seen = set()
+    for seed in ("0", "1", "7"):
+        out = subprocess.run(
+            [sys.executable, str(probe)],
+            env={"PYTHONHASHSEED": seed, "PYTHONPATH": ":".join(sys.path)},
+            capture_output=True,
+            text=True,
+            check=True,
+        ).stdout
+        seen.add(out)
+    assert seen == {"['alpha', 'beta', 'delta', 'gamma'] (1, 2, 3)\n"}
+
+
+@pytest.mark.parametrize(
+    ("mode", "value"),
+    [
+        ("return_swap_items", {}),
+        ("return_swap_items", {"a": 1}),
+        ("return_swap_items", {1: None, 2: (1, 2)}),
+        ("return_to_set", []),
+        ("return_to_set", [1, "a", None]),
+        ("return_to_set", (1, 1, 2)),
+        ("return_from_set", set()),
+        ("return_from_set", {3, 1, 2}),
+        ("return_from_set", frozenset({"x"})),
+    ],
+)
+def test_never_raises_on_an_observed_value_and_changes_some(mode, value):
+    assert mode in candidate_modes(value)
+    out = apply_value_mode(mode, value)
+    assert out is not value
+    assert perturb_return(mode, value) == out
+
+
+@pytest.mark.parametrize(
+    ("mode", "value"),
+    [
+        ("return_swap_items", {"k": [1]}),
+        ("return_to_set", [[1]]),
+        ("return_from_set", {1, "a"}),
+        ("return_to_set", "text"),
+        ("return_from_set", [3, 1]),
+        ("return_swap_items", [("k", 1)]),
+    ],
+)
+def test_a_value_outside_the_premise_comes_back_unchanged_never_as_a_crash(mode, value):
+    # A mutant meets values the baseline never saw. The runtime helper must not turn them into a
+    # raise: that would be scored as a crash kill the suite never earned.
+    with pytest.raises(Exception):  # noqa: B017 - any failure; the premise is what failed
+        apply_value_mode(mode, value)
+    assert perturb_return(mode, value) is value
+
+
+def test_a_subclass_of_a_builtin_container_is_not_offered_the_exact_type_operators():
+    from collections import OrderedDict, defaultdict
+
+    assert "return_swap_items" not in candidate_modes(OrderedDict(a=1))
+    assert "return_swap_items" not in candidate_modes(defaultdict(int))
