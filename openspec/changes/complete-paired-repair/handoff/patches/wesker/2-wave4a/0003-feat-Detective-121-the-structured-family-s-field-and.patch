+"""μ⁻ structured family: field and class (Detective #121, Wesker #44).
+
+Intent tests authored from docs/theory/NEGATIVE_SPECIFICATION.md, Def. 11.8 (vi) and Def. 11.10.
+
+THE DEFECT (Detective #121). ``field`` and ``class`` were "unsupported". The observed codomain was a
+bare type name: it could not show that a return is a record, nor its fields, nor that a class has a
+base, so a record return got only the universal operators (``midpoint(a, b) -> Point`` got none, a
+namedtuple under its class name got no tuple operator either).
+
+WHAT MUST HOLD.
+- Where a return site's observed values are records (dataclass, namedtuple, a plain object with
+  ``__dict__`` or ``__slots__``), ONE FIELD AT A TIME is perturbed, and the field names and types are
+  read off the observed instances: a field to its type's default, a numeric, boolean or string field
+  moved a step, two same-typed fields exchanged (each with the previous field of its type). One mutant per field, the field in the mode.
+- Where they are instances of a user class, an instance of a dynamically created SUBCLASS (a copy of
+  the observed instance with ``__class__`` rebound) is returned, and, where the class has a user base,
+  an instance of the BASE. The first is what separates ``type(x) is C`` from ``isinstance(x, C)``.
+- A site whose values are not all records of the same shape, or whose copy cannot be rebound, gets
+  no such mutant, and the profile names the premise that failed.
+- The perturbation never raises on an observed value, never changes the original object, and a value
+  the baseline never saw comes back unchanged.
+"""
+
+from __future__ import annotations
+
+import copy
+import enum
+
+import pytest
+from _mu_support import load, mode_lines, observe, one, run, unload
+
+from Wesker.codomain import parse_codomain, withheld_here
+from Wesker.mu_minus import (
+    apply_value_mode,
+    candidate_modes,
+    field_modes,
+    perturb_return,
+    record_fields,
+)
+
+_SRC = """
+import enum
+from collections import namedtuple
+from dataclasses import dataclass
+
+
+@dataclass
+class Point:
+    x: int
+    y: int
+    label: str = "p"
+
+
+@dataclass(frozen=True, slots=True)
+class Frozen:
+    a: float
+    b: float
+    flag: bool
+
+
+Pair = namedtuple("Pair", ["lo", "hi", "name"])
+
+
+class Plain:
+    def __init__(self, v, tag):
+        self.v = v
+        self.tag = tag
+
+
+class Slotted:
+    __slots__ = ("p", "q")
+
+    def __init__(self, p, q):
+        self.p = p
+        self.q = q
+
+
+class Base:
+    def __init__(self, v):
+        self.v = v
+
+
+class Derived(Base):
+    pass
+
+
+class Color(enum.Enum):
+    RED = 1
+
+
+def midpoint(a, b):
+    return Point((a.x + b.x) // 2, (a.y + b.y) // 2, "mid")
+
+
+def frozen(n):
+    return Frozen(n * 1.5, n * 2.5, n > 0)
+
+
+def pair(n):
+    return Pair(n, n + 1, "p")
+
+
+def plain(n):
+    return Plain(n, "t")
+
+
+def slotted(n):
+    return Slotted(n, n + 1)
+
+
+def derived(n):
+    return Derived(n)
+
+
+def base(n):
+    return Base(n)
+
+
+def color(n):
+    return Color.RED
+
+
+def either(n):
+    return Point(1, 2) if n else Pair(1, 2, "x")
+
+
+def with_object_field(n):
+    return Plain(object(), n)
+"""
+
+
+@pytest.fixture(scope="module")
+def target(tmp_path_factory):
+    module, path = load(
+        tmp_path_factory.mktemp("mu_structured"), "mu_structured_t", _SRC
+    )
+    yield module, path
+    unload("mu_structured_t")
+
+
+def _modes(path, name, observed):
+    return {mode for mode, _line in mode_lines(path, name, observed)}
+
+
+def test_a_dataclass_return_is_perturbed_one_field_at_a_time(target):
+    module, path = target
+
+    def t():
+        assert module.midpoint(module.Point(0, 0), module.Point(2, 4)) == module.Point(
+            1, 2, "mid"
+        )
+
+    observed = observe(module, path, "midpoint", [t])
+    modes = _modes(path, "midpoint", observed)
+    # Field names and types come from the observed instance: x, y (int), label (str).
+    assert {f"return_field_drop@{f}" for f in ("x", "y", "label")} <= modes
+    assert {f"return_field_bump@{f}" for f in ("x", "y", "label")} <= modes
+    # The only same-typed pair is (x, y): label is a str among ints.
+    assert {m for m in modes if m.startswith("return_field_swap")} == {
+        "return_field_swap@x,y"
+    }
+    assert "return_class_subclass" in modes
+
+
+def test_every_field_mutant_is_killed_by_a_test_that_pins_the_record(target):
+    module, path = target
+
+    def pins():
+        got = module.midpoint(module.Point(0, 0), module.Point(2, 4))
+        assert got == module.Point(1, 2, "mid")
+
+    def only_x():
+        assert module.midpoint(module.Point(0, 0), module.Point(2, 4)).x == 1
+
+    observed = observe(module, path, "midpoint", [pins])
+    fields = [
+        m for m in _modes(path, "midpoint", observed) if m.startswith("return_field_")
+    ]
+    assert len(fields) == 7
+    for mode in fields:
+        m = one(path, "midpoint", observed, mode)
+        assert run(m, [pins], module, path, "midpoint").killed_by == "assertion", mode
+    # A test that reads only x has not pinned y or the label, and the mutants say so.
+    survivors = {
+        mode
+        for mode in fields
+        if not run(
+            one(path, "midpoint", observed, mode), [only_x], module, path, "midpoint"
+        ).killed
+    }
+    assert "return_field_drop@y" in survivors and "return_field_bump@label" in survivors
+    assert "return_field_drop@x" not in survivors
+
+
+@pytest.mark.parametrize(
+    ("name", "fields", "swap"),
+    [
+        ("frozen", {"a", "b", "flag"}, "return_field_swap@a,b"),
+        ("pair", {"lo", "hi", "name"}, "return_field_swap@lo,hi"),
+        ("plain", {"v", "tag"}, None),
+        ("slotted", {"p", "q"}, "return_field_swap@p,q"),
+    ],
+)
+def test_every_record_shape_is_perturbed(target, name, fields, swap):
+    module, path = target
+    fn = getattr(module, name)
+
+    def t():
+        assert fn(2) is not None
+
+    observed = observe(module, path, name, [t])
+    modes = _modes(path, name, observed)
+    assert fields <= {
+        m.split("@")[1] for m in modes if m.startswith("return_field_drop")
+    } | {m.split("@")[1] for m in modes if m.startswith("return_field_bump")}
+    assert (
+        (swap in modes)
+        if swap
+        else not any(m.startswith("return_field_swap") for m in modes)
+    )
+
+
+def test_a_namedtuple_gets_its_field_operators_not_only_the_tuple_ones(target):
+    # Detective #121: "a namedtuple observed under its class name gets no tuple operator either".
+    module, path = target
+
+    def t():
+        assert module.pair(1) == module.Pair(1, 2, "p")
+
+    observed = observe(module, path, "pair", [t])
+    modes = _modes(path, "pair", observed)
+    assert "return_field_bump@lo" in modes and "return_class_subclass" in modes
+    m = one(path, "pair", observed, "return_field_bump@lo")
+    assert run(m, [t], module, path, "pair").killed_by == "assertion"
+
+
+def test_a_field_without_a_safe_default_is_not_offered_a_drop(target):
+    module, path = target
+
+    def t():
+        assert module.with_object_field(1).tag == 1
+
+    observed = observe(module, path, "with_object_field", [t])
+    modes = _modes(path, "with_object_field", observed)
+    assert "return_field_drop@tag" in modes and "return_field_bump@tag" in modes
+    assert not {"return_field_drop@v", "return_field_bump@v"} & modes
+
+
+def test_a_site_returning_records_of_two_shapes_gets_no_field_mutant(target):
+    module, path = target
+
+    def t():
+        assert module.either(1).__class__.__name__ == "Point"
+        assert module.either(0).__class__.__name__ == "Pair"
+
+    observed = observe(module, path, "either", [t])
+    assert not any(
+        m.startswith("return_field_") for m in _modes(path, "either", observed)
+    )
+
+
+def test_a_subclass_instance_separates_the_exact_class_from_isinstance(target):
+    module, path = target
+
+    def exact():
+        assert type(module.derived(3)) is module.Derived
+
+    def lenient():
+        assert isinstance(module.derived(3), module.Derived)
+
+    observed = observe(module, path, "derived", [exact])
+    sub = one(path, "derived", observed, "return_class_subclass")
+    assert run(sub, [exact], module, path, "derived").killed_by == "assertion"
+    # The subclass IS a Derived: a test that only asks isinstance has not pinned the exact class.
+    assert not run(sub, [lenient], module, path, "derived").killed
+    base = one(path, "derived", observed, "return_class_base")
+    assert run(base, [lenient], module, path, "derived").killed
+    assert run(base, [exact], module, path, "derived").killed
+
+
+def test_a_class_without_a_user_base_gets_no_base_instance(target):
+    module, path = target
+
+    def t():
+        assert module.base(1).v == 1
+
+    observed = observe(module, path, "base", [t])
+    modes = _modes(path, "base", observed)
+    assert "return_class_subclass" in modes and "return_class_base" not in modes
+
+
+def test_an_enum_member_cannot_be_copied_and_the_function_says_so(target):
+    module, path = target
+
+    def t():
+        assert module.color(1) is module.Color.RED
+
+    observed = observe(module, path, "color", [t])
+    assert "return_class_subclass" not in _modes(path, "color", observed)
+    assert any(
+        "return_class_subclass" in line
+        for line in withheld_here(parse_codomain(observed))
+    ), withheld_here(parse_codomain(observed))
+
+
+# ── the operators themselves ────────────────────────────────────────────────────────────────────
+
+
+def _samples(module):
+    return [
+        module.Point(1, 2, "a"),
+        module.Frozen(1.5, 2.5, True),
+        module.Pair(1, 2, "n"),
+        module.Plain(3, "t"),
+        module.Slotted(4, 5),
+        module.Derived(7),
+    ]
+
+
+def test_every_mode_a_record_offers_applies_without_raising_and_leaves_the_original_alone(
+    target,
+):
+    module, _path = target
+    for value in _samples(module):
+        before = copy.copy(value)
+        before_fields = dict(record_fields(value))
+        for mode in candidate_modes(value):
+            out = apply_value_mode(mode, value)
+            assert out is not value, mode
+            assert type(out) is not None
+            assert perturb_return(mode, value) is not value
+        # The original is untouched, and keeps its own class.
+        assert record_fields(value) == before_fields and type(value) is type(before)
+
+
+def test_the_subclass_reads_the_same_and_the_field_perturbation_is_one_field():
+    from dataclasses import dataclass
+
+    @dataclass
+    class P:
+        x: int
+        y: int
+
+    base = P(1, 2)
+    sub = apply_value_mode("return_class_subclass", base)
+    assert (type(sub).__name__, type(sub).__qualname__, type(sub).__module__) == (
+        P.__name__,
+        P.__qualname__,
+        P.__module__,
+    )
+    assert type(sub) is not P and isinstance(sub, P) and sub.x == 1 and sub.y == 2
+    assert apply_value_mode("return_field_drop@x", base) == P(0, 2)
+    assert apply_value_mode("return_field_bump@y", base) == P(1, 3)
+    assert apply_value_mode("return_field_swap@x,y", base) == P(2, 1)
+
+
+def test_the_field_modes_of_a_value_name_its_fields_and_types():
+    class Plain:
+        def __init__(self):
+            self.n = 1
+            self.s = "a"
+            self.t = 2
+            self.f = 1.5
+
+    assert field_modes(Plain()) == [
+        "return_field_drop@n",
+        "return_field_bump@n",
+        "return_field_drop@s",
+        "return_field_bump@s",
+        "return_field_drop@t",
+        "return_field_bump@t",
+        "return_field_drop@f",
+        "return_field_bump@f",
+        # each field is exchanged with the previous field of its own type
+        "return_field_swap@n,t",
+    ]
+    assert (
+        field_modes(3) == [] and field_modes([1, 2]) == [] and field_modes(None) == []
+    )
+
+
+@pytest.mark.parametrize("value", [3, "s", [1], (1, 2), {"a": 1}, None, 1.5, b"x", {1}])
+def test_a_builtin_value_is_never_a_record_or_a_class_target(value):
+    assert record_fields(value) is None
+    modes = candidate_modes(value)
+    assert not any(m.startswith(("return_field_", "return_class_")) for m in modes)
+
+
+def test_a_value_outside_the_premise_comes_back_unchanged():
+    assert perturb_return("return_field_drop@x", 3) == 3
+    assert perturb_return("return_class_subclass", 3) == 3
+    assert perturb_return("return_field_swap@x,y", object()) is not None
+    marker = enum.Enum("E", "A").A
+    assert perturb_return("return_class_subclass", marker) is marker
