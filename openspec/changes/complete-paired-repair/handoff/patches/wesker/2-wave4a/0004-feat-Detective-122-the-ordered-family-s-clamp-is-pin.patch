+++ b/tests/test_mu_minus_clamp_premise_intent.py
@@ -0,0 +1,288 @@
+"""μ⁻ ordered family: clamp (Detective #122, Wesker #44).
+
+Intent tests authored from docs/theory/NEGATIVE_SPECIFICATION.md, Def. 11.8 (vii) and Def. 11.10.
+
+THE DEFECT (Detective #122). ``clamp`` was "unsupported": ``clip(v, l, u)`` needs the range the
+invariant names, and no premise for it was observed. The baseline run observes the values a function
+returns, so the range IS observed: the minimum and maximum over the values a return site produced.
+
+WHAT MUST HOLD (Def. 11.8(vii), "a range invariant").
+- The clamp is generated at a return site whose observed values are mutually ordered numbers (or
+  dates, naive datetimes, timedeltas) of ONE kind with at least two distinct values, into the observed
+  [min, max] NARROWED BY ONE STEP on each side, so that a value at an edge changes. The step is 1 for
+  an int, the adjacent float, the adjacent Decimal, a day for a date, a microsecond for the rest.
+- It is not generated, and the function's profile says why, for a single observed value (nothing to
+  narrow), mixed kinds (an int and a Decimal are not one range) or a non-finite value. A site returning
+  a str or None is simply not a clamp site.
+- The perturbation never raises on an observed value, and a value the baseline never saw comes back
+  unchanged. It is killed by a test that pins the output at an edge, and survives one that does not.
+"""
+
+from __future__ import annotations
+
+import datetime as dt
+import decimal
+import math
+
+import pytest
+from _mu_support import load, mode_lines, observe, one, run, unload
+
+from Wesker.codomain import parse_codomain, withheld_here
+from Wesker.mu_minus import (
+    apply_value_mode,
+    bound_kind,
+    decode_bound,
+    encode_bound,
+    narrowed_bounds,
+    perturb_return,
+)
+
+_SRC = """
+import datetime as dt
+import decimal
+
+
+def twice(n):
+    return n * 2
+
+
+def ratio(n):
+    return n / 4
+
+
+def money(n):
+    return decimal.Decimal(n) / decimal.Decimal(4)
+
+
+def day(n):
+    return dt.date(2020, 1, 1) + dt.timedelta(days=n)
+
+
+def stamp(n):
+    return dt.datetime(2020, 1, 1) + dt.timedelta(seconds=n)
+
+
+def aware(n):
+    return dt.datetime(2020, 1, 1, tzinfo=dt.UTC) + dt.timedelta(seconds=n)
+
+
+def span(n):
+    return dt.timedelta(seconds=n)
+
+
+def constant(n):
+    return 7
+
+
+def mixed(n):
+    return n if n < 2 else decimal.Decimal(n)
+
+
+def maybe(n):
+    return n * 2 if n else None
+
+
+def label(n):
+    return "x" * n
+
+
+def wild(n):
+    return float(n) if n < 3 else math.inf
+
+
+import math
+"""
+
+
+@pytest.fixture(scope="module")
+def target(tmp_path_factory):
+    module, path = load(tmp_path_factory.mktemp("mu_clamp"), "mu_clamp_t", _SRC)
+    yield module, path
+    unload("mu_clamp_t")
+
+
+def _clamps(path, name, observed):
+    return {
+        mode
+        for mode, _line in mode_lines(path, name, observed)
+        if mode.startswith("return_clamp")
+    }
+
+
+def test_the_clamp_narrows_the_observed_range_by_one_step_on_each_side(target):
+    module, path = target
+
+    def t():
+        assert [module.twice(n) for n in (2, 3, 5)] == [4, 6, 10]
+
+    observed = observe(module, path, "twice", [t])
+    # observed [4, 10], narrowed to [5, 9]
+    assert _clamps(path, "twice", observed) == {"return_clamp@i5,i9"}
+
+
+def test_the_clamp_is_killed_at_an_edge_and_survives_the_interior(target):
+    module, path = target
+
+    def edges():
+        assert module.twice(2) == 4
+        assert module.twice(5) == 10
+
+    def interior():
+        assert module.twice(3) == 6
+        assert module.twice(4) == 8
+
+    def sign_only():
+        assert module.twice(2) > 0 and module.twice(5) > 0
+
+    observed = observe(module, path, "twice", [edges, interior])
+    m = one(path, "twice", observed, "return_clamp@i5,i9")
+    assert run(m, [edges], module, path, "twice").killed_by == "assertion"
+    # An interior value is not moved by a clamp narrowed by one step on each side.
+    assert not run(m, [interior], module, path, "twice").killed
+    # An edge test that does not assert the exact value has not pinned the range either.
+    assert not run(m, [sign_only], module, path, "twice").killed
+
+
+@pytest.mark.parametrize(
+    ("name", "args", "expected"),
+    [
+        ("ratio", (1, 2, 3), "f"),
+        ("money", (1, 2, 3), "D"),
+        ("day", (0, 3, 9), "d"),
+        ("stamp", (0, 5, 60), "n"),
+        ("span", (1, 4, 90), "t"),
+    ],
+)
+def test_every_ordered_kind_is_clamped(target, name, args, expected):
+    module, path = target
+    fn = getattr(module, name)
+
+    def t():
+        assert all(fn(a) is not None for a in args)
+
+    observed = observe(module, path, name, [t])
+    clamps = _clamps(path, name, observed)
+    assert len(clamps) == 1
+    (mode,) = clamps
+    low, _, high = mode.partition("@")[2].partition(",")
+    assert low[0] == high[0] == expected
+    values = [fn(a) for a in args]
+    # The bounds lie strictly inside the observed range: the edges move.
+    assert min(values) < decode_bound(low) <= decode_bound(high) < max(values)
+    m = one(path, name, observed, mode)
+    assert run(m, [t], module, path, name).killed is False  # the test pins nothing...
+
+    def pins():
+        # looked up on the module at call time: a mutant is installed there, the captured `fn` is not
+        assert [getattr(module, name)(a) for a in args] == values
+
+    assert (
+        run(m, [pins], module, path, name).killed_by == "assertion"
+    )  # ...a pin kills it
+
+
+@pytest.mark.parametrize(
+    ("name", "args", "why"),
+    [
+        ("constant", (1, 2), "single_value"),
+        ("mixed", (1, 2), "mixed_kinds"),
+        ("wild", (1, 5), "non_finite"),
+    ],
+)
+def test_a_site_that_admits_no_clamp_says_why(target, name, args, why):
+    module, path = target
+    fn = getattr(module, name)
+
+    def t():
+        assert all(fn(a) is not None for a in args)
+
+    observed = observe(module, path, name, [t])
+    assert not _clamps(path, name, observed)
+    named = withheld_here(parse_codomain(observed))
+    assert any("return_clamp" in line and why in line for line in named), named
+
+
+@pytest.mark.parametrize("name", ["aware", "label", "maybe"])
+def test_a_site_that_is_not_an_ordered_numeric_site_is_not_a_clamp_site(target, name):
+    module, path = target
+    fn = getattr(module, name)
+
+    def t():
+        assert all(fn(a) is not None for a in (0, 1, 2))
+
+    observed = observe(module, path, name, [t])
+    assert not _clamps(path, name, observed)
+    # ...and that is typing, not a failed premise: nothing is named as withheld for the clamp.
+    assert not any(
+        "return_clamp" in line for line in withheld_here(parse_codomain(observed))
+    )
+
+
+def test_a_range_one_step_wide_keeps_its_upper_edge():
+    # {0, 1}: lower+1 = 1, upper-1 = 0 is below it, so the upper edge stays: [1, 1].
+    assert narrowed_bounds(0, 1) == (1, 1)
+    assert narrowed_bounds(0, 2) == (1, 1)
+    assert narrowed_bounds(0, 10) == (1, 9)
+    assert narrowed_bounds(5, 5) is None
+    low, high = narrowed_bounds(1.0, 2.0)
+    assert 1.0 < low < high < 2.0 and low == math.nextafter(1.0, 2.0)
+    assert narrowed_bounds(dt.date(2020, 1, 1), dt.date(2020, 1, 9)) == (
+        dt.date(2020, 1, 2),
+        dt.date(2020, 1, 8),
+    )
+    assert narrowed_bounds(dt.timedelta(0), dt.timedelta(seconds=1)) == (
+        dt.timedelta(microseconds=1),
+        dt.timedelta(seconds=1) - dt.timedelta(microseconds=1),
+    )
+    # At the type's own limit a step cannot overflow.
+    assert narrowed_bounds(dt.date.min, dt.date.max) == (
+        dt.date.min + dt.timedelta(days=1),
+        dt.date.max - dt.timedelta(days=1),
+    )
+
+
+@pytest.mark.parametrize(
+    "value",
+    [
+        0,
+        -7,
+        10**30,
+        0.0,
+        -2.5,
+        1e308,
+        5e-324,
+        decimal.Decimal("1.5"),
+        decimal.Decimal("-0.001"),
+        dt.date.min,
+        dt.date.max,
+        dt.datetime.min,  # noqa: DTZ901
+        dt.datetime.max,  # noqa: DTZ901
+        dt.timedelta.min,
+        dt.timedelta.max,
+    ],
+)
+def test_a_bound_round_trips_and_carries_no_separator(value):
+    token = encode_bound(value)
+    assert ":" not in token and "@" not in token and "," not in token
+    assert decode_bound(token) == value and type(decode_bound(token)) is type(value)
+    assert bound_kind(value) != ""
+
+
+@pytest.mark.parametrize(
+    "value", [True, math.nan, math.inf, decimal.Decimal("NaN"), "s", None, [1]]
+)
+def test_a_value_with_no_ordered_kind_has_none(value):
+    assert bound_kind(value) == ""
+
+
+def test_the_clamp_never_raises_on_an_observed_value_and_moves_an_edge():
+    mode = "return_clamp@i5,i9"
+    assert [apply_value_mode(mode, v) for v in (4, 5, 7, 9, 10)] == [5, 5, 7, 9, 9]
+    assert perturb_return("return_clamp@f0x1p+0,f0x1p+1", 1.5) == 1.5
+    assert perturb_return("return_clamp@i5,i9", 10**400) == 9
+
+
+def test_a_value_the_baseline_never_saw_comes_back_unchanged():
+    # A str cannot be compared with the int bounds; the helper leaves it alone instead of raising.
+    assert perturb_return("return_clamp@i5,i9", "text") == "text"
+    assert perturb_return("return_clamp@i5,i9", None) is None
-- 
