+"""The premised μ⁻ mutants are measured by the isolated worker as they are in process (Wesker #44).
+
+THE RISK. The isolated worker receives nothing but source. The Form B yield modes once reached it as a
+marker string that defines nothing, so the worker installed the ORIGINAL function and every isolated
+verdict on them was a false survivor. The premised Form A rewrites call ``Wesker.mu_minus`` at run time
+and the parameterized Form B modes are a decorated definition; both must be source a worker builds and
+measures to the same verdict the in-process evaluator reaches, or converge's reproducibility check
+(which re-observes in an isolated worker) would certify a verdict nobody reproduced.
+
+WHAT MUST HOLD. For one function per family (field, clamp, raise-inject, state-extra), the mutant
+generated from the observed codomain is KILLED by a test that pins the output, by assertion where the
+perturbation is a value (field, clamp, extra write), and a reach kill (a crash) for the injected raise,
+in the isolated worker, and SURVIVES a test that pins nothing.
+"""
+
+from __future__ import annotations
+
+import ast
+import sys
+
+import pytest
+from _mu_support import load, observe, one, unload
+
+from Wesker.isolation import IsolatedMutantWorker, mutant_verdict
+
+_SRC = """
+from dataclasses import dataclass
+
+
+@dataclass
+class P:
+    x: int
+    y: int
+
+
+def mk(n):
+    return P(n, n + 1)
+
+
+def sc(n):
+    if n < 0:
+        raise ValueError(n)
+    return n * 2
+
+
+def tot(xs):
+    return len(xs)
+"""
+
+_TESTS = """
+from t import P, mk, sc, tot
+
+
+def test_mk():
+    assert mk(1) == P(1, 2)
+
+
+def test_mk_loose():
+    assert mk(1) is not None
+
+
+def test_sc_edges():
+    assert sc(2) == 4
+    assert sc(5) == 10
+
+
+def test_sc_loose():
+    assert sc(3) > 0
+
+
+def test_tot():
+    xs = [1]
+    assert tot(xs) == 1
+    assert xs == [1]
+
+
+def test_tot_loose():
+    assert tot([1]) == 1
+"""
+
+
+@pytest.fixture
+def project(tmp_path):
+    (tmp_path / "t.py").write_text(_SRC)
+    (tmp_path / "test_t.py").write_text(_TESTS)
+    module, path = load(tmp_path, "t", _SRC)
+    sys.path.insert(0, str(tmp_path))
+    yield tmp_path, module, path
+    sys.path.remove(str(tmp_path))
+    unload("t")
+
+
+def _isolated(tmp_path, name, mutant, node_id):
+    worker = IsolatedMutantWorker(str(tmp_path), [], "t.py", name)
+    try:
+        return worker.evaluate(
+            ast.unparse(mutant.mutated_node), 30.0, node_ids=[f"test_t.py::{node_id}"]
+        )
+    finally:
+        worker.close()
+
+
+def test_a_field_mutant_is_killed_by_the_pinning_test_in_the_isolated_worker(project):
+    tmp_path, module, path = project
+
+    def t():
+        assert module.mk(1) == module.P(1, 2)
+
+    observed = observe(module, path, "mk", [t])
+    m = one(path, "mk", observed, "return_field_drop@y")
+    killed = _isolated(tmp_path, "mk", m, "test_mk")
+    assert (
+        mutant_verdict(killed.outcome) == "killed" and killed.killed_by == "assertion"
+    )
+    assert (
+        mutant_verdict(_isolated(tmp_path, "mk", m, "test_mk_loose").outcome)
+        == "survived"
+    )
+
+
+def test_a_clamp_mutant_is_killed_at_the_edge_in_the_isolated_worker(project):
+    tmp_path, module, path = project
+
+    def t():
+        assert [module.sc(2), module.sc(5)] == [4, 10]
+
+    observed = observe(module, path, "sc", [t])
+    m = one(path, "sc", observed, "return_clamp@i5,i9")
+    killed = _isolated(tmp_path, "sc", m, "test_sc_edges")
+    assert (
+        mutant_verdict(killed.outcome) == "killed" and killed.killed_by == "assertion"
+    )
+    assert (
+        mutant_verdict(_isolated(tmp_path, "sc", m, "test_sc_loose").outcome)
+        == "survived"
+    )
+
+
+def test_an_injected_raise_is_a_reach_kill_in_the_isolated_worker(project):
+    tmp_path, module, path = project
+
+    def t():
+        assert module.sc(2) == 4
+        try:
+            module.sc(-1)
+        except ValueError:
+            pass
+
+    observed = observe(module, path, "sc", [t])
+    m = one(path, "sc", observed, "raise_inject@builtins.ValueError")
+    killed = _isolated(tmp_path, "sc", m, "test_sc_loose")
+    # A test that pins nothing about the output still dies: the kill is REACH, not specification.
+    assert mutant_verdict(killed.outcome) == "killed" and killed.killed_by == "crash"
+
+
+def test_an_extra_write_is_killed_by_the_test_that_looks_at_the_argument(project):
+    tmp_path, module, path = project
+
+    def t():
+        xs = [1]
+        assert module.tot(xs) == 1
+        assert xs == [1]
+
+    observed = observe(module, path, "tot", [t])
+    m = one(path, "tot", observed, "state_extra@xs")
+    killed = _isolated(tmp_path, "tot", m, "test_tot")
+    assert (
+        mutant_verdict(killed.outcome) == "killed" and killed.killed_by == "assertion"
+    )
+    assert (
+        mutant_verdict(_isolated(tmp_path, "tot", m, "test_tot_loose").outcome)
+        == "survived"
+    )
