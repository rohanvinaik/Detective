+def call_tokens(
+    observer: _Observer, original: Callable[..., Any], func_node: ast.AST | None
+) -> set[str]:
+    """The function-level tokens: injectable raises and extra-write arguments."""
+    out: set[str] = set()
+    if observer.raised_ok or observer.raised_no:
+        for path in sorted(observer.raised_ok):
+            out.add(f"@!ok=raise_inject@{path}")
+        for path, why in sorted(observer.raised_no.items()):
