+def test_this_interpreter_reports_return_lines_the_mutator_can_match():
+    # The whole per-site design rests on the line the interpreter reports for a RETURN instruction
+    # being the first line of its `return` statement, on every supported version.
+    src = "def f(a):\n    if a:\n        return (\n            a,\n            a)\n    return \\\n        a\n"
+    ns: dict = {}
+    exec(compile(src, "m.py", "exec"), ns)  # noqa: S102
+    code = ns["f"].__code__
+    import dis
+
+    positions = list(code.co_positions())
+    lines = {
+        positions[i.offset // 2][0]
+        for i in dis.get_instructions(code)
+        if i.opname.startswith("RETURN")
+    }
+    assert lines == {3, 6}, sys.version_info
