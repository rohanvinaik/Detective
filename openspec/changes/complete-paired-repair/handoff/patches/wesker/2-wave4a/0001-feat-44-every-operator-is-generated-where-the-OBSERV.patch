+
+def clamp_standing(kinds: list[str], finite_ordered: bool, narrowable: bool) -> str:
+    """Whether a site's observed returns admit the clamp (#122, pure — pinned).
+
+    non_finite    a NaN or an infinity was returned: the range has no finite edge to narrow
+    not_ordered   some value has no ordered kind the clamp is defined for (a str, a None, a list,
+                  an aware datetime): not a clamp site, and no premise failed
+    mixed_kinds   int and Decimal, or a date and a datetime, are not one ordered range
+    single_value  every observed value is the same: the range has nothing to narrow
+    clamps        a single ordered kind with a range that narrows
+    """
+    if "-nonfinite" in kinds:
+        return "non_finite"
+    if not kinds or any(k.startswith("-") or not k for k in kinds):
+        return "not_ordered"
+    if len(set(kinds)) != 1:
+        return "mixed_kinds"
+    if not finite_ordered or not narrowable:
+        return "single_value"
+    return "clamps"
