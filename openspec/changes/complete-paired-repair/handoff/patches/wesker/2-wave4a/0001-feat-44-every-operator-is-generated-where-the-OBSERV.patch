+def _own_raise_names(func_node: ast.AST | None) -> list[str]:
+    """The exception names a function's OWN body raises (nested scopes excluded), minus any name the
+    function itself binds (a parameter, an assignment, an ``except ... as`` name). A bare re-raise
+    names nothing."""
