+
+def _clamp_tokens(line: int, site: _Site) -> set[str]:
+    standing = clamp_standing(
+        sorted(site.kinds),
+        site.low is not None,
+        site.low is not None and site.high is not None and site.low < site.high,
+    )
+    if standing in ("mixed_kinds", "non_finite"):
+        return {f"@{line}!no=return_clamp={standing}"}
+    if standing == "single_value":
+        return {f"@{line}!no=return_clamp=single_value"}
+    if standing != "clamps":
+        return set()
+    bounds = _mu.narrowed_bounds(site.low, site.high)
