+    code = getattr(original, "__code__", None)
+    if (
+        code is None
+        or not tests
+        or code.co_flags & (inspect.CO_GENERATOR | inspect.CO_ASYNC_GENERATOR)
+    ):
+        return frozenset()
+    observer = _Observer(code)
+    events = sys.monitoring.events
+    handles = [
+        subscribe((code,), events.PY_START, observer.on_start),
+        subscribe((code,), events.PY_RETURN, observer.on_return),
+        subscribe((code,), events.PY_UNWIND, observer.on_unwind),
+    ]
+    complete = True
+    try:
+        for test in tests:
+            remaining = (
+                per_test_ms
+                if deadline is None
+                else min(per_test_ms, max(0.0, (deadline - time.monotonic()) * 1000.0))
+            )
+            if remaining <= 0:
+                complete = False
+                break
+            outcome = _run_test_with_timeout(test, original, True, remaining)
+            if outcome in (
+                "undetermined",
+                "diverged",
+                "uncontained",
+                "nested_measurement",
+            ) or (baseline_probe_disposition(outcome) == "uncontained"):
+                complete = False
+                break
+    finally:
+        for handle in handles:
+            handle.close()
+    observer_failed = False
+    for handle in handles:
+        try:
+            handle.check()
+        except MonitoringObservationFailed:
+            observer_failed = True
+    if not complete or observer_failed:
+        # The subscription's own failure is an observer fault, never the target's: the observation
+        # is incomplete and says so, so nothing premised is generated from it.
+        return frozenset({"@!truncated"})
+    tokens: set[str] = set()
+    for line, site in observer.sites.items():
+        tokens |= site_tokens(line, site, complete)
+        tokens |= site.types
+    tokens |= call_tokens(observer, original, func_node)
+    return frozenset(tokens)
