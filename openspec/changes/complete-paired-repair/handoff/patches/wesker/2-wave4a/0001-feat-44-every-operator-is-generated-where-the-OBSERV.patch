+
+def site_tokens(line: int, site: _Site, complete: bool) -> set[str]:
+    """The tokens one finished site contributes."""
+    out = {f"@{line}:{t}" for t in site.types}
+    if site.truncated:
+        out.add(f"@{line}!no=*=returns_truncated")
+        return out
+    if not complete:
+        return out
+    for mode, offered in site.offered.items():
+        succeeded = site.succeeded.get(mode, 0)
+        if succeeded == site.returns and mode in site.changed:
+            out.add(f"@{line}!ok={mode}")
+        elif succeeded == site.returns:
+            out.add(f"@{line}!no={mode}=no_effect_observed")
+        elif mode in site.failed and offered == site.returns:
+            out.add(f"@{line}!no={mode}={site.failed[mode]}")
