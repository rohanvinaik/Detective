+        module, path, "tag", [t], two_sign=True, observed_return_types=supplied
+    )
+    assert result.observed_codomain == ("str",)
+    named = " ".join(result.mu_minus_withheld)
+    assert "type names only" in named
+
+
+def test_the_categories_of_a_two_sign_filter_still_work_without_the_argument(tag):
+    # Callers may still pass the categories; the argument adds nothing they did not already name.
+    module, path = tag
+
+    def t():
+        assert module.tag(1) == "pos"
+
+    a = _profile(
