+def raise_standing(
+    local_class: bool, is_exception: bool, resolvable: bool, constructible: bool
+) -> str:
+    """Whether an observed raised class can be injected (#123, pure — pinned).
+
+    Split out because the answer is four independent facts of the class and each has its own remedy:
+
+      local_class        defined inside a function: no importable path names it
+      base_exception     a BaseException that is not an Exception: the engine's own interrupts derive
+                         from it, and nothing may inject one
+      unresolvable       its dotted path does not lead back to the class
+      not_constructible  it needs constructor arguments a message cannot supply
+      injectable         it can be raised from a path and a message
+    """
+    if local_class:
+        return "local_class"
+    if not is_exception:
+        return "base_exception"
+    if not resolvable:
+        return "unresolvable"
+    if not constructible:
+        return "not_constructible"
+    return "injectable"
+
+
+def _differs(after: Any, before: Any) -> bool:
+    """Whether a perturbation changed a value (a comparison that raises counts as a change)."""
+    if type(after) is not type(before):
+        return True
+    try:
+        return not bool(after == before)
+    # BLE001: an __eq__ that raises on two values cannot say they are equal
+    except Exception:  # noqa: BLE001
+        return True
