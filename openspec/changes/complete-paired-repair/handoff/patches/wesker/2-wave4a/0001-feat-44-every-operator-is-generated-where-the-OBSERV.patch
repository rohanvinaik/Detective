diff --git a/Wesker/codomain.py b/Wesker/codomain.py
new file mode 100644
index 0000000..444e9c0
--- /dev/null
+++ b/Wesker/codomain.py
@@ -0,0 +1,635 @@
+"""The observed codomain: what the baseline run SAW a function return, raise and leave unmutated.
+
+μ⁻ Fork 2 (docs/theory/NEGATIVE_SPECIFICATION.md, Def. 11.10) generates an output perturbation only
+where the OBSERVED codomain guarantees it applies, so it never raises and never mis-attributes. A type
+NAME decides that for ``negate`` (an int) but not for a dict key/value swap (are the values hashable?),
+a field perturbation (which fields?), a class perturbation (is there a base?), a clamp (what range?),
+an injected raise (which exception types?) or an extra write (which argument is mutable and
+untouched?). Those are facts about the values, so this module observes the VALUES, not the type names,
+and decides applicability by APPLYING the perturbation to what it saw (``Wesker.mu_minus``).
+
+The observation is a ``frozenset[str]``, the same type Detective carries through its verdict cache, so
+nothing that held the old type-name set has to change. A token is one of:
+
+* ``T``               a type name, function-wide (the old shape, and still the whole of a legacy
+                      observation that carries no site information);
+* ``@L:T``            the return at source line L returned a ``T``;
+* ``@L!ok=MODE``      MODE was applied to every value returned at line L and succeeded, and changed
+                      at least one of them: it applies there;
+* ``@L!no=MODE=WHY``  MODE's type was returned at line L and applying it raised ``WHY`` (a premise the
+                      observation measured FAILED, not one it did not measure);
+* ``@!ok=MODE`` / ``@!no=MODE=WHY``   the same for a mode about the call, not one return site (an
+                      injected raise, an extra write);
+* ``@!truncated``     the observation is incomplete (a test was cut): nothing type-conditional or
+                      premised may be generated from it.
+
+A mode never contains ``:`` (the dimension separator). Type names never contain ``@``.
+"""
+
+from __future__ import annotations
+
+import ast
+import decimal
+import functools
+import inspect
+import sys
+import time
+from collections.abc import Callable
+from dataclasses import dataclass, field
+from types import CodeType
+from typing import Any
+
+from . import mu_minus as _mu
+
+#: At most this many returns are applied per site, and this many calls are snapshotted. Past it the
+#: observation says so (``truncated``) instead of reading the first N as all of them.
+MAX_RETURNS_PER_SITE = 256
+MAX_CALLS_OBSERVED = 512
+#: The size bound of a state signature: nodes visited, and depth.
+SIGNATURE_BUDGET = 2000
+SIGNATURE_DEPTH = 4
+
+
+# ── The token grammar ───────────────────────────────────────────────────────────────────────────
+
+
+@dataclass(frozen=True)
+class SiteView:
+    """What the observation says about ONE return site (a source line)."""
+
+    types: frozenset[str] = frozenset()
+    ok: frozenset[str] = frozenset()
+    no: tuple[tuple[str, str], ...] = ()
+
+
+@dataclass(frozen=True)
+class Codomain:
+    """A parsed observation. ``sites`` is empty for a legacy (type-names-only) observation."""
+
+    plain: frozenset[str] = frozenset()
+    sites: dict[int, SiteView] = field(default_factory=dict)
+    ok: frozenset[str] = frozenset()
+    no: tuple[tuple[str, str], ...] = ()
+    complete: bool = True
+
+    @property
+    def has_sites(self) -> bool:
+        return bool(self.sites)
+
+    def site(self, line: int) -> SiteView | None:
+        return self.sites.get(line)
+
+
+@functools.cache
+def parse_codomain(tokens: frozenset[str]) -> Codomain:
+    """The structured view of an observation's tokens. Total: a token it does not know is ignored."""
+    plain: set[str] = set()
+    site_types: dict[int, set[str]] = {}
+    site_ok: dict[int, set[str]] = {}
+    site_no: dict[int, set[tuple[str, str]]] = {}
+    ok: set[str] = set()
+    no: set[tuple[str, str]] = set()
+    complete = True
+    for token in tokens:
+        if not token.startswith("@"):
+            plain.add(token)
+            continue
+        head, bang, fact = token[1:].partition("!")
+        if not bang:
+            head, _, type_name = token[1:].partition(":")
+            if head.isdigit() and type_name:
+                site_types.setdefault(int(head), set()).add(type_name)
+            continue
+        line = int(head) if head.isdigit() else None
+        if head and line is None:
+            continue
+        if fact == "truncated":
+            complete = False
+        elif fact.startswith("ok="):
+            if line is None:
+                ok.add(fact[3:])
+            else:
+                site_ok.setdefault(line, set()).add(fact[3:])
+        elif fact.startswith("no="):
+            mode, _, why = fact[3:].partition("=")
+            if line is None:
+                no.add((mode, why))
+            else:
+                site_no.setdefault(line, set()).add((mode, why))
+    lines = set(site_types) | set(site_ok) | set(site_no)
+    sites = {
+        line: SiteView(
+            frozenset(site_types.get(line, ())),
+            frozenset(site_ok.get(line, ())),
+            tuple(sorted(site_no.get(line, ()))),
+        )
+        for line in lines
+    }
+    return Codomain(frozenset(plain), sites, frozenset(ok), tuple(sorted(no)), complete)
+
+
+def premised_modes(codomain: Codomain) -> tuple[str, ...]:
+    """Every return-site premised mode some site admits, in a deterministic order (the order of
+    ``Wesker.mu_minus.VALUE_MODE_BASES``, then the parameter)."""
+    order = {base: i for i, base in enumerate(_mu.VALUE_MODE_BASES)}
+    found = {mode for site in codomain.sites.values() for mode in site.ok}
+    return tuple(
+        sorted(found, key=lambda m: (order.get(_mu.mode_base(m), len(order)), m))
+    )
+
+
+def call_modes(codomain: Codomain) -> tuple[str, ...]:
+    """The Form B modes about the call (an injected raise, an extra write) the observation admits."""
+    return tuple(sorted(codomain.ok))
+
+
+def withheld_here(codomain: Codomain) -> tuple[str, ...]:
+    """What THIS function's observation withheld, named: each premise that was measured and failed,
+    and each operator whose premise the function never offered (``unbuilt``, per function)."""
+    out: list[str] = []
+    if not codomain.complete:
+        out.append(
+            "every premised operator: the observation is incomplete (a test was cut)"
+        )
+    elif not codomain.sites and not codomain.ok and not codomain.no:
+        out.append(
+            "every premised operator (dict swap, ctype to or from a set, field, class, clamp, "
+            "raise-inject, state-extra): "
+            + (
+                "the observation carries type names only, no values"
+                if codomain.plain
+                else "no return was observed"
+            )
+        )
+    for line in sorted(codomain.sites):
+        for mode, why in codomain.sites[line].no:
+            out.append(f"{mode} (return at line {line}): {why}")
+    out.extend(f"{mode}: {why}" for mode, why in codomain.no)
+    return tuple(out)
+
+
+# ── Value state: what an argument looks like, to tell whether a call mutated it ────────────────
+
+
+def state_signature(value: Any) -> Any:
+    """A structural fingerprint of ``value``, equal before and after a call exactly when the call did
+    not write to it (to the depth and size bounds). Containers and plain objects are walked; anything
+    else is its type and identity, so replacing it still shows."""
+    budget = [SIGNATURE_BUDGET]
+    return _signature(value, SIGNATURE_DEPTH, set(), budget)
+
+
+def _signature(value: Any, depth: int, path: set[int], budget: list[int]) -> Any:
+    budget[0] -= 1
+    kind = type(value)
+    if budget[0] < 0:
+        return ("budget",)
+    if value is None or kind in (bool, int, str, bytes, range):
+        return (kind.__name__, value)
+    if kind in (float, complex):
+        return (kind.__name__, repr(value))
+    if id(value) in path:
+        return ("cycle", kind.__name__)
+    if depth <= 0:
+        return ("opaque", kind.__name__, id(value))
+    path.add(id(value))
+    try:
+        if kind in (list, tuple) or kind.__name__ == "deque":
+            return (
+                kind.__name__,
+                tuple(_signature(x, depth - 1, path, budget) for x in value),
+            )
+        if kind is dict:
+            return (
+                "dict",
+                tuple(
+                    (
+                        _signature(k, depth - 1, path, budget),
+                        _signature(v, depth - 1, path, budget),
+                    )
+                    for k, v in value.items()
+                ),
+            )
+        if kind in (set, frozenset, bytearray):
+            return (
+                kind.__name__,
+                tuple(
+                    sorted(repr(_signature(x, depth - 1, path, budget)) for x in value)
+                ),
+            )
+        attrs = getattr(value, "__dict__", None)
+        if type(attrs) is dict:
+            return ("object", kind.__name__, _signature(attrs, depth - 1, path, budget))
+        return ("opaque", kind.__name__, id(value))
+    finally:
+        path.discard(id(value))
+
+
+# ── The observer ────────────────────────────────────────────────────────────────────────────────
+
+
+@dataclass
+class _Site:
+    """What one return site has shown so far."""
+
+    types: set[str] = field(default_factory=set)
+    returns: int = 0
+    truncated: bool = False
+    offered: dict[str, int] = field(default_factory=dict)
+    succeeded: dict[str, int] = field(default_factory=dict)
+    changed: set[str] = field(default_factory=set)
+    failed: dict[str, str] = field(default_factory=dict)
+    kinds: set[str] = field(default_factory=set)
+    low: Any = None
+    high: Any = None
+
+
+@dataclass
+class _Argument:
+    """What one parameter has shown across the calls."""
+
+    calls: int = 0
+    supported: int = 0
+    mutated: bool = False
+
+
+class _Observer:
+    """The accumulator the three monitoring callbacks write to."""
+
+    def __init__(self, code: CodeType) -> None:
+        self.code = code
+        self.positions = list(code.co_positions())
+        self.sites: dict[int, _Site] = {}
+        self.params = code.co_varnames[: code.co_argcount + code.co_kwonlyargcount]
+        self.arguments: dict[str, _Argument] = {p: _Argument() for p in self.params}
+        self.pending: dict[int, dict[str, tuple[Any, Any]]] = {}
+        self.calls = 0
+        self.calls_truncated = False
+        self.raised_ok: set[str] = set()
+        self.raised_no: dict[str, str] = {}
+
+    def _line(self, offset: int) -> int:
+        index = offset // 2
+        if 0 <= index < len(self.positions):
+            return self.positions[index][0] or 0
+        return 0
+
+    def on_start(
+        self, _code: CodeType, _offset: int, frame: Any = None, **_k: Any
+    ) -> None:
+        if frame is None:
+            return
+        if self.calls >= MAX_CALLS_OBSERVED:
+            self.calls_truncated = True
+            return
+        self.calls += 1
+        locals_ = frame.f_locals
+        signatures: dict[str, tuple[Any, Any]] = {}
+        for param in self.params:
+            arg = locals_.get(param)
+            self.arguments[param].calls += 1
+            if _mu.extra_write_supported(arg):
+                self.arguments[param].supported += 1
+                # The OBJECT is kept, not the name: the body may rebind the name to another object.
+                signatures[param] = (arg, state_signature(arg))
+        self.pending[id(frame)] = signatures
+
+    def _settle(self, frame: Any, returned: bool) -> None:
+        signatures = self.pending.pop(id(frame), None)
+        if signatures is None or not returned:
+            return
+        for param, (arg, before) in signatures.items():
+            if state_signature(arg) != before:
+                self.arguments[param].mutated = True
+
+    def on_return(
+        self, _code: CodeType, offset: int, retval: Any, frame: Any = None, **_k: Any
+    ) -> None:
+        if frame is not None:
+            self._settle(frame, True)
+        site = self.sites.setdefault(self._line(offset), _Site())
+        site.returns += 1
+        site.types.add(type(retval).__name__)
+        if site.returns > MAX_RETURNS_PER_SITE:
+            site.truncated = True
+            return
+        try:
+            offered = _mu.candidate_modes(retval)
+        # BLE001: a value whose own attributes raise offers nothing; it is not a fault of the target
+        except Exception:  # noqa: BLE001
+            offered = []
+        for mode in offered:
+            site.offered[mode] = site.offered.get(mode, 0) + 1
+            try:
+                out = _mu.apply_value_mode(mode, retval)
+            # BLE001: the attempt IS the premise; the exception's type is the reason it failed
+            except Exception as exc:  # noqa: BLE001
+                site.failed.setdefault(mode, type(exc).__name__)
+                continue
+            site.succeeded[mode] = site.succeeded.get(mode, 0) + 1
+            if _differs(out, retval):
+                site.changed.add(mode)
+        kind = _mu.bound_kind(retval)
+        if kind:
+            site.kinds.add(kind)
+        elif type(retval) in (float, decimal.Decimal):
+            site.kinds.add("-nonfinite")
+        else:
+            site.kinds.add(f"-{type(retval).__name__}")
+        if kind:
+            try:
+                if site.low is None or retval < site.low:
+                    site.low = retval
+                if site.high is None or retval > site.high:
+                    site.high = retval
+            except TypeError:
+                site.kinds.add("-unordered")
+
+    def on_unwind(
+        self,
+        _code: CodeType,
+        _offset: int,
+        exc: BaseException,
+        frame: Any = None,
+        **_k: Any,
+    ) -> None:
