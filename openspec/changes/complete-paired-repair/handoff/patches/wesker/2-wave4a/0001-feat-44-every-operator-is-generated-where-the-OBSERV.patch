+def observe_codomain(
+    original: Callable[..., Any] | None,
+    tests: list[Callable[..., None]],
+    *,
+    func_node: ast.AST | None = None,
+    per_test_ms: float = 5000.0,
+    deadline: float | None = None,
+) -> frozenset[str]:
+    """Run ``tests`` against ``original`` and return the observed codomain (the token set above).
+
+    Each test runs once, under the engine's own bounded runner. A test that is cut (a wall, a loop
+    budget, an uncontained worker) makes the observation INCOMPLETE: the result is then only
+    ``@!truncated``, because a codomain missing what the cut test would have returned licenses no
+    type-conditional perturbation. A test that merely FAILS on the original is not a cut: what it
+    returned before failing was returned. Generators have no return value to observe and give the
+    empty observation."""
