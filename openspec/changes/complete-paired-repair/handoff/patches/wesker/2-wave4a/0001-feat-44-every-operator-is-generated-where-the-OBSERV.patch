+"""μ⁻ operators are generated where the OBSERVED codomain licenses them, per return site (Wesker #44).
+
+Intent tests authored from docs/theory/NEGATIVE_SPECIFICATION.md, Def. 11.8 (the 38 operators),
+Def. 11.10 (Fork 2: generate a perturbation only where the observed codomain guarantees it applies, so
+it never raises and never mis-attributes) and Prop. 11.14.
+
+THE DEFECTS (#44, AC1 and AC2, and the surface the unbuilt operators never reached).
+- ``run_function_profiling`` had no ``two_sign`` argument. Two-sign was a property of the CATEGORIES a
+  caller happened to pass, and the observed codomain was a bare set of type names that only Detective
+  could harvest.
+- Typing was by the FUNCTION's observed codomain, not the return site. ``tag(n)`` returns "pos" on one
+  branch and None on the other; a test that reaches only the first observes ``{str}``, and the
+  ``return None`` no test ran got four rewrites (truncate, swapcase, pad, reverse), each of which
+  raises on None.
+- ``negative_policy.unbuilt`` was hashed into the two-sign policy id but was not a field of
+  ``MutationPolicy``, so no consumer could read or name what a two-sign receipt did not measure.
+
+WHAT MUST HOLD.
+- ``two_sign=True`` puts OUTPUT in the run and OBSERVES the codomain when the caller supplied none.
+- A return statement the baseline never executed has no observed codomain: only the always-applicable
+  modes reach it. A statement that returned a str gets the str rewrites.
+- An observation that is incomplete (a test was cut) licenses nothing type-conditional or premised.
+- ``MutationPolicy.unbuilt`` is a field: None for the one-sign policy (no μ⁻ member), and for the
+  two-sign policy exactly the catalog's partial and unsupported operators.
+- What a function's own values did not admit is named per function, in the profile result.
+"""
+
+from __future__ import annotations
+
+import dataclasses
+import sys
+
+import pytest
+from _mu_support import load, mode_lines, node_of, observe, output_mutants, unload
+
+from Wesker.codomain import (
+    clamp_standing,
+    extra_write_standing,
+    parse_codomain,
+    raise_standing,
+    withheld_here,
+)
+from Wesker.engine import (
+    MutationCategory,
+    estimate_universe_size,
+    generate_mutants,
+    run_function_profiling,
+    site_mode_standing,
+)
+from Wesker.mu_minus import MU_MINUS_CATALOG
+from Wesker.policy import mutation_policy
+
+_TAG = """
+def tag(n):
+    if n > 0:
+        return "pos"
+    return None
+"""
+
+_STR_REWRITES = {"return_truncate", "return_swapcase", "return_pad", "return_reverse"}
+
+
+@pytest.fixture
+def tag(tmp_path):
+    module, path = load(tmp_path, "mu_obs_tag", _TAG)
+    yield module, path
+    unload("mu_obs_tag")
+
+
+def _only_the_str_branch(module):
+    def t():
+        assert module.tag(1) == "pos"
+
+    return [t]
+
+
+def test_a_return_site_is_typed_by_its_own_observed_values(tag):
+    # AC2: the str branch is observed, the None branch is not. Before, both statements got the four
+    # str rewrites, because the FUNCTION's observed set was {str}.
+    module, path = tag
+    observed = observe(module, path, "tag", _only_the_str_branch(module))
+    modes = mode_lines(path, "tag", observed)
+    str_sites = {line for mode, line in modes if mode in _STR_REWRITES}
+    assert str_sites == {4}, "only the executed `return 'pos'` is rewritten as a str"
+    # Fork 1 still reaches both statements: it is total on any value, so no observation gates it.
+    const_sites = {line for mode, line in modes if mode == "return_const"}
+    assert const_sites == {4, 5}
+
+
+def test_the_function_wide_type_set_is_what_made_the_unexecuted_return_a_target(tag):
+    # The defect, reproduced through the legacy observation (type names only, no site information),
+    # which still means what it always meant: every return site is typed by the function's set.
+    _module, path = tag
+    legacy = frozenset({"str"})
+    by_line: dict[int, set[str]] = {}
+    for mode, line in mode_lines(path, "tag", legacy):
+        if mode in _STR_REWRITES:
+            by_line.setdefault(line, set()).add(mode)
+    assert set(by_line) == {4, 5}, (
+        "the legacy observation typed the unexecuted return too"
+    )
+
+
+def test_both_branches_observed_each_site_answers_for_its_own_values(tag):
+    module, path = tag
+
+    def both():
+        assert module.tag(1) == "pos"
+        assert module.tag(-1) is None
+
+    observed = observe(module, path, "tag", [both])
+    sites = parse_codomain(observed).sites
+    assert sites[4].types == {"str"} and sites[5].types == {"NoneType"}
+    str_lines = {
+        line
+        for mode, line in mode_lines(path, "tag", observed)
+        if mode in _STR_REWRITES
+    }
+    assert str_lines == {4}, (
+        "the None site never gets a str rewrite: it would raise there"
+    )
+
+
+def test_site_mode_standing_names_every_state():
+    # The pure decision, every row (#44 AC2).
+    assert site_mode_standing(False, False, [], ["str"]) == "function_wide"
+    assert site_mode_standing(False, True, ["int"], ["str"]) == "function_wide"
+    assert site_mode_standing(True, False, [], ["str"]) == "unobserved"
+    assert site_mode_standing(True, True, ["str"], ["str", "bytes"]) == "applies"
+    assert site_mode_standing(True, True, ["str", "int"], ["str"]) == "type_outside"
+    assert site_mode_standing(True, True, [], ["str"]) == "type_outside"
+
+
+def test_an_incomplete_observation_licenses_nothing_but_the_always_applicable_modes(
+    tag,
+):
+    _module, path = tag
+    cut = frozenset({"@!truncated"})
+    assert not parse_codomain(cut).complete
+    modes = set(output_mutants(path, "tag", cut))
+    assert not modes & _STR_REWRITES
+    assert {"return_none", "return_const", "return_identity", "return_stale"} <= modes
+    # ...and is named, never silently empty.
+    assert any("incomplete" in line for line in withheld_here(parse_codomain(cut)))
+
+
+def test_a_legacy_observation_says_it_carries_no_values():
+    named = withheld_here(parse_codomain(frozenset({"int"})))
+    assert len(named) == 1 and "type names only" in named[0]
+    nothing = withheld_here(parse_codomain(frozenset()))
+    assert len(nothing) == 1 and "no return was observed" in nothing[0]
+
+
+def test_unknown_tokens_are_ignored_and_known_ones_round_trip():
+    tokens = frozenset(
+        {
+            "int",
+            "@7:int",
+            "@7!ok=return_clamp@i1,i2",
+            "@7!no=return_swap_items=TypeError",
+            "@!ok=state_extra@xs",
+            "@!no=raise_inject=none",
+            "@zz:oops",
+            "@!bogus",
+            "@7!bogus",
+        }
+    )
+    cod = parse_codomain(tokens)
+    assert cod.plain == {"int"} and cod.complete
+    assert cod.sites[7].types == {"int"}
+    assert cod.sites[7].ok == {"return_clamp@i1,i2"}
+    assert cod.sites[7].no == (("return_swap_items", "TypeError"),)
+    assert cod.ok == {"state_extra@xs"} and cod.no == (("raise_inject", "none"),)
+
+
+def test_count_equals_generation_under_a_site_observation(tag):
+    module, path = tag
+
+    def both():
+        assert module.tag(1) == "pos"
+        assert module.tag(-1) is None
+
+    for tests in ([both], _only_the_str_branch(module)):
+        observed = observe(module, path, "tag", tests)
+        node = node_of(path, "tag")
+        muts = generate_mutants(
+            node,
+            {MutationCategory.OUTPUT},
+            max_per_category=0,
+            observed_return_types=observed,
+        )
+        assert len(muts) == estimate_universe_size(
+            node, {MutationCategory.OUTPUT}, observed=observed
+        )
+
+
+def test_a_generator_has_no_return_value_to_observe(tmp_path):
+    module, path = load(tmp_path, "mu_obs_gen", "def g(n):\n    yield n\n")
+    try:
+
+        def t():
+            assert list(module.g(2)) == [2]
+
+        assert observe(module, path, "g", [t]) == frozenset()
+    finally:
+        unload("mu_obs_gen")
+
+
+def test_a_failing_baseline_test_is_not_a_cut_observation(tmp_path):
+    # What a test returned before it failed WAS returned; only a wall or a loop budget makes the
+    # observation incomplete.
+    module, path = load(tmp_path, "mu_obs_red", "def f(x):\n    return x + 1\n")
+    try:
+
+        def red():
+            assert module.f(1) == 99
+
+        observed = observe(module, path, "f", [red])
+        assert parse_codomain(observed).complete
+        assert parse_codomain(observed).sites[2].types == {"int"}
+    finally:
+        unload("mu_obs_red")
+
+
+# ── run_function_profiling(two_sign=True) ───────────────────────────────────────────────────────
+
+
+def _profile(module, path, name, tests, **kwargs):
+    return run_function_profiling(
+        node_of(path, name),
+        f"{path}::{name}",
+        kwargs.pop("categories", set()),
+        tests,
+        getattr(module, name),
+        scope_tests=False,
+        **kwargs,
+    )
+
+
+def test_two_sign_adds_the_output_category_and_observes_the_codomain(tag):
+    module, path = tag
+
+    def t():
+        assert module.tag(1) == "pos"
+
+    one = _profile(module, path, "tag", [t])
+    assert one.total_mutants == 0 and not one.observed_codomain
+
+    two = _profile(module, path, "tag", [t], two_sign=True)
+    assert two.total_mutants > 0
+    assert {cr.category for cr in two.per_category} == {MutationCategory.OUTPUT}
+    # The observation the mutants were generated under travels with the result.
+    assert "@4:str" in two.observed_codomain
+    d = two.to_dict()
+    assert d["observed_codomain"] == list(two.observed_codomain)
+    assert d["mu_minus_withheld"] == list(two.mu_minus_withheld)
+    # The policy's own unbuilt operators travel with the profile, beside what THIS function withheld.
+    assert d["mu_minus_unbuilt"] == mutation_policy(two_sign=True).unbuilt == {}
+    assert "observed_codomain" not in one.to_dict(), (
+        "no OUTPUT operator ran: nothing to report"
+    )
+
+
+def test_two_sign_keeps_an_observation_the_caller_supplied(tag):
+    module, path = tag
