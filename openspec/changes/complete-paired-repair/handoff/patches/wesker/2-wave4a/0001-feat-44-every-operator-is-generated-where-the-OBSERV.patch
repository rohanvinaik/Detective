new file mode 100644
index 0000000..b40b0e2
--- /dev/null
+++ b/tests/_mu_support.py
@@ -0,0 +1,88 @@
+"""Shared fixtures for the μ⁻ premise intent tests (#44; Detective #120–#123).
+
+A target is written to a file and imported, so its AST carries the same absolute line numbers the
+baseline run reports for its return statements: that is what makes the per-return-site observation
+line up with the mutator the way a real run does.
+"""
+
+from __future__ import annotations
+
+import ast
+import importlib.util
+import sys
+import textwrap
+
+from Wesker.codomain import observe_codomain
+from Wesker.engine import MutationCategory, evaluate_mutant, generate_mutants
+
+
+def load(tmp_path, name: str, src: str):
+    """Write ``src`` to ``tmp_path/name.py``, import it as ``name``; return ``(module, path)``."""
+    path = tmp_path / f"{name}.py"
+    path.write_text(textwrap.dedent(src))
+    spec = importlib.util.spec_from_file_location(name, str(path))
+    module = importlib.util.module_from_spec(spec)
+    sys.modules[name] = module
+    spec.loader.exec_module(module)
+    return module, str(path)
+
+
+def unload(name: str) -> None:
+    sys.modules.pop(name, None)
+
+
+def node_of(path: str, name: str):
+    """The function ``name`` parsed from the FILE, so its lines are the file's own."""
+    with open(path, encoding="utf-8") as handle:
+        tree = ast.parse(handle.read())
+    return next(
+        n
+        for n in ast.walk(tree)
+        if isinstance(n, (ast.FunctionDef, ast.AsyncFunctionDef)) and n.name == name
+    )
+
+
+def observe(module, path: str, name: str, tests) -> frozenset[str]:
+    """The observed codomain of ``module.<name>`` over ``tests``."""
+    return observe_codomain(getattr(module, name), tests, func_node=node_of(path, name))
+
+
+def output_mutants(path: str, name: str, observed: frozenset[str] | None):
+    """Every OUTPUT mutant generated for the function under ``observed``, as ``{sub-mode: [mutants]}``
+    (``return_field_drop@x``, ``raise_inject@builtins.ValueError``): the name of a mode, never its id.
+    A mode that applies at several return sites lists one mutant per site."""
+    muts = generate_mutants(
+        node_of(path, name),
+        {MutationCategory.OUTPUT},
+        max_per_category=0,
+        observed_return_types=observed,
+    )
+    out: dict[str, list] = {}
+    for m in muts:
+        out.setdefault(m.dimension.split(":")[1], []).append(m)
+    return out
+
+
+def mode_lines(
+    path: str, name: str, observed: frozenset[str] | None
+) -> set[tuple[str, int]]:
+    """``{(sub-mode, line)}`` of every OUTPUT mutant generated: which mode fires at which line."""
+    return {
+        (mode, m.mutated_line)
+        for mode, ms in output_mutants(path, name, observed).items()
+        for m in ms
+    }
+
+
+def one(path: str, name: str, observed: frozenset[str] | None, mode: str):
+    """The single mutant of ``mode`` (the function has one site for it)."""
+    found = output_mutants(path, name, observed)[mode]
+    assert len(found) == 1, (mode, len(found))
+    return found[0]
+
+
+def run(mutant, tests, module, path: str, name: str):
+    """The mutant evaluated against ``tests`` the way the engine evaluates it."""
+    return evaluate_mutant(
+        mutant, tests, getattr(module, name), qualname=name, source_path=path
+    )
