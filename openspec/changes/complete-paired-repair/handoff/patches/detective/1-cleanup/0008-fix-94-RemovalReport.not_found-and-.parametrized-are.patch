--- a/tests/test_removal_identity_intent.py
+++ b/tests/test_removal_identity_intent.py
@@ -209,3 +209,23 @@ def test_a_row_suffix_alone_is_not_resolution():
     ident = "tests/t.py::test_foo[case]"
     assert ident.split("[", 1)[0] != "test_foo"
     assert nodeid_function_name(ident) == "test_foo"
+
+
+def test_not_found_and_parametrized_are_views_of_the_one_record_of_outcomes() -> None:
+    """#94: `not_found` and `parametrized` were stored copies of what `outcomes` already says, so a report
+    built with one disagreeing with the other was possible. They are now computed from `outcomes`."""
+    from Detective.suite_edit import RemovalReport
+
+    report = RemovalReport(
+        removed=("a.py::test_x",),
+        files_changed=("a.py",),
+        outcomes=(
+            ("a.py::test_x", "removed"),
+            ("a.py::test_y", "not_located"),
+            ("a.py::test_z[1]", "parametrized_row"),
+            ("a.py::test_w", "ambiguous"),
+        ),
+    )
+    assert report.parametrized == ("a.py::test_z[1]",)
+    assert report.not_found == ("a.py::test_y", "a.py::test_w")
+    assert RemovalReport(removed=(), files_changed=()).not_found == ()
