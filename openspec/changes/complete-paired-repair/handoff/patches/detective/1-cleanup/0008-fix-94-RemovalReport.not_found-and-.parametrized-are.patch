 Detective/suite_edit.py                | 25 ++++++++++++++++---------
 tests/test_field_consumption_intent.py | 12 +-----------
 tests/test_removal_identity_intent.py  | 20 ++++++++++++++++++++
 3 files changed, 37 insertions(+), 20 deletions(-)

diff --git a/Detective/suite_edit.py b/Detective/suite_edit.py
index ba510c1..a214a25 100644
--- a/Detective/suite_edit.py
+++ b/Detective/suite_edit.py
@@ -114,16 +114,25 @@ class RemovalReport:
     """Outcome of applying deletions: what was removed and from where."""
 
     removed: tuple[str, ...]  # ids whose OWN definition was deleted (exact, never by bare name)
-    not_found: tuple[str, ...]  # ids kept for any reason but being a row; each has its cause in `outcomes`
     files_changed: tuple[str, ...]  # files rewritten
-    # Bracketed names (test_x[case]) — ROWS of a live parametrized test. Removal
-    # works at function granularity: deleting the function to prune a row would
-    # take the live rows with it, so these are never attempted, only reported.
-    parametrized: tuple[str, ...] = ()
     # (id, code) for EVERY requested id — `removal_disposition`'s codes plus the edit's own
-    # "removed" / "stale_collection" / "shadowed" — so no id is reported without its cause (#103).
+    # "removed" / "stale_collection" / "shadowed" — so no id is reported without its cause (#103). The ONE
+    # record: `not_found` and `parametrized` are views of it, not second copies that could disagree (#94).
     outcomes: tuple[tuple[str, str], ...] = ()
 
+    @property
+    def not_found(self) -> tuple[str, ...]:
+        """The ids kept for any reason but being a row of a live parametrized test; each has its cause in
+        `outcomes`. Sorted, as the ids of `outcomes` are."""
+        return tuple(i for i, c in self.outcomes if c not in ("removed", "parametrized_row"))
+
+    @property
+    def parametrized(self) -> tuple[str, ...]:
+        """Bracketed names (test_x[case]) — ROWS of a live parametrized test. Removal works at function
+        granularity: deleting the function to prune a row would take the live rows with it, so these are
+        never attempted, only reported."""
+        return tuple(i for i, c in self.outcomes if c == "parametrized_row")
+
 
 def file_digest(path: str) -> str:
     """The sha256 of a file's bytes — the basis a removal is proposed against and checked against (#104).
@@ -494,6 +503,4 @@ def apply_removals(
             atomic_write_text(path, source)
             changed.append(path)
     removed = tuple(sorted(i for i, c in outcomes.items() if c == "removed"))
-    rows = tuple(sorted(i for i, c in outcomes.items() if c == "parametrized_row"))
-    kept = tuple(sorted(i for i, c in outcomes.items() if c not in ("removed", "parametrized_row")))
-    return RemovalReport(removed, kept, tuple(changed), rows, tuple(sorted(outcomes.items())))
+    return RemovalReport(removed, tuple(changed), tuple(sorted(outcomes.items())))
