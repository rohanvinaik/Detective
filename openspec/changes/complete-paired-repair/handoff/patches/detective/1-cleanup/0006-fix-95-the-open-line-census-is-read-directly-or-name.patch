+# ---------------------------------- not_consulted_dynamic, not_consulted, missing_line_standings (census)
+
+
+def test_a_profile_that_carries_no_dynamic_census_is_named_absent_and_never_empty() -> None:
+    from Detective.audit import CENSUS_ABSENT, dynamic_census, missing_line_standing, profile_dynamic_census
+
+    assert dynamic_census(None) == [CENSUS_ABSENT]
+    assert dynamic_census([]) == [], "a census that was taken and found nothing is empty, and is not absent"
+    assert dynamic_census(["t.py::test_a"]) == ["t.py::test_a"]
+    assert profile_dynamic_census(types.SimpleNamespace()) == [CENSUS_ABSENT]
+    assert profile_dynamic_census(types.SimpleNamespace(not_consulted_dynamic=())) == []
+    # the absent census must not let a line nothing runs read as plainly uncovered
+    assert (
+        missing_line_standing(5, {}, [], [], profile_dynamic_census(types.SimpleNamespace())) == "unconsulted"
+    )
+    assert missing_line_standing(
+        5, {}, [], [], profile_dynamic_census(types.SimpleNamespace(not_consulted_dynamic=()))
+    ) == ("unexecuted")
+
+
+def test_the_page_says_could_not_determine_for_an_absent_census_and_names_a_taken_one() -> None:
+    from Detective.audit import CENSUS_ABSENT
+    from Detective.cli import _not_consulted_dynamic_rows
+
+    absent = "\n".join(_not_consulted_dynamic_rows([CENSUS_ABSENT]))
+    assert "could not determine" in absent and "no census" in absent
+    assert _not_consulted_dynamic_rows(()) == []
+    assert "t.py::test_a" in "\n".join(_not_consulted_dynamic_rows(["t.py::test_a"]))
+
+
+def test_a_cached_profile_without_a_census_comes_back_without_one() -> None:
+    """Absence survives the verdict cache: a result that carried no census stores none and restores none;
+    the old round trip turned it into an empty census (a clean answer)."""
+    from Wesker.engine import ProfilingResult
+
+    from Detective.verdict_cache import _from_json, _to_json
+
+    bare = ProfilingResult()
+    restored = _from_json(_to_json(bare))
+    assert not hasattr(restored, "not_consulted_dynamic")
+    bare.not_consulted_dynamic = ("t.py::test_a",)  # type: ignore[attr-defined]
+    assert _from_json(_to_json(bare)).not_consulted_dynamic == ("t.py::test_a",)
+    bare.not_consulted_dynamic = ()  # type: ignore[attr-defined]
+    assert _from_json(_to_json(bare)).not_consulted_dynamic == ()
