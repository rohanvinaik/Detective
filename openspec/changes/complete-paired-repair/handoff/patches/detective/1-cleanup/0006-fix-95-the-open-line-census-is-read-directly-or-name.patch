index 389e8d5..0470b8e 100644
--- a/Detective/audit.py
+++ b/Detective/audit.py
@@ -36,6 +36,7 @@ from Wesker.ci import walk_functions
 from Wesker.monitoring import MonitoringUnavailable
 
 from .engine import FunctionBasis, classify_survivors, function_basis, profile
+from .faults import ABSENT, reading
 from .line_flags import classify_missing_lines, load_line_flags
 from .minimize import (
     _obligations_by_test,
@@ -608,6 +609,33 @@ def function_untyped_tests(
     )
 
 
+# What a census of the tests not consulted because they dispatch dynamically (#107, #77) holds if the profile
+# carries NO census: not "no test", which would read as clean, but this named state, which a page renders as
+# "could not determine" and which keeps a line no test runs from being called plainly uncovered.
+CENSUS_ABSENT = "absent:not_consulted_dynamic"
+
+
+def dynamic_census(ids: list[str] | None) -> list[str]:
+    """The not-consulted-dynamic census a profile supplies, or its named absence (#95, pure — pinned).
+
+    ``None`` is a profile that carries no census (`profile` never routed it, or a cached row written before
+    the census existed): the answer is ``[CENSUS_ABSENT]``, one entry that is truthy so
+    `missing_line_standing` reads a line nothing runs as ``unconsulted`` and not ``unexecuted``, and that a
+    page names. A list, empty or not, is a census that was taken and is returned as it is. The split exists
+    because `missing_line_standing` and the page both took ``()`` for "absent", which is a clean answer.
+    """
+    if ids is None:
+        return [CENSUS_ABSENT]
+    return list(ids)
+
+
+def profile_dynamic_census(result: Any) -> list[str]:
+    """`dynamic_census` over a profile: Detective stashes the census on the result, so it is read
+    three-valued and an absent stash is handed to the decision as ``None``."""
+    stashed = reading(result, "not_consulted_dynamic")
+    return dynamic_census(None if stashed is ABSENT else list(stashed))
+
+
 def missing_line_standing(
     line: int,
     line_coverage: dict[str, list[int]],
@@ -1257,13 +1285,13 @@ def audit_suite(
                     result.line_coverage,
                     list(_failing),
                     list(_errored),
-                    list(getattr(result, "not_consulted_dynamic", ()) or ()),
+                    profile_dynamic_census(result),
                     list(baseline_unobserved_reach(result)),
                 ),
             )
             for ln in missing
         ),
-        not_consulted_dynamic=tuple(getattr(result, "not_consulted_dynamic", ()) or ()),
+        not_consulted_dynamic=tuple(profile_dynamic_census(result)),
         unobserved_reach=tuple(sorted(baseline_unobserved_reach(result).items())),
         manually_unreachable=len(manually_unreachable),
         contradicted_line_flags=contradicted_flags,
