         return (
             "a test written for this function fails on current code — decide whether the TEST or the "
@@ -2283,7 +2283,7 @@ def _final_banner_status(result) -> str:
     # A floor that does not hold (#114) disowns the verdict too, and names a different remedy: a test
     # that is this function's business fails on current code, so converge wrote nothing over it.
     # Ranked as `certificate_standing` ranks it — below an invalid measurement, above UNVERIFIED.
-    _floor = tuple(getattr(result, "floor_failing_tests", ()) or ())
+    _floor = tuple(result.floor_failing_tests)
     if _floor:
         _more = f" (+{len(_floor) - 1} more)" if len(_floor) > 1 else ""
         # The run that found the failing floor was measured under a receiver/capability set too, and
@@ -2862,7 +2862,7 @@ def _format_converge(
         val_line,
         f"  every-killable-killed={result.functionally_complete}  line-complete={result.line_complete}",
     ]
-    if floor := tuple(getattr(result, "floor_failing_tests", ()) or ()):
+    if floor := tuple(result.floor_failing_tests):
         # #114: named in the archive as on the page, so `--full`, the report file and `--json` agree.
         lines.append(f"  ⚠ FAILING NOW — fail on current code: {_first_n(floor, 8)}")
     lines += _engine_owned_rows(result.engine_ownership)
@@ -2964,7 +2964,7 @@ def _format_converge(
                 f"  spec-completeness: {free} · ≈{pr} more pass{'es' if pr != 1 else ''} "
                 "to complete (greedy bulk decay)"
             )
-        elif getattr(result, "floor_failing_tests", ()):
+        elif result.floor_failing_tests:
             # #114/#139: nothing was synthesized over a failing floor, so the residual is not I_solve.
             # No input finishes it before that test or the code is fixed.
             lines.append(f"  spec-completeness: {free} · not synthesized — a failing test holds the floor")
@@ -3195,7 +3195,7 @@ def _format_converge_terse(
     _ending_code = (
         decision.code if decision is not None else _converge_routing(result, rep, session_reason)[1]
     )
-    floor = tuple(getattr(result, "floor_failing_tests", ()) or ())
+    floor = tuple(result.floor_failing_tests)
     if floor:
         # First, always (#114), as audit's FAILING NOW is: the suite disagrees with the code RIGHT NOW,
         # so converge wrote nothing, and every count below describes a suite that does not pass.
@@ -4054,7 +4054,7 @@ def _floor_caused(result) -> bool:
     `original_also_fails` over the floor it is caused by while the standing ranks it beneath.
     """
     reasons = tuple(getattr(result, "validity_cut_reasons", None) or getattr(result, "cut_reasons", ()) or ())
-    floor = bool(getattr(result, "floor_failing_tests", ()))
+    floor = bool(result.floor_failing_tests)
     return floor_cause_standing(list(reasons), floor) == "floor_caused"
 
 
@@ -4084,7 +4084,7 @@ def _converge_routing(
         _ver is not None and bool(getattr(_ver, "ok", False)),
         bool(getattr(result, "admits_certificate", True)),
         # The same field `ConvergeResult.standing` consumes (#114), so this reading cannot drift from it.
-        floor_failing=bool(getattr(result, "floor_failing_tests", ())),
+        floor_failing=bool(result.floor_failing_tests),
         floor_caused=_floor_caused(result),
         # The reasons the measurement was refused, so an `ungateable` standing is NAMED when every one
         # is a mutant that reached no verdict (Wesker#27); the same tuple `ConvergeResult.standing` reads.
@@ -5205,7 +5205,7 @@ def _converge_action(
     if kind == "fix_failing_test":
         # The floor does not hold (#114): converge stopped before it synthesized anything, and the
         # remedy is audit's — the same block, from the same renderer.
-        return _failing_test_action(tuple(getattr(result, "floor_failing_tests", ()) or ()), d.then)
+        return _failing_test_action(tuple(result.floor_failing_tests), d.then)
     if kind == "rerun_stale":
         return [
             "STOP:  the target changed while converge measured it — this is NOT a verdict.",
