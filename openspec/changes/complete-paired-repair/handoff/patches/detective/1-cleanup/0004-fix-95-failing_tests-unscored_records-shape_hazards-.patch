+# ------------------- failing_tests, unscored_records, shape_hazards, load_failure (engine results)
+
+
+def test_an_engine_that_reports_neither_failing_tests_nor_unscored_records_is_named_absent() -> None:
+    """The adapter is the capability matrix: an engine without these fields is recorded `absent:<field>`, so
+    the empty detail derived from them is 'nothing reported', and a certificate can say so."""
+    flags = normalize_validity(_wesker_result()).capability_flags
+    for name in ("failing_tests", "unscored_records", "shape_hazards"):
+        assert f"absent:{name}" in flags
+    reported = normalize_validity(_wesker_result(failing_tests=[], unscored_records=[], shape_hazards=()))
+    for name in ("failing_tests", "unscored_records", "shape_hazards"):
+        assert f"absent:{name}" not in reported.capability_flags  # present-empty is not absent
+
+
+def test_a_reported_shape_hazard_reaches_the_validity_and_a_reported_unscored_record_its_detail() -> None:
+    v = normalize_validity(
+        _wesker_result(
+            failing_tests=[],
+            unscored_records=[
+                {"disposition": "not_entered", "mutant_id": "VALUE_1", "cause": "captured_at_import"}
+            ],
+            shape_hazards=({"hazard": "spawns_thread", "test_id": "t.py::test_a"},),
+        )
+    )
+    assert v.shape_hazards == ({"hazard": "spawns_thread", "test_id": "t.py::test_a"},)
+    assert v.not_entered, "a reported unscored record is detailed, not dropped"
+
+
+def test_a_flag_on_a_profile_without_unscored_records_fails_at_the_read() -> None:
+    from Detective.cli import _unscored_flag_refusal
+
+    args = types.SimpleNamespace(mutant_id="VALUE_1", json=False)
+    with pytest.raises(AttributeError, match="unscored_records"):
+        _unscored_flag_refusal(args, types.SimpleNamespace())
+
+
+def test_a_scope_that_cannot_say_whether_the_module_loaded_is_not_read_as_loaded() -> None:
+    from Detective.cli import _diagnose_action
+
+    scope = types.SimpleNamespace(function="m.py::f")
+    spec = types.SimpleNamespace(unspecified_dof=0)
+    with pytest.raises(AttributeError, match="load_failure"):
+        _diagnose_action(scope, spec, False, 0)
