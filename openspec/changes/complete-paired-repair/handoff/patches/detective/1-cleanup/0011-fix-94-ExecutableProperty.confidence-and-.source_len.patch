+def test_a_pins_file_written_before_confidence_and_source_lenses_were_retired_still_loads(tmp_path):
+    """#94: `ExecutableProperty.confidence` and `.source_lenses` were persisted in pins.json and read by
+    nothing, so they were deleted. A store an older Detective wrote still carries both keys per entry; it
+    must load (the pin is the TEST, and the two keys are provenance it never needed), not be skipped as
+    malformed, which would silently drop every remembered pin."""
+    path = pins._store_path(str(tmp_path))
+    os.makedirs(os.path.dirname(path), exist_ok=True)
+    entry = {
+        "category": "VALUE",
+        "setup_code": "from m import f",
+        "assertion_code": "assert f(1) == 2",
+        "preconditions": [],
+        "confidence": 0.9,
+        "source_lenses": ["golden_capture"],
+        "needs_oracle": False,
+        "function_key": _KEY,
+        "mutant_id": "V0",
+        "golden_case": None,
+    }
+    with open(path, "w", encoding="utf-8") as fh:
+        json.dump({pins._entry_key(_KEY, _DIGEST): [entry]}, fh)
+    loaded = pins.load(str(tmp_path), _KEY, _DIGEST)
+    assert [p.assertion_code for p in loaded] == ["assert f(1) == 2"]
+    assert not hasattr(loaded[0], "confidence") and not hasattr(loaded[0], "source_lenses")
+    pins.save(str(tmp_path), _KEY, _DIGEST, loaded)
+    with open(path, encoding="utf-8") as fh:
+        saved = json.load(fh)[pins._entry_key(_KEY, _DIGEST)][0]
+    assert "confidence" not in saved and "source_lenses" not in saved
