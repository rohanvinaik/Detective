+# ------------------------------------------------ the Protocols a type checker reads the fault flags through
+
+
+def test_each_protocol_names_only_fields_its_type_declares() -> None:
+    """The Protocols exist so a type checker sees every direct read (#95). A name a Protocol lists that the
+    real type does not carry would make every `rep.x` read check against a fiction."""
+    import typing
+
+    from Detective.audit import SuiteAudit, SuiteAuditFaults
+    from Detective.converge import ConvergeFaults, ConvergeResult
+    from Detective.equivalence import SurvivorReport, SurvivorReportFaults
+
+    for proto, real in (
+        (ConvergeFaults, ConvergeResult),
+        (SuiteAuditFaults, SuiteAudit),
+        (SurvivorReportFaults, SurvivorReport),
+    ):
+        names = {n for n in vars(proto) if not n.startswith("_")}
+        assert names, f"{proto.__name__} lists nothing"
+        missing = sorted(n for n in names if not hasattr(real, n) and n not in real.__dataclass_fields__)
+        assert not missing, f"{proto.__name__} names fields {real.__name__} does not carry: {missing}"
+        assert typing.get_type_hints  # the Protocols are importable, which the annotations rely on
