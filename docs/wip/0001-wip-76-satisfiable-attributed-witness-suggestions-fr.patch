+    outs, reports = [], []
+    for argv in ((), tuple(flags), ()):
+        outs.append(_cli(project, "converge", target, *argv))
+        reports.append(_report(project, fn))
+    finals = [_final(o) for o in outs]
+    assert finals[0] == finals[1] == finals[2], finals
+    supplied = {_canonical_input(s) for s in inputs}
+    for out, report in zip(outs, reports, strict=True):
+        _no_unsatisfiable_suggestion(out + report)
