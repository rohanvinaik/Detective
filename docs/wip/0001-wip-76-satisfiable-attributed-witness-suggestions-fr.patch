+# --- 6. killable and crash-only are mutually exclusive ---------------------------------------------
+
+
+def test_a_verdict_is_never_both_killable_and_crash_only():
+    class Box:
+        def __init__(self) -> None:
+            self.seen: list = []
+
+    def make_call(raise_on_zero: bool):
+        def call(x):
+            box = Box()
+            call.last_receiver = box
+            if raise_on_zero and x == 0:
+                raise ValueError("zero")
+            box.seen.append(x if not raise_on_zero else -x)
+            return None
+
+        call.last_receiver = None
+        return call
+
+    original, mutant = make_call(False), make_call(True)
+    verdict = classify_survivor("STATE_s", "STATE", "", original, mutant, [(0,), (1,)])
+    assert verdict.killable  # the receiver-state fallback found the state witness at (1,)
+    assert not verdict.crash_only and verdict.crash_witness is None
+    rep = SurvivorReport(verdicts=(verdict,), unclassified=())
+    assert rep.killable == (verdict,) and rep.crash_only == () and rep.candidate_equivalent == ()
