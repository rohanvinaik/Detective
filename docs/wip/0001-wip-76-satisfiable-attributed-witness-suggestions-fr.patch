+def witness_confirmation(
+    first_original: str, first_mutant: str, fresh_original: str, fresh_mutant: str
+) -> str:
+    """Does a value witness REPRODUCE on fresh calls — the calls its test will make (#76, pure — pinned)?
+
+    The search calls the original and then the mutant on ONE argument object, so an original that
+    mutates its argument hands the mutant a different input, and a nondeterministic mutant differs
+    from itself; either way the pair the search saw is not a fact a test can pin. The written test
+    calls the ORIGINAL on fresh literals and asserts what it returned there, and the report prints
+    "mutant gives <X>" — so a witness counts only when a fresh original reproduces the pinned outcome
+    and a fresh mutant reproduces the printed one. Observations compare as strings, so two NaNs are
+    equal (``repr`` is ``nan`` on both sides) and "both NaN" is ``indistinct``, never a witness.
+
+      "confirmed"   the fresh pair is the pair the search saw, and it distinguishes by value
+      "indistinct"  the original reproduced, but fresh calls do not tell the two apart: the search's
+                    "distinction" was an artifact of shared argument state — this input is NOT a
+                    witness (like ``same``), and counting the mutant killable on it is what looped
+      "unstable"    an outcome did not reproduce (or the mutant now raises instead): the input
+                    proves nothing either way — honest uncertainty, never a kill
+      "blocked"     a fresh call timed out (#42)
+    """
+    fresh = _pair_disposition(fresh_original, fresh_mutant)
+    if fresh == "blocked":
+        return "blocked"
+    if fresh_original != first_original:
+        return "unstable"
+    if fresh == "same":
+        return "indistinct"
+    if fresh != "witness" or fresh_mutant != first_mutant:
+        return "unstable"
+    return "confirmed"
+
+
+_IMMUTABLE_SCALARS: tuple[type, ...] = (int, float, complex, str, bytes, bool, type(None))
+
+
+def _all_immutable(value: Any) -> bool:
+    """True when nothing a call does can change ``value`` — scalars, and tuples/frozensets of them."""
+    if isinstance(value, _IMMUTABLE_SCALARS):
+        return True
+    if type(value) in (tuple, frozenset):
+        return all(_all_immutable(v) for v in value)
+    return False
+
+
+def _fresh_args(args: tuple) -> tuple:
+    """A deep copy of ``args`` — the call a written test makes passes its OWN fresh literals, never an
+    object an earlier call has mutated. Immutable arguments (the scalar grids, most of the pool) are
+    returned as they are — no call can change them, so there is nothing to copy. An argument that
+    cannot be copied is passed as it is (the search's own behaviour, so nothing is lost)."""
+    if all(_all_immutable(a) for a in args):
+        return tuple(args)
+    try:
+        return copy.deepcopy(tuple(args))
+    # BLE001: an uncopyable argument (a lock, a live handle) keeps the search's shared-object protocol
+    except Exception:  # noqa: BLE001
