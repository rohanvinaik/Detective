+def test_the_reported_run_sequence_converges_without_a_loop(conservation, tmp_path, fn, inputs):
+    """bare → the reported inputs applied → bare: every FINAL identical (the pinned count does not
+    move under the same inputs), no unsatisfiable assertion, no input re-proposed once supplied, no
+    mutant both killable and crash-only, and the `<= -1`-style VALUE mutant killed by a value inside
