+# --- 5. a witness is a proof only if a fresh call reproduces it ------------------------------------
+
+
+@pytest.mark.parametrize(
+    ("first", "fresh", "code"),
+    [
+        (("1", "2"), ("1", "2"), "confirmed"),
+        (("1", "2"), ("1", "1"), "indistinct"),
