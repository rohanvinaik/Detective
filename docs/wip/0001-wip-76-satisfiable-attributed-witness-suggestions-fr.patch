+        ("None", "result = f(1)\nassert result is None", "inline"),
+        ("nan", "result = f(-1.0, -1)\nassert repr(result) == 'nan'", "bound"),
+        ("1", "result = f(1)\nassert result == 1\nassert type(result) is int", "bound"),
+        ("'result'", "result = f(1)\nassert result == 'result'", "bound"),
+    ],
