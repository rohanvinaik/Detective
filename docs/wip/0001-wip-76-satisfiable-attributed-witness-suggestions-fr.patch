+"""Intent tests for #76 — a suggested witness that cannot distinguish the printed mutant, and the loop.
+
+The report (detective 1.1.1, `spread_ratio(d, p) = math.nan if p <= 0 else d / p`), verbatim:
+
+    value-equivalent, crash-only-distinguishable (2: BOUNDARY, VALUE) — ...
+      → mutant VALUE_8e43bfab [VALUE]: - ... spread_parent_um <= 0 ...  + ... spread_parent_um <= -1 ...
+    killable — SUGGESTED tests (not auto-applied, 1):
+      → assert f(-1.0, -1) == nan   (mutant gives 1.0)
+    FINAL src/cell_tracking/committee/conservation.py::spread_ratio: Incomplete: 1 killable · 9/9 killed
+
+Grounded on current code with the three functions reconstructed as fixtures, what was live:
+
+1. The suggestion never NAMED the mutant it kills. "mutant gives 1.0" belonged to an unprinted
+   `if False:` BOUNDARY mutant; the reader matched it to the printed `<= -1` VALUE mutant, which does
+   NOT give 1.0 at (-1.0, -1) — hence "the witness does not distinguish the printed mutant".
+2. The suggested assertion was `assert f(args) == <original repr>` — `== nan` can never pass, and a
+   raising original printed `== <raised ValueError: …>`, which is not Python.
+3. The `<= -1` VALUE mutant was filed crash-only although every input strictly inside (-1, 0) kills it
+   by value (#71's float interiors now reach it — asserted end to end below).
+4. The loop's guard compared the typed `--input` text with the rendered witness byte-for-byte and only
+   within one run: `(0.1,nan,0.087)` never matched `(0.1, float('nan'), 0.087)`, and the next BARE run
+   — which recalls the stored input — re-proposed the identical `DO THIS --input`.
+5. A witness was never re-checked on FRESH calls — the calls the written test makes — so a distinction
+   produced by shared argument state or a nondeterministic mutant counted as killable.
+6. `killable` and `crash_only` could both be true of one verdict (the receiver-state fallback).
+
+Each test states the promise it holds, written from intent — not from the implementation.
+"""
+
+from __future__ import annotations
+
+import ast
+import copy
+import math
+import re
+import shutil
+import subprocess
+import sys
+import types
+from pathlib import Path
+
+import pytest
+
+from Detective.cli import _canonical_input, _derive_input_plan, _format_survivor_report, suggestion_form
+from Detective.engine import _compile_mutant
+from Detective.equivalence import (
+    MutantVerdict,
+    SurvivorReport,
+    Witness,
+    _search_witness,
+    classify_survivor,
+    witness_confirmation,
+)
+
+# --- fixtures: a function, and a hand-built mutant of it ------------------------------------------
+
+_SPREAD = """
+import math
+def spread_ratio(spread_daughter_um: float, spread_parent_um: float) -> float:
+    return math.nan if spread_parent_um <= 0 else spread_daughter_um / spread_parent_um
+"""
+
+
+def _module(src: str) -> tuple[ast.Module, dict]:
+    tree = ast.parse(src)
+    ns: dict = {}
+    exec(compile(tree, "<fixture>", "exec"), ns)  # noqa: S102
+    return tree, ns
+
+
+def _mutant_of(tree: ast.Module, ns: dict, name: str, src_from: str, src_to: str):
+    node = copy.deepcopy(next(n for n in tree.body if isinstance(n, ast.FunctionDef) and n.name == name))
+    for sub in ast.walk(node):
+        for field, value in ast.iter_fields(sub):
+            if isinstance(value, ast.expr) and ast.unparse(value) == src_from:
+                setattr(sub, field, ast.parse(src_to, mode="eval").body)
+                break
+        else:
+            continue
+        break
+    else:
+        raise AssertionError(f"{src_from!r} not found")
+    return _compile_mutant(types.SimpleNamespace(mutated_node=node, wrapper_factory=None), ns[name])
+
+
+def _exec_suggestion(line: str, fn) -> None:
+    """Run a one-line suggestion as written, with `f` bound to ``fn`` (pytest available)."""
+    exec(compile(line, "<suggestion>", "exec"), {"f": fn, "pytest": pytest, "math": math})  # noqa: S102
+
+
+def _report_with(verdict: MutantVerdict) -> list[str]:
+    rep = SurvivorReport(verdicts=(verdict,), unclassified=(), inputs_expressible=True, boundary_probe="run")
+    return _format_survivor_report(rep, "f(spread_daughter_um, spread_parent_um)", ("a", "b"))
+
+
+def _suggestion_lines(lines: list[str]) -> list[str]:
+    return [
+        ln.strip()[2:].split("   (kills")[0] for ln in lines if ln.strip().startswith("→ ") and "(kills" in ln
+    ]
+
+
+# --- 2. the suggested assertion is satisfiable, and it is the test converge would write -----------
+
+
+def test_a_nan_original_is_suggested_by_a_satisfiable_pin_never_eq_nan():
+    tree, ns = _module(_SPREAD)
+    original = ns["spread_ratio"]
+    mutant = _mutant_of(tree, ns, "spread_ratio", "spread_parent_um <= 0", "False")
+    witness, _crash, _blocked = _search_witness(original, mutant, [(-1.0, -1)])
+    assert witness is not None and witness.original == "nan" and witness.mutant == "1.0"
+    verdict = MutantVerdict("BOUNDARY_x", "BOUNDARY", "", True, witness, 1)
+    (line,) = _suggestion_lines(_report_with(verdict))
+    assert "== nan" not in line.replace(" ", "")
+    _exec_suggestion(line, original)  # holds on the original…
+    with pytest.raises(AssertionError):
+        _exec_suggestion(line, mutant)  # …and fails on the mutant it names
+
