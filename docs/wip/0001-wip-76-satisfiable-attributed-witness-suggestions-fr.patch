+def test_a_distinction_made_by_shared_argument_state_is_not_a_witness():
+    """The search calls the original and then the mutant on ONE argument object; an original that
+    appends to it hands the mutant a different input. The written test passes fresh literals, so the
+    'distinction' is the harness's, not the code's."""
+
+    def original(items):
+        items.append(1)
+        return len(items)
+
+    def mutant(items):
