+# --- 4. an input already supplied — this run or recalled — is never re-proposed ---------------------
+
+
+def _proof(supplied: tuple[str, ...] = ()) -> types.SimpleNamespace:
+    return types.SimpleNamespace(
+        param_names=("a", "b"),
+        missing_lines=(),
+        missing_line_guards=(),
+        inputs_expressible=True,
+        supplied_inputs=supplied,
