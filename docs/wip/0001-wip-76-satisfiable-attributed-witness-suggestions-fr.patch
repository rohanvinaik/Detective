+
+
+def _cli(project: Path, *args: str) -> str:
+    """The terse output a user sees — the one that carries the next action (DO THIS / WRITE TEST)."""
+    script = Path(sys.executable).with_name("detective.exe" if sys.platform == "win32" else "detective")
+    assert script.is_file(), f"the installed console script is required beside {sys.executable}"
+    r = subprocess.run(
+        [str(script), *args, "--project-root", str(project)],
+        cwd=str(project),
+        capture_output=True,
+        text=True,
+        timeout=600,
+    )
+    out = r.stdout + r.stderr
+    assert r.returncode == 0, out
+    return out
+
+
+def _final(out: str) -> str:
+    return next(ln for ln in out.splitlines() if ln.startswith("FINAL"))
+
+
+def _report(project: Path, fn: str) -> str:
+    """The full report converge always writes — the survivor sections, verbose."""
+    return (project / ".detective" / "reports" / f"converge_{fn}.txt").read_text()
+
+
+def _section_ids(report: str, header: str) -> set[str]:
+    """Mutant ids listed under one survivor section of the report: its `→ mutant <ID>` rows, or the
+    `kills …` attribution rows of the SUGGESTED section."""
+    ids: set[str] = set()
+    inside = False
+    for ln in report.splitlines():
+        if header in ln:
+            inside = True
+            continue
+        if inside and not ln.startswith("    "):
+            break
+        if inside:
+            ids |= set(re.findall(r"\b[A-Z]+_[0-9a-f]{8}\b", ln))
+    return ids
+
+
+def _proposed_inputs(out: str) -> list[str]:
+    """The `--input` values a DO THIS line proposes, canonicalised the way Detective compares them."""
+    for ln in out.splitlines():
+        if ln.startswith("DO THIS:") and "--input" in ln:
+            return [_canonical_input(s) for s in re.findall(r"--input \"([^\"]*)\"", ln)]
+    return []
+
+
+@pytest.fixture(scope="module")
+def conservation(tmp_path_factory):
